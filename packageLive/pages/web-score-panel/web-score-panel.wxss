/* 页面整体背景与基础样式 - 对齐 miaoji_live 原生设计语言 */
.page-root {
  min-height: 100vh;
  background-color: #F8FAFC;
  color: #0F172A;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶栏栏目 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E2E8F0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.header-nav-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.back-icon {
  font-size: 36rpx;
  color: #334155;
  line-height: 1;
}

.logo-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 1rpx;
}

.italic-text {
  font-style: italic;
  color: #2563EB;
  margin: 0 2rpx;
}

.ws-status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #FEF2F2;
  border: 1rpx solid #FCA5A5;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #EF4444;
  font-weight: 600;
}

.ws-status-tag.connected {
  background: #F0FDF4;
  border-color: #86EFAC;
  color: #16A34A;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
}

/* 选项卡分段控制器 (Segmented Tabs) */
.tab-nav-bar {
  display: flex;
  background: #E2E8F0;
  margin: 20rpx 32rpx 8rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 18rpx 0;
  font-size: 28rpx;
  font-weight: 700;
  color: #64748B;
  border-radius: 16rpx;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-item.active {
  background: #FFFFFF;
  color: #0F172A;
  box-shadow: 0 4rpx 14rpx rgba(15, 23, 42, 0.08);
}

.tab-icon {
  font-size: 30rpx;
}

.tab-label {
  letter-spacing: 0.5rpx;
}

/* 卡片通用基础 */
.card {
  margin: 20rpx 32rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 1. 场次选择器卡片 */
.match-picker-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  border-radius: 30rpx;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  white-space: nowrap;
}

.picker-arrow {
  font-size: 20rpx;
}

.teams-preview-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  background: #F8FAFC;
  border: 1rpx solid #F1F5F9;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
}

.team-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.team-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0F172A;
}

.vs-badge {
  font-size: 24rpx;
  font-weight: 900;
  color: #94A3B8;
  font-style: italic;
}

/* 2. 比分控板网格 (黄金核心区域) */
.score-control-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 20rpx 32rpx;
}

.team-control-card {
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.team-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.team-header-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 170rpx;
}

.color-indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.6);
}

.color-edit-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(4px);
  white-space: nowrap;
}

.team-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-display {
  font-size: 96rpx;
  font-weight: 900;
  font-family: "Impact", -apple-system, sans-serif;
  margin: 10rpx 0;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  cursor: pointer;
  user-select: none;
}

.score-btns-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  width: 100%;
}

.team-control-card .score-btn {
  margin: 0;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 16rpx;
  backdrop-filter: blur(8px);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.15s ease;
}

.team-control-card .score-btn.btn-sub {
  background: rgba(0, 0, 0, 0.18);
  border-color: rgba(0, 0, 0, 0.25);
}

/* 3. 节次控制胶囊栏 */
.period-pills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.period-pill {
  text-align: center;
  padding: 18rpx 0;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 600;
}

.period-pill.active {
  background: #FEF3C7;
  border-color: #F59E0B;
  color: #D97706;
  font-weight: 800;
}

.period-pill.finished-pill.active {
  background: #F1F5F9;
  border-color: #64748B;
  color: #334155;
  font-weight: 800;
}

/* 4. 高光回放控制 */
.highlight-action-btns {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.save-highlight-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #8B5CF6 0%, #6D28D9 100%) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 16rpx !important;
  padding: 20rpx 0 !important;
  box-shadow: 0 4rpx 14rpx rgba(139, 92, 246, 0.3) !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.highlight-stop-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #EF4444 0%, #B91C1C 100%) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 16rpx !important;
  padding: 20rpx 0 !important;
}

.clips-container {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 16rpx;
  padding: 18rpx;
}

.clips-header {
  margin-bottom: 12rpx;
}

.clips-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #475569;
}

.clips-clear-btn {
  font-size: 22rpx;
  color: #94A3B8;
  padding: 4rpx 12rpx;
}

.clips-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.clip-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

.clip-info {
  display: flex;
  flex-direction: column;
}

.clip-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
}

.clip-time {
  font-size: 20rpx;
  color: #64748B;
}

.clip-play-btn {
  margin: 0 !important;
  padding: 8rpx 18rpx !important;
  font-size: 22rpx !important;
  font-weight: 700 !important;
  background: #2563EB !important;
  color: #FFFFFF !important;
  border-radius: 10rpx !important;
  line-height: 1.4 !important;
}

.clips-empty {
  font-size: 22rpx;
  color: #94A3B8;
  text-align: center;
  padding: 24rpx 12rpx;
}

/* 5. 防盗播欢迎文案 */
.marquee-preview-box {
  background: #0F172A;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.marquee-text-preview {
  font-size: 24rpx;
  color: #FCD34D;
  font-weight: 700;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  display: block;
}

.marquee-btn-start {
  width: 100% !important;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%) !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 16rpx !important;
  padding: 20rpx 0 !important;
  box-shadow: 0 4rpx 14rpx rgba(245, 158, 11, 0.3) !important;
}

.marquee-btn-stop {
  width: 100% !important;
  background: #475569 !important;
  color: #FFFFFF !important;
  font-size: 28rpx !important;
  font-weight: 800 !important;
  border-radius: 16rpx !important;
  padding: 20rpx 0 !important;
}

/* 6. OBS 链接与房间设置 */
.room-id-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.room-id-info {
  display: flex;
  align-items: center;
  cursor: pointer;
}

.room-id-row .label {
  color: #64748B;
}

.room-id-code {
  font-weight: 800;
  color: #D97706;
  font-family: monospace;
  font-size: 30rpx;
}

.copy-hint {
  font-size: 20rpx;
  color: #2563EB;
  margin-left: 8rpx;
  font-weight: 600;
}

.url-box {
  background: #F1F5F9;
  border: 1rpx solid #E2E8F0;
  padding: 20rpx;
  border-radius: 12rpx;
  word-break: break-all;
  margin-bottom: 20rpx;
}

.url-text {
  font-size: 22rpx;
  color: #0284C7;
  font-family: monospace;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 0;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.25);
}

.main-copy {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%) !important;
  font-size: 26rpx !important;
  padding: 20rpx 0 !important;
}

.obs-copy-btns-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
}

.sub-copy-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.sub-copy-btn {
  flex: 1;
  background: #F1F5F9;
  color: #334155;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 600;
  padding: 14rpx 6rpx;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.fixed-tag {
  font-size: 20rpx;
  color: #10B981;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 700;
}

.obs-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.4;
}

/* 7. 时间切图联动 */
.time-input-row {
  width: 100%;
}

.time-room-input {
  width: 100%;
  height: 84rpx;
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0F172A;
  box-sizing: border-box;
  font-family: 'DIN Alternate', monospace, sans-serif;
  letter-spacing: 1rpx;
}

.time-room-input.input--disabled {
  background: #F1F5F9;
  color: #64748B;
  border-color: #E2E8F0;
}

.time-connect-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%) !important;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.3) !important;
}

.time-disconnect-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%) !important;
  box-shadow: 0 4rpx 14rpx rgba(239, 68, 68, 0.3) !important;
}

/* 8. 直播版权署名 */
.broadcaster-preview-box {
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
}

.preview-label {
  color: #64748B;
  margin-right: 8rpx;
}

.preview-fixed {
  color: #334155;
  font-weight: 600;
}

.preview-nick {
  color: #2563EB;
  font-weight: 800;
}

.nick-badge {
  background: #EFF6FF;
  color: #2563EB;
  border: 1rpx solid #BFDBFE;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}

.sync-nick-btn {
  width: 100% !important;
  background: #F1F5F9 !important;
  border: 1rpx solid #CBD5E1 !important;
  color: #1E293B !important;
  font-size: 26rpx !important;
  font-weight: 700 !important;
  border-radius: 14rpx !important;
  padding: 18rpx 0 !important;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.btn-hover {
  opacity: 0.75;
}

/* ─────────────────────────────────────
   🎨 颜色选择器浮层样式
───────────────────────────────────── */
.color-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.65);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.color-picker-panel {
  width: 86%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
}

.close-icon {
  font-size: 40rpx;
  color: #94A3B8;
  line-height: 1;
  padding: 8rpx;
}

.picker-presets-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
  margin-bottom: 12rpx;
}

.picker-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.picker-preset-dot-wrap {
  padding: 4rpx;
}

.picker-preset-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #F1F5F9;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.picker-preset-dot.active {
  border-color: #3B82F6;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.3);
  transform: scale(1.1);
}

.color-grid-scroll {
  height: 340rpx;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
  padding: 4rpx;
}

.grid-color-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E2E8F0;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.grid-color-dot.active {
  transform: scale(1.15);
  border: 4rpx solid #3B82F6;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.35);
}

.picker-footer {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.current-selection {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.current-selection text {
  font-size: 22rpx;
  color: #64748B;
}

.selected-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 1rpx solid #CBD5E1;
}

.color-hex {
  font-family: monospace;
  font-weight: 800;
  font-size: 24rpx;
  color: #0F172A;
}

.confirm-btn {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.3);
}

.confirm-btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}
