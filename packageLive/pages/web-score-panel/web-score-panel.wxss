/* 页面整体背景与基础样式 - 对齐 miaoji_live 原生设计语言 */
.page-root {
  min-height: 100vh;
  background-color: #F8FAFC;
  color: #0F172A;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "PingFang SC", sans-serif;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

/* 顶栏栏目 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E2E8F0;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.03);
}

.header-nav-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F1F5F9;
}

.back-icon {
  font-size: 36rpx;
  color: #334155;
  line-height: 1;
}

.logo-text {
  font-size: 32rpx;
  font-weight: 800;
  color: #0F172A;
  letter-spacing: 1rpx;
}

.italic-text {
  font-style: italic;
  color: #2563EB;
  margin: 0 2rpx;
}

.ws-status-tag {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx;
  background: #FEF2F2;
  border: 1rpx solid #FCA5A5;
  border-radius: 30rpx;
  font-size: 22rpx;
  color: #EF4444;
  font-weight: 600;
}

.ws-status-tag.connected {
  background: #F0FDF4;
  border-color: #86EFAC;
  color: #16A34A;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: currentColor;
}

/* 卡片通用基础 */
.card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E2E8F0;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.card-icon {
  font-size: 32rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1E293B;
}

/* 1. 场次直接选择器卡片 */
.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.match-picker-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 20rpx;
  background: #EFF6FF;
  border: 1rpx solid #BFDBFE;
  border-radius: 30rpx;
  color: #2563EB;
  font-size: 24rpx;
  font-weight: 700;
}

.picker-arrow {
  font-size: 20rpx;
}

.match-preview-box {
  background: #F8FAFC;
  border: 1rpx solid #F1F5F9;
  padding: 24rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.match-title-tag {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748B;
  background: #E2E8F0;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.teams-preview-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.team-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.color-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
}

.team-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0F172A;
}

.vs-badge {
  font-size: 24rpx;
  font-weight: 900;
  color: #94A3B8;
  font-style: italic;
}

/* 2. OBS 链接卡片 */
.room-id-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.room-id-row .label {
  color: #64748B;
}

.room-id-code {
  font-weight: 800;
  color: #D97706;
  font-family: monospace;
  font-size: 30rpx;
}

.url-box {
  background: #F1F5F9;
  border: 1rpx solid #E2E8F0;
  padding: 20rpx;
  border-radius: 12rpx;
  word-break: break-all;
  margin-bottom: 24rpx;
}

.url-text {
  font-size: 22rpx;
  color: #0284C7;
  font-family: monospace;
}

.btn-primary {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 22rpx 0;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.25);
}

.obs-copy-btns-group {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  width: 100%;
}

.sub-copy-row {
  display: flex;
  gap: 12rpx;
  width: 100%;
}

.sub-copy-btn {
  flex: 1;
  background: #F1F5F9;
  color: #334155;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  font-size: 21rpx;
  font-weight: 600;
  padding: 14rpx 6rpx;
  line-height: 1.3;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.obs-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #94A3B8;
  line-height: 1.4;
}

/* 1.5. 【开始记分卡片】样式 */
.start-action-card {
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.start-score-btn {
  width: 100%;
  background: linear-gradient(135deg, #F59E0B 0%, #D97706 100%);
  color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx 0;
  box-shadow: 0 6rpx 20rpx rgba(217, 119, 6, 0.3);
  transition: all 0.3s ease;
}

.start-score-btn.active {
  background: linear-gradient(135deg, #10B981 0%, #059669 100%);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.3);
}

.start-btn-icon {
  font-size: 32rpx;
}

.start-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #64748B;
  text-align: center;
  line-height: 1.4;
}

.fixed-tag {
  font-size: 20rpx;
  color: #10B981;
  background: #ECFDF5;
  border: 1rpx solid #A7F3D0;
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  font-weight: 700;
}

/* 3. 比分控板网格 */
.score-control-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin: 24rpx 32rpx;
}

.team-control-card {
  border-radius: 28rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid rgba(255, 255, 255, 0.25);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  position: relative;
  overflow: hidden;
}

.team-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.team-header-info {
  display: flex;
  align-items: center;
  gap: 10rpx;
  max-width: 170rpx;
}

.color-indicator-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(255, 255, 255, 0.6);
}

.color-edit-tag {
  font-size: 20rpx;
  font-weight: 700;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(4px);
  white-space: nowrap;
}

.team-title {
  font-size: 30rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.score-display {
  font-size: 96rpx;
  font-weight: 900;
  font-family: "Impact", -apple-system, sans-serif;
  margin: 12rpx 0;
  text-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
  cursor: pointer;
  user-select: none;
}

.score-btns-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  width: 100%;
}

.team-control-card .score-btn {
  margin: 0;
  padding: 16rpx 0;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 32rpx;
  font-weight: 800;
  border-radius: 16rpx;
  backdrop-filter: blur(8px);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
  transition: all 0.15s ease;
}

.team-control-card .score-btn.btn-sub {
  background: rgba(0, 0, 0, 0.18);
  border-color: rgba(0, 0, 0, 0.25);
}

/* 4. 节次与按键区 */
.period-pills-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
}

.period-pill {
  text-align: center;
  padding: 18rpx 0;
  background: #F8FAFC;
  border: 1rpx solid #E2E8F0;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #64748B;
  font-weight: 600;
}

.period-pill.active {
  background: #FEF3C7;
  border-color: #F59E0B;
  color: #D97706;
  font-weight: 800;
}

.period-pill.finished-pill.active {
  background: #F1F5F9;
  border-color: #64748B;
  color: #334155;
  font-weight: 800;
}

.btn-hover {
  opacity: 0.75;
}

/* 5. 真机调试面板样式 */
.debug-actions {
  display: flex;
  gap: 12rpx;
}

.mini-btn {
  margin: 0;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background: #2563EB;
  color: #FFFFFF;
  line-height: 1.4;
}

.mini-btn.btn-outline {
  background: #F1F5F9;
  color: #64748B;
  border: 1rpx solid #CBD5E1;
}

.debug-logs-box {
  height: 240rpx;
  background: #0F172A;
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-family: monospace;
}

.log-line {
  font-size: 20rpx;
  line-height: 1.5;
  display: flex;
  gap: 12rpx;
}

.log-time {
  color: #64748B;
}

.log-msg {
  color: #38BDF8;
  word-break: break-all;
}

.log-msg.error {
  color: #F87171;
}

.log-msg.success {
  color: #4ADE80;
}

.log-empty {
  color: #475569;
  font-size: 22rpx;
  text-align: center;
  margin-top: 80rpx;
}

/* 时间采集设备联动卡片专属样式 */
.time-input-row {
  width: 100%;
}

.time-room-input {
  width: 100%;
  height: 84rpx;
  background: #F8FAFC;
  border: 2rpx solid #CBD5E1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #0F172A;
  box-sizing: border-box;
  font-family: 'DIN Alternate', monospace, sans-serif;
  letter-spacing: 1rpx;
}

.time-room-input.input--disabled {
  background: #F1F5F9;
  color: #64748B;
  border-color: #E2E8F0;
}

.time-connect-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #10B981 0%, #059669 100%) !important;
  box-shadow: 0 4rpx 14rpx rgba(16, 185, 129, 0.3) !important;
}

.time-disconnect-btn {
  width: 100% !important;
  background: linear-gradient(135deg, #EF4444 0%, #DC2626 100%) !important;
  box-shadow: 0 4rpx 14rpx rgba(239, 68, 68, 0.3) !important;
}

/* ─────────────────────────────────────
   🎨 颜色选择器浮层样式
───────────────────────────────────── */
.color-picker-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(15, 23, 42, 0.65);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

.color-picker-panel {
  width: 86%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.35);
  box-sizing: border-box;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.picker-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
}

.close-icon {
  font-size: 44rpx;
  color: #94A3B8;
  padding: 6rpx 12rpx;
  line-height: 1;
  cursor: pointer;
}

.picker-presets-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #64748B;
  margin-bottom: 12rpx;
}

.picker-presets {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.picker-preset-dot-wrap {
  padding: 4rpx;
}

.picker-preset-dot {
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  border: 3rpx solid #F1F5F9;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.picker-preset-dot.active {
  border-color: #3B82F6;
  box-shadow: 0 0 0 6rpx rgba(59, 130, 246, 0.3);
  transform: scale(1.1);
}

.color-grid-scroll {
  height: 340rpx;
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.color-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14rpx;
  padding: 4rpx;
}

.grid-color-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #E2E8F0;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.grid-color-dot.active {
  transform: scale(1.15);
  border: 4rpx solid #3B82F6;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.35);
}

.picker-footer {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.current-selection {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.current-selection text {
  font-size: 22rpx;
  color: #64748B;
}

.selected-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 1rpx solid #CBD5E1;
}

.color-hex {
  font-family: monospace;
  font-weight: 800;
  font-size: 24rpx;
  color: #0F172A;
}

.confirm-btn {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 800;
  padding: 14rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.3);
}

.confirm-btn-hover {
  opacity: 0.9;
  transform: scale(0.98);
}

