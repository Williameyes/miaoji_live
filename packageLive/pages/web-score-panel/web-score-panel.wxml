<view class="page-root" style="padding-top: {{statusBarHeight}}px;">
  <!-- 顶栏导航 -->
  <view class="header">
    <view class="header-nav-row">
      <view class="back-btn" bindtap="onGoBack" hover-class="back-btn-hover">
        <text class="back-icon">‹</text>
      </view>
      <view class="logo-text">
        网页<text class="italic-text">记</text>分中控台
      </view>
    </view>
    <view class="ws-status-tag {{wsConnected ? 'connected' : ''}}" bindtap="onTapWsStatus">
      <view class="status-dot"></view>
      <text>{{wsStatusText}}</text>
    </view>
  </view>

  <!-- 1. 场次直接切换选择器 -->
  <view class="card match-selector-card">
    <view class="card-header flex-between">
      <view class="header-left">
        <text class="card-icon">🏀</text>
        <text class="card-title">当前记分场次</text>
      </view>
      <picker 
        bindchange="onMatchPickerChange" 
        value="{{selectedMatchIndex}}" 
        range="{{matchList}}" 
        range-key="displayTitle"
      >
        <view class="match-picker-btn" hover-class="btn-hover">
          <text class="picker-label">切换场次</text>
          <text class="picker-arrow">▾</text>
        </view>
      </picker>
    </view>

    <!-- 当前场次对阵卡片预览 -->
    <view class="match-preview-box">
      <text class="match-title-tag">{{matchTitle || '常规赛'}}</text>
      <view class="teams-preview-row">
        <view class="team-item left">
          <view class="color-dot" style="background-color: {{teamA.color || '#FF2D55'}}"></view>
          <text class="team-name">{{teamA.name || '主队'}}</text>
        </view>
        <text class="vs-badge">VS</text>
        <view class="team-item right">
          <text class="team-name">{{teamB.name || '客队'}}</text>
          <view class="color-dot" style="background-color: {{teamB.color || '#007AFF'}}"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- 2. 【核心】开始记分控制与同步开关 -->
  <view class="card start-action-card">
    <button 
      class="start-score-btn {{isScoringStarted ? 'active' : ''}}" 
      bindtap="onToggleStartScore"
      hover-class="btn-hover"
    >
      <text class="start-btn-icon">{{isScoringStarted ? '🟢' : '▶'}}</text>
      <text class="start-btn-text">{{isScoringStarted ? '记分同步中 (点击重发数据包)' : '开始记分并同步至网页'}}</text>
    </button>
    <text class="start-tip">
      {{isScoringStarted ? '✅ 已连通网页记分牌，点击加分将实时联动直播画面' : '💡 点击【开始记分】将队伍名称、颜色与当前比分瞬间推送到 OBS 记分牌'}}
    </text>
  </view>

  <!-- 3. OBS 专属主播固定房间链接卡片 -->
  <view class="card obs-link-card">
    <view class="card-header flex-between">
      <view class="header-left">
        <text class="card-icon">🌐</text>
        <text class="card-title">主播固定 OBS 网页素材链接</text>
      </view>
      <text class="fixed-tag">固定不换链接</text>
    </view>
    <view class="room-id-row">
      <text class="label">主播专属房间号：</text>
      <text class="room-id-code">{{roomId || '666888'}}</text>
    </view>
    <view class="url-box">
      <text class="url-text">{{obsUrl}}</text>
    </view>
    <view class="obs-copy-btns-group">
      <button class="btn-primary copy-btn" bindtap="onCopyObsUrl" hover-class="btn-hover">
        <text class="btn-icon">📋</text>
        <text>一键复制 1080P 标准全屏记分牌链接</text>
      </button>
      <view class="sub-copy-row">
        <button class="sub-copy-btn" bindtap="onCopyScoreDockedUrl" hover-class="btn-hover">
          <text>🔗 记分牌左侧一体角标链接</text>
        </button>
        <button class="sub-copy-btn" bindtap="onCopyLiveOnlyUrl" hover-class="btn-hover">
          <text>📺 独立 LIVE 角标小图层链接</text>
        </button>
      </view>
    </view>
    <text class="obs-tip">✨ 零切链接特性：OBS 只需挂载此固定链接，在小程序中直接【切换场次】，网页记分牌会自动平滑换场，无需修改 OBS 任何设置！</text>
  </view>

  <!-- 3.1 赛场时间切图设备联动卡片 (输入采集端房间号控制) -->
  <view class="card time-sync-card">
    <view class="card-header flex-between">
      <view class="header-left">
        <text class="card-icon">⏱️</text>
        <text class="card-title">赛场时间设备联动 (大表切图)</text>
      </view>
      <view class="ws-status-tag {{isTimeDeviceConnected ? 'connected' : ''}}" style="padding: 4rpx 14rpx; font-size: 20rpx;">
        <view class="status-dot"></view>
        <text>{{isTimeDeviceConnected ? '已连通 (' + connectedTimeRoomId + ')' : '未连接'}}</text>
      </view>
    </view>

    <!-- 采集端房间号输入区 -->
    <view class="time-input-row">
      <input 
        class="time-room-input {{isTimeDeviceConnected ? 'input--disabled' : ''}}" 
        type="number" 
        maxlength="6" 
        placeholder="输入采集手机的 6 位房间码 (如 123456)" 
        value="{{timeDeviceRoomId}}"
        disabled="{{isTimeDeviceConnected}}"
        bindinput="onTimeDeviceRoomInput"
      />
    </view>

    <!-- 操作按钮组 -->
    <view class="time-action-btns-row" style="margin-top: 16rpx;">
      <button 
        wx:if="{{!isTimeDeviceConnected}}"
        class="btn-primary time-connect-btn" 
        bindtap="onConnectTimeDevice" 
        hover-class="btn-hover"
      >
        <text class="btn-icon">🔗</text>
        <text>连接时间设备并下发给网页端</text>
      </button>

      <button 
        wx:else
        class="btn-primary time-disconnect-btn" 
        bindtap="onDisconnectTimeDevice" 
        hover-class="btn-hover"
      >
        <text class="btn-icon">🔌</text>
        <text>断开时间设备 (通知网页端撤下)</text>
      </button>
    </view>

    <text class="obs-tip">💡 联动说明：在拍摄大表的手机上开启【时间切图采集】，在此输入该手机显示的 6 位码并点击【连接】，网页记分牌就会自动连接该房间并展示时间切图！点击【断开】可随时撤下时间容器。</text>
  </view>

  <!-- 3.2 赛场高光回放控制卡片 (下发指令控制网页端高光回放) -->
  <view class="card highlight-replay-card">
    <view class="card-header flex-between">
      <view class="header-left">
        <text class="card-icon">🎬</text>
        <text class="card-title">赛场高光回放控制</text>
      </view>
      <view class="ws-status-tag {{isHighlightReplaying ? 'connected' : ''}}" style="padding: 4rpx 14rpx; font-size: 20rpx;">
        <view class="status-dot"></view>
        <text>{{isHighlightReplaying ? '高光回放中' : '实时直播中'}}</text>
      </view>
    </view>

    <!-- 操作按钮组 -->
    <view class="time-action-btns-row" style="margin-top: 16rpx; flex-direction: column; gap: 12rpx;">
      <!-- 1. 触发 OBS 保存高光切片 -->
      <button 
        class="sub-copy-btn" 
        style="width: 100%; border: 1rpx solid rgba(0, 240, 255, 0.4); background: rgba(0, 240, 255, 0.08); color: #00f0ff; height: 76rpx; line-height: 76rpx; font-weight: bold; border-radius: 12rpx;"
        bindtap="onTriggerSaveHighlight" 
        hover-class="btn-hover"
      >
        <text class="btn-icon">💾</text>
        <text> 触发 OBS 保存精彩高光片段 (远程保存)</text>
      </button>

      <!-- 2. 回放进行中：一键主动中断并返回直播 -->
      <button 
        wx:if="{{isHighlightReplaying}}"
        class="btn-primary highlight-stop-btn" 
        style="width: 100%; margin-top: 0; background: linear-gradient(135deg, #ef4444, #dc2626);"
        bindtap="onStopHighlightReplay" 
        hover-class="btn-hover"
      >
        <text class="btn-icon">📺</text>
        <text>立即中断回放，切回直播画面 (红色 Wipe)</text>
      </button>

      <!-- 3. 历史高光切片点播列表 (点击任意一段精准点播) -->
      <view style="margin-top: 8rpx; background: rgba(0,0,0,0.25); border-radius: 12rpx; padding: 14rpx;">
        <view style="font-size: 22rpx; color: #8fa3b0; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center;">
          <text style="font-weight: bold; color: #cbd5e1;">🎬 本场高光列表 (点击直接点播)：</text>
          <view style="display: flex; align-items: center; gap: 16rpx;">
            <text style="color: #00f0ff; font-weight: bold;">共 {{savedHighlightClips ? savedHighlightClips.length : 0}} 段</text>
            <text wx:if="{{savedHighlightClips && savedHighlightClips.length > 0}}" style="color: #f87171; font-size: 22rpx; text-decoration: underline; padding: 4rpx 8rpx;" bindtap="onClearHighlightClips">清空</text>
          </view>
        </view>
        
        <view wx:if="{{savedHighlightClips.length > 0}}" class="clips-list">
          <view 
            wx:for="{{savedHighlightClips}}" 
            wx:key="id" 
            class="clip-card"
            style="display: flex; align-items: center; justify-content: space-between; padding: 16rpx 20rpx; background: rgba(255,255,255,0.06); border-radius: 12rpx; margin-bottom: 12rpx; border: 1rpx solid rgba(255,255,255,0.08);"
          >
            <view style="display: flex; flex-direction: column;">
              <view style="display: flex; align-items: center; gap: 12rpx;">
                <text style="font-size: 26rpx; font-weight: bold; color: #00f0ff;">🎬 第 {{index + 1}} 段高光</text>
                <text style="font-size: 20rpx; color: #94a3b8;">{{item.time}}</text>
              </view>
            </view>
            <button 
              size="mini" 
              style="margin: 0; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; font-size: 24rpx; background: #00f0ff; color: #000; font-weight: bold; border-radius: 10rpx;"
              bindtap="onPlaySpecificClip" 
              data-index="{{index}}"
            >
              ▶ 播放第 {{index + 1}} 段
            </button>
          </view>
        </view>

        <view wx:else style="padding: 24rpx; text-align: center; color: #64748b; font-size: 22rpx;">
          暂无已捕获切片，点击上方【💾 触发 OBS 保存】即可捕获一段高光
        </view>
      </view>
    </view>

    <text class="obs-tip">💡 高光回放说明：点击任意一段高光的【▶ 播放此段】，网页将触发广播级转场并播放该视频！播放中可随时点击【立即中断回放】提前切回现场直播。</text>
  </view>

  <!-- 4. 主客队比分控板 (背景为球衣颜色，得分自动选择高对比度文本色，长按或点击色标可修改球衣颜色) -->
  <view class="score-control-section">
    <!-- 主队控板 -->
    <view 
      class="team-control-card home-card"
      style="background: {{teamA.color || '#FF2D55'}}; color: {{teamA.textColor || '#FFFFFF'}}; box-shadow: 0 8rpx 24rpx {{teamA.color || '#FF2D55'}}40;"
      bindlongpress="onOpenColorPicker"
      data-target="teamA"
    >
      <view class="team-card-header">
        <view class="team-header-info">
          <view class="color-indicator-dot" style="background: {{teamA.textColor || '#FFFFFF'}};"></view>
          <text class="team-title" style="color: {{teamA.textColor || '#FFFFFF'}};">{{teamA.name || '主队'}}</text>
        </view>
        <view 
          class="color-edit-tag" 
          bindtap="onOpenColorPicker" 
          data-target="teamA"
          style="background: rgba(255,255,255,0.22); color: {{teamA.textColor || '#FFFFFF'}};"
        >
          🎨 改球衣
        </view>
      </view>

      <view 
        class="score-display" 
        style="color: {{teamA.textColor || '#FFFFFF'}};"
        bindlongpress="onOpenColorPicker"
        data-target="teamA"
      >
        {{teamA.score}}
      </view>

      <view class="score-btns-grid">
        <button class="score-btn" style="color: {{teamA.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamA" data-delta="1" hover-class="btn-hover">+1</button>
        <button class="score-btn" style="color: {{teamA.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamA" data-delta="2" hover-class="btn-hover">+2</button>
        <button class="score-btn" style="color: {{teamA.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamA" data-delta="3" hover-class="btn-hover">+3</button>
        <button class="score-btn btn-sub" style="color: {{teamA.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamA" data-delta="-1" hover-class="btn-hover">-1</button>
      </view>
    </view>

    <!-- 客队控板 -->
    <view 
      class="team-control-card away-card"
      style="background: {{teamB.color || '#007AFF'}}; color: {{teamB.textColor || '#FFFFFF'}}; box-shadow: 0 8rpx 24rpx {{teamB.color || '#007AFF'}}40;"
      bindlongpress="onOpenColorPicker"
      data-target="teamB"
    >
      <view class="team-card-header">
        <view class="team-header-info">
          <view class="color-indicator-dot" style="background: {{teamB.textColor || '#FFFFFF'}};"></view>
          <text class="team-title" style="color: {{teamB.textColor || '#FFFFFF'}};">{{teamB.name || '客队'}}</text>
        </view>
        <view 
          class="color-edit-tag" 
          bindtap="onOpenColorPicker" 
          data-target="teamB"
          style="background: rgba(255,255,255,0.22); color: {{teamB.textColor || '#FFFFFF'}};"
        >
          🎨 改球衣
        </view>
      </view>

      <view 
        class="score-display" 
        style="color: {{teamB.textColor || '#FFFFFF'}};"
        bindlongpress="onOpenColorPicker"
        data-target="teamB"
      >
        {{teamB.score}}
      </view>

      <view class="score-btns-grid">
        <button class="score-btn" style="color: {{teamB.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamB" data-delta="1" hover-class="btn-hover">+1</button>
        <button class="score-btn" style="color: {{teamB.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamB" data-delta="2" hover-class="btn-hover">+2</button>
        <button class="score-btn" style="color: {{teamB.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamB" data-delta="3" hover-class="btn-hover">+3</button>
        <button class="score-btn btn-sub" style="color: {{teamB.textColor || '#FFFFFF'}};" bindtap="onScoreChange" data-target="teamB" data-delta="-1" hover-class="btn-hover">-1</button>
      </view>
    </view>
  </view>

  <!-- 5. 节次控制面板 -->
  <view class="card auxiliary-card">
    <view class="card-header">
      <text class="card-icon">⏱️</text>
      <text class="card-title">节次控制</text>
    </view>

    <view class="period-pills-grid">
      <view 
        class="period-pill {{period === item.val ? 'active' : ''}} {{item.val === 6 ? 'finished-pill' : ''}}" 
        wx:for="{{periodList}}" 
        wx:key="val" 
        bindtap="onSelectPeriod" 
        data-val="{{item.val}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <!-- 6. 🛠️ 真机调试日志中控台 -->
  <view class="card debug-card">
    <view class="card-header flex-between">
      <view class="header-left">
        <text class="card-icon">🛠️</text>
        <text class="card-title">真机实时调试日志</text>
      </view>
      <view class="debug-actions">
        <button class="mini-btn" bindtap="onForceSync" hover-class="btn-hover">强制推送广播</button>
        <button class="mini-btn btn-outline" bindtap="onClearLogs" hover-class="btn-hover">清空日志</button>
      </view>
    </view>
    
    <scroll-view scroll-y class="debug-logs-box">
      <view class="log-line" wx:for="{{debugLogs}}" wx:key="index">
        <text class="log-time">[{{item.time}}]</text>
        <text class="log-msg {{item.type}}">{{item.msg}}</text>
      </view>
      <view class="log-empty" wx:if="{{debugLogs.length === 0}}">暂无调试日志，尝试操作加分看日志输出...</view>
    </scroll-view>
  </view>

  <!-- ===== 🎨 球衣颜色选择器浮层 ===== -->
  <view class="color-picker-overlay" wx:if="{{showColorPicker}}" bindtap="onCloseColorPicker">
    <view class="color-picker-panel" catchtap="stopBubbling">

      <view class="picker-header">
        <text class="picker-title">{{colorPickerTitle}}</text>
        <view class="close-icon" bindtap="onCloseColorPicker">×</view>
      </view>

      <view class="picker-presets-label">常用预设色</view>
      <view class="picker-presets">
        <view
          class="picker-preset-dot-wrap"
          wx:for="{{colorPresets}}"
          wx:key="*this"
          bindtap="onModalPresetColorTap"
          data-color="{{item}}"
        >
          <view
            class="picker-preset-dot {{tempSelectedColor === item ? 'active' : ''}}"
            style="background-color: {{item}}"
          ></view>
        </view>
      </view>

      <view class="picker-presets-label" style="margin-top: 12rpx;">全部色板</view>
      <scroll-view scroll-y class="color-grid-scroll">
        <view class="color-grid">
          <view
            wx:for="{{extendedColors}}"
            wx:key="*this"
            class="grid-color-dot {{tempSelectedColor === item ? 'active' : ''}}"
            style="background-color: {{item}}"
            bindtap="onColorGridSelect"
            data-color="{{item}}"
          ></view>
        </view>
      </scroll-view>

      <view class="picker-footer">
        <view class="current-selection">
          <text>当前选择:</text>
          <view class="selected-dot" style="background-color: {{tempSelectedColor}}"></view>
          <text class="color-hex">{{tempSelectedColor}}</text>
        </view>
        <view class="confirm-btn" hover-class="confirm-btn-hover" bindtap="onConfirmColorSelection">确定并同步网页</view>
      </view>

    </view>
  </view>
</view>
