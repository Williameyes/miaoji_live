<view class="page-root" style="padding-top: {{statusBarHeight}}px;">

  <!-- ===== 头部 ===== -->
  <view class="header">
    <view class="logo-text">
      赛事<text class="italic-text">资</text>讯
    </view>
    <text class="header-sub">TOURNAMENT CENTER</text>
  </view>

  <!-- ===== 分类 Filter Tabs ===== -->
  <view class="tn-filter-bar">
    <view class="tn-filter-item {{filterTab === 'all' ? 'active' : ''}}" data-tab="all" bindtap="onFilterTabChange">全部赛事</view>
    <view class="tn-filter-item {{filterTab === 'active' ? 'active' : ''}}" data-tab="active" bindtap="onFilterTabChange">进行中</view>
    <view class="tn-filter-item {{filterTab === 'ended' ? 'active' : ''}}" data-tab="ended" bindtap="onFilterTabChange">已完赛</view>
  </view>

  <!-- ===== 列表内容区 ===== -->
  <view class="section">
    <view class="section-header">
      <text class="section-label">赛事大厅</text>
      <text class="match-count-badge" wx:if="{{tournamentList.length > 0}}">{{tournamentList.length}} 赛事</text>
    </view>

    <!-- 加载态 -->
    <view class="tn-loading" wx:if="{{loading}}">
      <view class="tn-spinner"></view>
      <text>正在加载赛事列表…</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{!tournamentList.length}}">
      <text class="empty-icon">🏆</text>
      <text class="empty-text">暂无公开展览的赛事</text>
      <text class="empty-hint">在「我的 -> 比赛管理」中创建公开展览赛事</text>
    </view>

    <!-- 双列网格卡片布局 (保持小红书/抖音卡片体验，配色与风格完全匹配记分页) -->
    <view class="tn-grid-2col" wx:else>
      <block wx:for="{{tournamentList}}" wx:key="id">
        <view 
          class="tn-grid-card {{item.isPinned ? 'is-pinned' : ''}}" 
          hover-class="tn-card-hover"
          wx:if="{{filterTab === 'all' || (filterTab === 'active' && !item.isEnded) || (filterTab === 'ended' && item.isEnded)}}"
          data-id="{{item.id}}" 
          bindtap="onTournamentTap"
          style="animation-delay: {{index * 55}}ms"
        >
          <!-- 置顶赛事边框角标标识 (视觉焦点引导) -->
          <view class="tn-pinned-corner-mark" wx:if="{{item.isPinned}}">
            <text class="tn-pinned-corner-icon">📌</text>
            <text class="tn-pinned-corner-text">置顶</text>
          </view>

          <view class="tn-card-banner {{item.themeClass || ('tn-banner--' + item.sportType)}}">
            <!-- 封面图（若存在） -->
            <image wx:if="{{item.coverUrl}}" class="tn-banner-cover" mode="aspectFill" src="{{item.coverUrl}}"></image>
            
            <!-- 无封面图时展示：运动巨型 3D 水印浮雕与几何纹理 -->
            <block wx:else>
              <view class="tn-banner-mesh"></view>
              <view class="tn-banner-glow"></view>
              <view class="tn-banner-watermark">{{item.sportIcon}}</view>
            </block>

            <!-- 状态胶囊 -->
            <view class="tn-badge {{item.statusClass}}">
              <text class="tn-status-dot" wx:if="{{item.statusClass === 'status-active'}}"></text>
              <text class="tn-status-text">{{item.statusText}}</text>
            </view>
          </view>

          <view class="tn-card-content">
            <text class="tn-card-title">{{item.name}}</text>

            <view class="tn-tags-row">
              <view class="tn-sport-pill">
                <text class="tn-sport-icon">{{item.sportIcon}}</text>
                <text class="tn-sport-label">{{item.sportLabel}}</text>
              </view>
              <view class="tn-format-tag">{{item.formatLabel}}</view>
            </view>

            <view class="tn-card-meta">
              <text class="tn-meta-date">📅 {{item.dateRange}}</text>
              <text class="tn-meta-count">{{item.sportIcon}} {{item.scheduledCount}} 场比赛</text>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

</view>
