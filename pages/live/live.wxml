<page-meta background-color="#000000" background-color-top="#000000" background-color-bottom="#000000" page-style="background: #000000;"></page-meta>
<wxs module="c" src="./live.wxs"></wxs>
<view class="container landscape {{isRecording ? 'container--rec-performance' : ''}}">
  <!-- Level 0: 16:9 内接取景框（与 computeLiveStage16x9 一致），避免全屏与相机典型 16:9 输出比例差导致的非等比拉伸感 -->
  <view
    wx:if="{{liveStreamAllowed && (cameraMounted || enhanceCanvasVisible)}}"
    class="live-stage"
    id="liveStage"
    style="{{liveStageInlineStyle}}">
    <!-- 全屏相机：承担 startRecord 与 onCameraFrame 吐帧 -->
    <camera
      wx:if="{{cameraMounted && liveStreamAllowed}}"
      device-position="back"
      flash="off"
      frame-size="{{enhanceCanvasVisible ? 'large' : 'max'}}"
      resolution="high"
      class="camera-bg {{enhanceCanvasVisible ? 'camera-bg--under-enhance' : ''}}"
      mode="normal"
      zoom="{{zoom}}"
      bindstop="onCameraStop"
      binderror="onCameraError"
      bindinitdone="onCameraInit">
    </camera>

    <!-- WebGL 锐化：standard/strong 盖在 camera 上；VK 时 camera 可已卸载仅 canvas 出图 -->
    <canvas
      wx:if="{{liveStreamAllowed && enhanceCanvasVisible}}"
      type="webgl"
      id="enhanceCanvas"
      class="enhance-canvas"></canvas>
  </view>

  <!-- 硬恢复间隙：静态低透明度遮罩（无文字、无 Toast、不盖 live 预览逻辑上的循环 video） -->
  <view wx:if="{{showRecoveryVeil}}" class="recovery-veil" catchtouchmove="noopCatchMove">
    <image class="recovery-veil-art" src="{{recoveryVeilSrc}}" mode="aspectFill" />
  </view>

  <!-- Level 0.5: 透明手势层 (专门处理双指缩放) -->
  <view class="gesture-layer {{vkDebugPanelVisible && enhanceMode === 'vk' ? 'gesture-layer--disabled' : ''}}"
    bindtouchstart="onTouchStart" 
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindlongpress="onBackgroundLongPress">
  </view>

  <!-- 共用 AF/AE 控件（z 介于 gesture 与记分层之间；中央区域 pointer-events 透传至手势层） -->
  <view
    class="focus-ui-layer"
    wx:if="{{cameraMounted && liveStreamAllowed && !isReplaying}}">
    <view wx:if="{{aeControlsVisible}}" class="ae-af-wrap" pointer-events="none">
      <view
        class="ae-focus-cluster {{aeFocusIsTapPosition ? '' : 'ae-focus-cluster--center'}} {{aeFocusLockFlash ? 'ae-focus-cluster--flash' : ''}}"
        style="{{aeFocusIsTapPosition ? 'left:' + aeClusterLeftRpx + 'rpx;top:' + aeClusterTopRpx + 'rpx' : ''}}"
        pointer-events="none"
      >
        <block wx:if="{{!aeFocusUserLocked}}">
          <view
            class="ae-focus-bracket"
            bindtap="onAeFocusBracketTap"
          ></view>
          <view wx:if="{{aeShowDoubleTapHint}}" class="ae-double-tap-hint">单击预览区移动；双击方框锁定</view>
        </block>
      </view>
      <!-- 仅在硬件 EV 支持时显示曝光滑条；不支持的机型完全不展示（不做软补光兜底） -->
      <view
        wx:if="{{aeExposureHardwareSupported}}"
        class="ae-sun-rail ae-sun-rail--dock-right"
        catchtouchstart="onAeSunTouchStart"
        catchtouchmove="onAeSunTouchMove"
        catchtouchend="onAeSunTouchEnd"
        catchtouchcancel="onAeSunTouchEnd"
      >
        <view class="ae-sun-glyph">☼</view>
        <view class="ae-sun-track">
          <view class="ae-sun-thumb" style="top:{{aeSunTopPct}}%;"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- Level 1: 记分 UI 遮罩层 (沉浸式，不避让状态栏) -->
  <view class="overlay immersive">
    <!-- 底角双灯：上=推流/REC，下=存储；位置在 16:9 外黑边（见 recoverFabStackStyle） -->
    <view class="recover-fab-stack" style="{{recoverFabStackStyle}}">
      <view
        class="recover-fab recover-fab--{{pipelineHealth}} {{isRecovering ? 'recover-fab--busy' : ''}} {{opsControlActionable ? 'recover-fab--actionable' : ''}} {{opsControlAck ? 'recover-fab--ack' : ''}}"
        catchtap="onRecoveryFabTap"
        bindtouchstart="onRecoveryFabTouchStart"
        bindtouchend="onRecoveryFabTouchEnd"
        bindtouchcancel="onRecoveryFabTouchEnd"
        catchlongpress="onRecoveryFabLongPress"
      >
        <view class="recover-fab-ring">
          <view
            wx:if="{{isRecovering}}"
            class="recover-fab-progress"
            style="background: conic-gradient(from -90deg, rgba(74, 222, 128, 0.5) 0deg, rgba(74, 222, 128, 0.5) {{recoveryConicEndDeg}}deg, rgba(48, 52, 58, 0.38) 0deg);"
          ></view>
          <view
            wx:elif="{{isSavingHighlight}}"
            class="recover-fab-progress recover-fab-progress--highlight-save"
            style="background: conic-gradient(from -90deg, rgba(74, 222, 128, 0.5) 0deg, rgba(74, 222, 128, 0.5) {{highlightSaveConicEndDeg}}deg, rgba(48, 52, 58, 0.38) 0deg);"
          ></view>
          <view
            wx:else
            class="recover-fab-progress"
            style="background: conic-gradient(from -90deg, rgba(48, 52, 58, 0.38) 0deg, rgba(48, 52, 58, 0.38) 360deg);"
          ></view>
          <view class="recover-fab-inner">
            <text class="recover-fab-text">{{opsControlText}}</text>
          </view>
        </view>
      </view>
      <view
        wx:if="{{storageSevereLock}}"
        class="recover-fab recover-fab--cache recover-fab--cache--{{cacheStorageLampLevel}} {{cacheStorageLampActionable ? 'recover-fab--cache-tap' : 'recover-fab--cache-locked'}}"
        catchtap="onCacheStorageLampTap"
      >
        <view class="recover-fab-ring">
          <view
            wx:if="{{!cacheStorageLampActionable}}"
            class="recover-fab-progress"
            style="background: conic-gradient(from -90deg, rgba(48, 52, 58, 0.38) 0deg, rgba(48, 52, 58, 0.38) 360deg);"
          ></view>
          <view wx:else class="recover-fab-progress recover-fab-progress--cache-alert"></view>
          <view class="recover-fab-inner">
            <text class="recover-fab-text">{{cacheStorageLampText}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 相机设置 ◎：与 REC 角对称，落在黑边；呼出条在 cameraSettingsPanelStyle -->
    <view
      class="left-camera-fab-stack"
      style="{{leftCameraFabStyle}}"
      wx:if="{{cameraMounted && liveStreamAllowed && !isReplaying && drawerMode === 0 && enhanceMode !== 'vk'}}"
    >
      <view class="recover-fab recover-fab--ok left-cam-fab" catchtap="onCameraSettingsFabTap">
        <view class="recover-fab-ring">
          <view class="recover-fab-progress left-cam-fab-progress"></view>
          <view class="recover-fab-inner left-cam-fab-inner">
            <text class="recover-fab-text left-cam-fab-glyph">◎</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 相机设置呼出：16:9 取景区内左侧（见 cameraSettingsPanelStyle），须放在 overlay 内以免被记分/角标压住 -->
    <view
      wx:if="{{cameraSettingsOpen && cameraMounted && liveStreamAllowed && !isReplaying && drawerMode === 0 && enhanceMode !== 'vk'}}"
      class="camera-settings-panel-host"
      style="{{cameraSettingsPanelStyle}}"
    >
      <view class="left-camera-panel left-camera-panel--in-stage">
        <view
          wx:for="{{cameraViewModeStops}}"
          wx:key="mode"
          class="left-camera-pill {{cameraViewMode === item.mode ? 'left-camera-pill--active' : ''}}"
          catchtap="onCameraViewModeTap"
          data-mode="{{item.mode}}"
        >{{item.label}}</view>
        <view class="left-camera-pill left-camera-pill--focus" catchtap="onCameraFocusControlTap">锁焦</view>
      </view>
    </view>

    <view
      class="light-hint"
      wx:if="{{lightHintText}}"
      style="opacity: {{lightHintOpacity}};"
    >
      <text class="light-hint__text">{{lightHintText}}</text>
    </view>

    <!-- 核心记分区域：位于正下方居中 -->
    <view class="bottom-center-board">
      <!-- 比赛名称与迷你回放按钮 -->
      <view class="match-name-row">
        <view
          class="match-name-banner"
          catchlongpress="onExportHealthLogs"
          style="color: {{matchConfig.matchNameColor}}"
        >
          {{matchConfig.matchName || 'HoopsLive Assistant'}}
        </view>
      </view>

      <!-- 记分条主体：左右等宽且比分固定（色条视觉约 50% 高度，操作热区保持原 min-height） -->
      <view class="main-score-bar">
        <!-- 占位，平衡右侧的 24s，确保中心对齐 -->
        <view wx:if="{{isAutoMode}}" class="shot-clock-placeholder"></view>

        <!-- 球队 A 容器 -->
        <view
          class="team-group team-a-group"
          style="width: {{teamGroupWidthPxA}}px; max-width: {{teamGroupWidthPxA}}px;"
        >
          <view
            class="team-group-bg team-group-bg--left"
            style="background-color: {{matchConfig.teamA.rgbaBg || 'rgba(230, 67, 64, 0.7)'}}"
          ></view>
          <view class="team-group-row">
            <view
              class="team-name team-name--a"
              catchtap="{{isAutoMode ? '' : 'onScoreTap'}}"
              bindlongpress="{{isAutoMode ? '' : 'onScoreLongPress'}}"
              bindtouchend="{{isAutoMode ? '' : 'onScoreTouchEnd'}}"
              data-team="teamA"
              data-type="plus"
              style="color: {{matchConfig.teamA.textColor}};"
            >
              <text class="team-name-inner">{{c.limitTeamName(matchConfig.teamA.name || '队A')}}</text>
            </view>
            <view
              class="score-value"
              catchtap="{{isAutoMode ? '' : 'onScoreTap'}}"
              bindlongpress="{{isAutoMode ? '' : 'onScoreLongPress'}}"
              bindtouchend="{{isAutoMode ? '' : 'onScoreTouchEnd'}}"
              data-team="teamA"
              data-type="minus"
              style="color: {{matchConfig.teamA.textColor}};"
            >
              {{matchConfig.teamA.score}}
            </view>
          </view>
        </view>

        <!-- 中间节次：单击循环切换 -->
        <view class="period-center-outer {{isAutoMode ? 'period-center-outer--auto' : ''}}" bindtap="onPeriodTap" bindlongpress="{{autoSyncWhitelisted ? 'onPeriodLongPress' : ''}}">
          <view class="period-strip"></view>
          <view class="period-container">
            <view class="period-text {{isAutoMode ? 'period-text--auto' : ''}}" style="color: {{periodFlash ? '#000000' : '#fff'}}">
              {{periods[matchConfig.period]}}
            </view>
            <view wx:if="{{isAutoMode}}" class="period-time" style="color: {{periodFlash ? '#000000' : '#fff'}}">
              {{c.zeroPad2(bleMinutes)}}:{{c.zeroPad2(bleSeconds)}}
            </view>
          </view>
        </view>

        <!-- 球队 B 容器 -->
        <view
          class="team-group team-b-group"
          style="width: {{teamGroupWidthPxB}}px; max-width: {{teamGroupWidthPxB}}px;"
        >
          <view
            class="team-group-bg team-group-bg--right"
            style="background-color: {{matchConfig.teamB.rgbaBg || 'rgba(16, 174, 255, 0.7)'}}"
          ></view>
          <view class="team-group-row">
            <!-- 比分部分：点击-1，长按快速-1 -->
            <view
              class="score-value"
              catchtap="{{isAutoMode ? '' : 'onScoreTap'}}"
              bindlongpress="{{isAutoMode ? '' : 'onScoreLongPress'}}"
              bindtouchend="{{isAutoMode ? '' : 'onScoreTouchEnd'}}"
              data-team="teamB"
              data-type="minus"
              style="color: {{matchConfig.teamB.textColor}};"
            >
              {{matchConfig.teamB.score}}
            </view>
            <!-- 队名部分：点击+1，长按快速+1 -->
            <view
              class="team-name team-name--b"
              catchtap="{{isAutoMode ? '' : 'onScoreTap'}}"
              bindlongpress="{{isAutoMode ? '' : 'onScoreLongPress'}}"
              bindtouchend="{{isAutoMode ? '' : 'onScoreTouchEnd'}}"
              data-team="teamB"
              data-type="plus"
              style="color: {{matchConfig.teamB.textColor}};"
            >
              <text class="team-name-inner">{{c.limitTeamName(matchConfig.teamB.name || '队B')}}</text>
            </view>
          </view>
        </view>

        <!-- 24秒倒计时 (自动模式) -->
        <view wx:if="{{isAutoMode}}" class="shot-clock-outer {{bleShotClock <= 5 ? 'shot-clock-outer--warn' : ''}}">
          {{bleShotClock}}
        </view>
      </view>


    </view>

  </view>

  <!-- 权益拦截：全屏引导（风格对齐 guide-overlay） -->
  <view class="vip-gate-root" wx:if="{{showVipGate}}" catchtouchmove="onVipGateCatchMove">
    <view class="vip-gate-bg"></view>
    <view class="vip-gate-card" catchtap="stopVipGateInnerBubble">
      <view class="vip-gate-kicker">HoopsLive</view>
      <view class="vip-gate-title">{{vipGateTitle}}</view>
      <view class="vip-gate-sub">{{vipGateSubtext}}</view>
      <view class="vip-gate-minor" wx:if="{{vipGateMinor}}">{{vipGateMinor}}</view>
      <button class="vip-gate-share-btn" open-type="share">立即分享，继续试用</button>
      <view class="vip-gate-row">
        <view class="vip-gate-link" bindtap="onVipGateSwitchMine">返回「我的」</view>
        <view class="vip-gate-link vip-gate-link--sep" wx:if="{{vipGateRetryVisible}}">·</view>
        <view class="vip-gate-link" wx:if="{{vipGateRetryVisible}}" bindtap="onVipGateRetryTap">重试</view>
      </view>
    </view>
  </view>

  <!-- Level 2: 导播回放遮罩与播放层 -->
  <view class="replay-mask replay-mask--{{replayMaskKind}}" wx:if="{{showReplayMask}}">
    <view class="replay-mask-text">{{replayMaskText}}</view>
  </view>
  
  <view class="replay-mask" wx:if="{{replayFastForwarding}}" style="z-index: 1000; background: #000; display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <view class="replay-premium-loader">
      <view class="replay-loader-ring"></view>
      <view class="replay-loader-dot"></view>
    </view>
    <view class="replay-mask-text" style="font-size: 32rpx; margin-top: 40rpx; letter-spacing: 4rpx; font-weight: 500; opacity: 0.8; animation: replayTextPulse 1.5s infinite alternate;">正在定位高光时刻</view>
  </view>

  <view class="replay-overlay" wx:if="{{isReplaying}}">
    <!-- 与直播 live-stage 同尺寸的 16:9 内接区域，仅承载视频与手势；控件在 replay-chrome 全屏层 -->
    <view class="replay-stage" style="{{liveStageInlineStyle}}">
    <movable-area class="replay-movable-area">
      <movable-view
        class="replay-movable-view"
        direction="all"
        scale="{{true}}"
        scale-min="1"
        scale-max="3"
        x="{{replayViewX}}"
        y="{{replayViewY}}"
        scale-value="{{replayViewScale}}"
        bindscale="onReplayViewScale"
        bindchange="onReplayViewChange"
        capture-bindtouchstart="onReplayPinchCaptureStart"
        capture-bindtouchmove="onReplayPinchCaptureMove"
        bindtouchend="onReplayMovableTouchEnd"
        bindtouchcancel="onReplayMovableTouchCancel"
        out-of-bounds="{{false}}"
        damping="20"
        friction="2"
      >
        <!--
          双 slot 无缝切换：slot-a / slot-b 始终在 DOM 中，避免 src 切换触发重新加载。
          活跃 slot 通过 z-index 置顶；非活跃 slot 在后台静默预加载下一段。
        -->

        <!-- Slot A -->
        <view class="replay-slot {{replayActiveSlot === 0 ? 'replay-slot--active' : 'replay-slot--back'}}">
          <video
            id="replayVideoA"
            src="{{replaySlotASrc}}"
            class="replay-video-fullscreen {{replayVideoNeedRotate ? 'replay-video-fullscreen--rotated' : ''}}"
            style="{{replayVideoNeedRotate ? 'transform: translate(-50%, -50%) rotate(' + replayVideoRotateDeg + 'deg);' : 'transform: translate(-50%, -50%);'}}"
            autoplay="{{false}}"
            initial-time="{{replaySlotAInitialTime}}"
            controls="{{false}}"
            show-center-play-btn="{{false}}"
            show-play-btn="{{false}}"
            enable-progress-gesture="{{false}}"
            playbackRate="{{replayPlaybackRate}}"
            muted="{{replayActiveSlot !== 0 ? true : replayMuted}}"
            loop="{{false}}"
            bindplay="onReplayVideoAPlay"
            bindtimeupdate="onReplayVideoATimeUpdate"
            bindloadedmetadata="onReplayVideoALoadedMeta"
            bindended="onReplayVideoAEnded"
            bindseeked="onReplayVideoASeeked">
          </video>
        </view>

        <!-- Slot B：预加载第二段，切换时瞬间置顶 -->
        <view class="replay-slot {{replayActiveSlot === 1 ? 'replay-slot--active' : 'replay-slot--back'}}">
          <video
            id="replayVideoB"
            src="{{replaySlotBSrc}}"
            class="replay-video-fullscreen {{replayVideoNeedRotate ? 'replay-video-fullscreen--rotated' : ''}}"
            style="{{replayVideoNeedRotate ? 'transform: translate(-50%, -50%) rotate(' + replayVideoRotateDeg + 'deg);' : 'transform: translate(-50%, -50%);'}}"
            autoplay="{{false}}"
            initial-time="{{replaySlotBInitialTime}}"
            controls="{{false}}"
            show-center-play-btn="{{false}}"
            show-play-btn="{{false}}"
            enable-progress-gesture="{{false}}"
            playbackRate="{{replayPlaybackRate}}"
            muted="{{replayActiveSlot !== 1 ? true : replayMuted}}"
            loop="{{false}}"
            bindplay="onReplayVideoBPlay"
            bindtimeupdate="onReplayVideoBTimeUpdate"
            bindloadedmetadata="onReplayVideoBLoadedMeta"
            bindended="onReplayVideoBEnded"
            bindseeked="onReplayVideoBSeeked">
          </video>
        </view>
      </movable-view>
    </movable-area>
    </view>

    <!-- 全屏层：左上纯状态指示；右侧黑边竖排工具（与 REC 同列，不占画面内顶栏） -->
    <view class="replay-chrome">
      <view class="replay-status-indicator">
        <view class="replay-status-indicator__dot"></view>
        <text class="replay-status-indicator__text">实时回看</text>
      </view>
      <view class="replay-rail" style="{{replayRailStyle}}">
        <view class="replay-rail__stack">
          <view
            class="recover-fab replay-side-fab {{replayPlaybackRate === 0.5 ? 'replay-side-fab--active' : ''}}"
            catchtap="onReplaySpeedChange"
            data-rate="0.5"
          >
            <view class="recover-fab-ring replay-side-fab-ring">
              <text class="recover-fab-text replay-side-fab-label">0.5</text>
            </view>
          </view>
          <view
            class="recover-fab replay-side-fab {{replayPlaybackRate === 0.75 ? 'replay-side-fab--active' : ''}}"
            catchtap="onReplaySpeedChange"
            data-rate="0.75"
          >
            <view class="recover-fab-ring replay-side-fab-ring">
              <text class="recover-fab-text replay-side-fab-label">0.75</text>
            </view>
          </view>
          <view
            class="recover-fab replay-side-fab {{replayPlaybackRate === 1.0 ? 'replay-side-fab--active' : ''}}"
            catchtap="onReplaySpeedChange"
            data-rate="1.0"
          >
            <view class="recover-fab-ring replay-side-fab-ring">
              <text class="recover-fab-text replay-side-fab-label">1</text>
            </view>
          </view>
          <view
            class="recover-fab replay-side-fab"
            catchtap="onReplayResetView"
            wx:if="{{replayViewScale > 1}}"
          >
            <view class="recover-fab-ring replay-side-fab-ring replay-side-fab-ring--icon">
              <view class="replay-icon replay-icon--fitscreen"></view>
            </view>
          </view>
          <view class="recover-fab replay-side-fab replay-side-fab--dismiss" catchtap="onReplayClose">
            <view class="recover-fab-ring replay-side-fab-ring">
              <text class="recover-fab-text replay-side-fab-label replay-side-fab-label--dismiss">✕</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Level 3: 操作指南弹窗（毛玻璃深色双列布局 + 抖音 16:9 画幅第二步） -->
  <view class="guide-overlay" wx:if="{{showGuide}}" catchtouchmove="noop">
    <!-- 第一步：卡片居中；主按钮在卡片外侧右侧、靠下，腾出卡片内可视高度 -->
    <view class="guide-sheet" wx:if="{{guideSubStep === 0}}">
    <view class="guide-card guide-card--quick" catchtap="noop">
      <view class="guide-title-bar">
        <text class="guide-main-title">快速上手</text>
      </view>

      <view class="guide-columns">

        <view class="guide-col">
          <view class="guide-section-header">
            <text class="guide-section-emoji">👉</text>
            <text class="guide-section-title">得分操控</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">单击队名</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">得 +1 分</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">长按队名</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">连续得分</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">单击得分</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">得 -1 分</text>
          </view>
        </view>

        <view class="guide-divider-v"></view>

        <view class="guide-col">
          <view class="guide-section-header">
            <text class="guide-section-emoji">🎥</text>
            <text class="guide-section-title">录制与回放</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">保存片段</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">单击 REC</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">恢复相机</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">长按 REC</text>
          </view>
          <view class="guide-item">
            <text class="guide-action">查看回放</text>
            <text class="guide-sep">：</text>
            <text class="guide-desc">长按空白处</text>
          </view>
        </view>

      </view>

      <view class="guide-full-divider"></view>

      <view class="guide-item guide-item-full">
        <text class="guide-action">左下 ◎</text>
        <text class="guide-sep">：</text>
        <text class="guide-desc">机位（广角/数字倍数）/ 呼出对焦</text>
      </view>

      <view class="guide-item guide-item-full">
        <text class="guide-action">长按空白处</text>
        <text class="guide-sep">：</text>
        <text class="guide-desc"> 查看列表 / 返回主页 </text>
      </view>
    </view>
    <view class="guide-outside-btn" catchtap="onGuideToDyFrame">下一步</view>
    </view>

    <!-- 第二步：画幅说明；完成按钮同第一步，置于卡片外右侧 -->
    <view class="guide-sheet guide-sheet--dy" wx:if="{{guideSubStep === 1}}">
    <view class="guide-card guide-card--dy-frame" catchtap="noop">
      <view class="guide-title-bar guide-title-bar--dy">
        <text class="guide-main-title">直播画幅设置</text>
      </view>

      <scroll-view class="guide-dy-scroll" scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="guide-dy-callout">
          <text class="guide-dy-callout__title">请务必在抖音直播中使用手游模式，并将画面比例设为 16:9</text>
          <text class="guide-dy-callout__sub">否则推流画面极易出现黑边，影响观感。</text>
        </view>

        <view class="guide-dy-step">
          <text class="guide-dy-step__label">a. 设置入口</text>
          <text class="guide-dy-step__path">开直播 → 手游 → 画面比例</text>
          <image class="guide-dy-shot" src="/pages/live/images/rate1.png" mode="widthFix" />
        </view>

        <view class="guide-dy-step guide-dy-step--last">
          <text class="guide-dy-step__label">b. 选择比例</text>
          <text class="guide-dy-step__path">请选择「16:9」</text>
          <image class="guide-dy-shot" src="/pages/live/images/rate2.png" mode="widthFix" />
        </view>
      </scroll-view>
    </view>
    <view class="guide-outside-btn" catchtap="dismissGuide">完成</view>
    </view>
  </view>

  <view
    wx:if="{{vkDebugPanelVisible && enhanceMode === 'vk'}}"
    class="vk-debug-panel"
    catchtap="stopEnhanceToolbarBubble"
  >
    <view class="vk-debug-panel__head" catchlongpress="onVkDebugToolbarLongPress">
      <view class="vk-debug-panel__scene-copy">
        <view class="vk-debug-panel__caption">当前场景</view>
        <view class="vk-debug-panel__title">{{vkPresetCurrentLabel}}</view>
      </view>
      <view class="vk-debug-panel__badge {{vkDebugFreezeAuto ? 'vk-debug-panel__badge--freeze' : ''}}">
        {{vkDebugFreezeAuto ? 'PARAM LOCK' : 'AUTO LIVE'}}
      </view>
    </view>

    <scroll-view
      class="vk-debug-panel__body"
      scroll-y="{{true}}"
      enhanced="{{true}}"
      enable-passive="{{true}}"
      show-scrollbar="{{false}}"
    >
    <view class="vk-debug-panel__selector-head">
      <text class="vk-debug-panel__label">场景选择</text>
      <view class="vk-debug-panel__action-btn" catchtap="onVkPresetRestore">恢复推荐</view>
    </view>

    <scroll-view
      class="vk-debug-panel__selector-scroll"
      scroll-x="{{true}}"
      enhanced="{{true}}"
      enable-passive="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view class="vk-debug-panel__selector-track">
        <view
          wx:for="{{vkPresetOptions}}"
          wx:key="name"
          class="vk-debug-panel__preset-pill {{vkPresetCurrent === item.name ? 'vk-debug-panel__preset-pill--active' : ''}}"
          catchtap="onVkPresetPick"
          data-preset="{{item.name}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="vk-debug-panel__actions">
      <view class="vk-debug-panel__action-hint">切换场景会立即套用 preset，并保留你当前的人工微调</view>
    </view>

    <view class="vk-debug-panel__sampling-box">
      <view class="vk-debug-panel__sampling-meta">
        <view class="vk-debug-panel__sampling-copy">
          <text class="vk-debug-panel__label">环境采样</text>
          <text wx:if="{{vkEnvSamplingHint}}" class="vk-debug-panel__hint">{{vkEnvSamplingHint}}</text>
        </view>
        <view
          class="vk-debug-panel__action-btn {{vkEnvSamplingState === 'SAMPLING' ? 'vk-debug-panel__action-btn--busy' : ''}}"
          catchtap="onVkEnvironmentSampleTap"
        >{{vkEnvSamplingButtonText}}</view>
      </view>
      <view wx:if="{{vkEnvSamplingProgressText}}" class="vk-debug-panel__sampling-progress">
        <text class="vk-debug-panel__value">{{vkEnvSamplingProgressText}}</text>
      </view>
      <view wx:if="{{vkEnvAutoAdjustSummary}}" class="vk-debug-panel__sampling-progress">
        <text class="vk-debug-panel__hint">自动微调：{{vkEnvAutoAdjustSummary}}</text>
      </view>
    </view>

    <view class="vk-debug-panel__params-head">
      <text class="vk-debug-panel__label">当前参数</text>
      <text class="vk-debug-panel__hint">滑杆只修改人工微调，不覆盖推荐值</text>
    </view>

    <view class="vk-debug-panel__row">
      <view class="vk-debug-panel__meta">
        <text class="vk-debug-panel__label">Amount</text>
        <text class="vk-debug-panel__value">{{vkDebugAmount}} / {{vkDebugAmountOffsetPct}}%</text>
      </view>
      <slider
        min="45"
        max="65"
        step="1"
        value="{{vkDebugAmountPct}}"
        activeColor="#ff7a45"
        backgroundColor="rgba(255,255,255,0.18)"
        block-size="18"
        bindchanging="onVkDebugAmountChanging"
        bindchange="onVkDebugAmountChanging"
      />
    </view>

    <view class="vk-debug-panel__row">
      <view class="vk-debug-panel__meta">
        <text class="vk-debug-panel__label">Tone</text>
        <text class="vk-debug-panel__value">{{vkDebugTone}} / {{vkDebugToneOffsetPct}}%</text>
      </view>
      <slider
        min="80"
        max="95"
        step="1"
        value="{{vkDebugTonePct}}"
        activeColor="#36cfc9"
        backgroundColor="rgba(255,255,255,0.18)"
        block-size="18"
        bindchanging="onVkDebugToneChanging"
        bindchange="onVkDebugToneChanging"
      />
    </view>

    <view class="vk-debug-panel__row">
      <view class="vk-debug-panel__meta">
        <text class="vk-debug-panel__label">Motion</text>
        <text class="vk-debug-panel__value">{{vkDebugMotion}} / {{vkDebugMotionOffsetPct}}%</text>
      </view>
      <slider
        min="60"
        max="82"
        step="1"
        value="{{vkDebugMotionPct}}"
        activeColor="#69c0ff"
        backgroundColor="rgba(255,255,255,0.18)"
        block-size="18"
        bindchanging="onVkDebugMotionChanging"
        bindchange="onVkDebugMotionChanging"
      />
    </view>

    <view class="vk-debug-panel__switch-row">
      <view class="vk-debug-panel__switch-copy">
        <text class="vk-debug-panel__label">锁定参数</text>
        <text class="vk-debug-panel__hint">VK preset 生效时建议保持锁定，避免自动曲线抢回控制</text>
      </view>
      <switch
        checked="{{vkDebugFreezeAuto}}"
        color="#ff7a45"
        bindchange="onVkDebugFreezeAutoChange"
      />
    </view>
    </scroll-view>
  </view>

  <!-- Level 3: 管理抽屉 (drawerMode 0=隐藏 1=打开) -->
  <view wx:if="{{drawerMode === 1}}">

    <!-- 遮罩：点击关闭（z-index 低于面板，不拦截面板内点击） -->
    <view class="drawer-mode-backdrop" catchtap="closeAllDrawers"></view>

    <!-- 高清渲染调试工具条：仅内测白名单用户且设备能力通过时显示；需先长按空白区打开抽屉 -->
    <view wx:if="{{enhanceWhitelisted && enhanceBetaWhitelisted}}" class="enhance-mode-toolbar {{enhanceVkTransitioning ? 'enhance-mode-toolbar--transitioning' : ''}}" catchtap="stopEnhanceToolbarBubble">
      <view class="enhance-mode-status" catchlongpress="onVkDebugToolbarLongPress">
        <text class="enhance-mode-k">画质增强</text>
        <text class="enhance-mode-v">{{c.enhanceModeLabel(enhanceMode)}} · {{enhanceFpsText}}</text>
      </view>
      <view class="enhance-mode-group">
        <view
          class="enhance-mode-btn {{enhanceMode === 'off' ? 'enhance-mode-btn--active' : ''}}"
          catchtap="onEnhanceModePick" data-mode="off"
        >关闭</view>
        <view
          class="enhance-mode-btn {{(enhanceMode === 'lite' || enhanceMode === 'standard' || enhanceMode === 'strong') ? 'enhance-mode-btn--active' : ''}}"
          catchtap="onEnhanceModePick" data-mode="strong"
        >智能</view>
        <view
          wx:if="{{enhanceVkSupported}}"
          class="enhance-mode-btn enhance-mode-btn--vk {{enhanceMode === 'vk' ? 'enhance-mode-btn--active' : ''}}"
          catchtap="onEnhanceModePick" data-mode="vk"
        >超频</view>
      </view>
    </view>

    <!-- 左侧：比赛卡片列表（与右侧高光缩略图完全一致的矩形） -->
    <view class="left-drawer" catchtap="stopLeftDrawerBubbling">
      <!-- 场次计数标题 -->
      <view class="clip-count-bar">
        <text class="clip-count-label">场次：{{matchCount}}</text>
      </view>
      <view class="match-list-view">
        <scroll-view 
          scroll-y 
          class="left-drawer-scroll" 
          show-scrollbar="{{false}}"
          enable-passive="{{true}}"
          enhanced="{{true}}"
        >
          <view
            class="lm-card drawer-list-thumb {{item.isCurrent ? 'lm-card--current' : ''}}"
            wx:for="{{matchList}}"
            wx:key="id"
            catchtap="openColorModal"
            data-id="{{item.id}}"
          >
            <text class="lm-name">{{item.teamA.name || 'A'}}</text>
            <text class="lm-vs">vs</text>
            <text class="lm-name">{{item.teamB.name || 'B'}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 右侧：高光缩略图 -->
    <view class="drawer-panel" catchtap="stopDrawerBubbling">
      <!-- 片段计数标题 -->
      <view class="clip-count-bar">
        <text class="clip-count-label">片段：{{highlightCount}}</text>
      </view>
      <view class="clip-list-view">
        <scroll-view 
          scroll-y 
          class="drawer-scroll" 
          show-scrollbar="{{false}}"
          enable-passive="{{true}}"
          enhanced="{{true}}"
        >
          <view
            class="drawer-item drawer-list-thumb"
            wx:for="{{drawerHighlights}}"
            wx:key="id"
            bindtap="onDrawerSelect"
            bindlongpress="onDeleteHighlight"
            data-id="{{item.id}}"
          >
            <!-- 封面图 -->
            <image
              wx:if="{{item.hasRealCover}}"
              class="drawer-cover"
              mode="aspectFill"
              lazy-load="{{true}}"
              src="{{item.thumbSrc || item.cover || defaultCover}}"
              binderror="onDrawerImageError"
              data-id="{{item.id}}"
            ></image>
            <!-- 左上：序号角标（弱化） -->
            <text class="clip-index-badge">#{{item.clipIndex}}</text>
            <!-- 右下：已存相册角标 -->
            <view wx:if="{{item.savedToAlbum}}" style="position:absolute; bottom:40px; right:5px; background:rgba(0,0,0,0.7); color:#4ade80; font-size:10px; padding:2px 4px; border-radius:4px; z-index:10; border:1px solid #4ade80;">已存相册</view>
            <!-- 右上：播放示意 -->
            <view class="clip-play-btn" wx:if="{{!item.savedToAlbum}}">▶</view>
            <!-- 正中：比分（无队名） -->
            <view class="clip-score-center">
              <text class="clip-score-digit" style="color: {{item.colorA}};">{{item.scoreA}}</text>
              <text class="clip-score-colon">:</text>
              <text class="clip-score-digit" style="color: {{item.colorB}};">{{item.scoreB}}</text>
            </view>
            <!-- 左下：时间 -->
            <text class="clip-time-bl">{{item.timeText}}</text>
          </view>
        </scroll-view>
      </view>
    </view>

    <!-- 返回/退出：矢量遮罩箭头 -->
    <view class="drawer-back-btn" bindtap="onBackTap">
      <view class="live-toolbar-icon live-toolbar-icon--back"></view>
    </view>

  </view>

  <!--
    严重存储：统一用页面 fixed 遮罩（z-index 高于 WebGL canvas），勿用 camera 内 cover-view。
    cover-view 对 flex/min/百分比宽度支持差，VK 切换重建相机后易宽度坍缩导致图二错乱。
  -->
  <view
    class="storage-pressure-overlay"
    wx:if="{{showStoragePressureModal}}"
    catchtouchmove="noopCatchMove"
  >
    <view class="storage-pressure-backdrop" bindtap="onStoragePressureModalDismiss"></view>
    <view class="storage-pressure-panel" catchtap="stopColorModalBubbling">
      <view class="storage-pressure-title">存储空间紧张</view>
      <view class="storage-pressure-text">{{storagePressureModalText}}</view>
      <view class="storage-pressure-row">
        <view class="storage-pressure-btn storage-pressure-btn--secondary" catchtap="onStoragePressureModalDismiss">
          知道了
        </view>
        <view class="storage-pressure-btn storage-pressure-btn--primary" catchtap="onStoragePressureModalConfirm">
          下载并清空
        </view>
      </view>
    </view>
  </view>

  <!-- ── 颜色设置浮层：极致透明、动态占比 ── -->
  <view class="color-modal-overlay" wx:if="{{showColorModal}}" catchtap="closeColorModal">
    <view class="color-modal-container" catchtap="stopColorModalBubbling">

      <!-- 队名显示层 -->
      <view class="cm-teams-header">
        <view
          class="cm-team-item cm-team-item--left {{colorModalTeam === 'teamA' ? 'cm-team-item--active' : ''}}"
          style="border-color: {{colorModalTeam === 'teamA' ? colorModalMatch.teamA.bgColor : 'rgba(255, 255, 255, 0.15)'}}"
          catchtap="onSelectModalTeam"
          data-team="teamA"
        >
          <text class="cm-team-name cm-team-name--left">{{colorModalMatch.teamA.name || '主队'}}</text>
          <view class="cm-color-swatch cm-color-swatch--jersey cm-color-swatch--left">
            <view
              class="cm-color-swatch__jersey-fill"
              style="background-color: {{colorModalMatch.teamA.bgColor}};"
            ></view>
          </view>
        </view>
        <text class="cm-vs-divider">VS</text>
        <view
          class="cm-team-item cm-team-item--right {{colorModalTeam === 'teamB' ? 'cm-team-item--active' : ''}}"
          style="border-color: {{colorModalTeam === 'teamB' ? colorModalMatch.teamB.bgColor : 'rgba(255, 255, 255, 0.15)'}}"
          catchtap="onSelectModalTeam"
          data-team="teamB"
        >
          <view class="cm-color-swatch cm-color-swatch--jersey cm-color-swatch--right">
            <view
              class="cm-color-swatch__jersey-fill"
              style="background-color: {{colorModalMatch.teamB.bgColor}};"
            ></view>
          </view>
          <text class="cm-team-name cm-team-name--right">{{colorModalMatch.teamB.name || '客队'}}</text>
        </view>
      </view>

      <!-- 24色无滚动矩阵：12列 x 2行 -->
      <view class="cm-matrix-palette">
        <view
          class="cm-matrix-ball {{c.ballActive(colorModalTeam, colorModalMatch.teamA.bgColor, colorModalMatch.teamB.bgColor, b) ? 'cm-matrix-ball--active' : ''}}"
          wx:for="{{colorBalls}}"
          wx:for-item="b"
          wx:key="*this"
          style="background-color: {{b}}; border-color: {{b === '#FFFFFF' ? '#E2E8F0' : b}}"
          catchtap="onChangeTeamColor"
          data-color="{{b}}"
        ></view>
      </view>

      <!-- 缓存 Footer：仅在 colorModalCacheRowHint 非空时显示（缓存为 0 时 JS 会置空以隐藏） -->
      <view class="cm-cache-footer" wx:if="{{colorModalCacheRowHint}}">
        <view class="cm-cache-divider"></view>
        <view class="cm-cache-row">
          <text class="cm-cache-text">{{colorModalCacheRowHint}}</text>
          <view
            wx:if="{{!colorModalDownloadCleared}}"
            class="cm-cache-btn"
            catchtap="onDownloadHighlightsToAlbumAndClearCache"
          >下载并清空</view>
          <text wx:else class="cm-cache-done">已清空</text>
        </view>
      </view>

      <!-- 切换按钮 -->
      <view class="cm-action-row">
        <view
          class="cm-btn-switch {{colorModalMatch.isCurrent ? 'cm-btn-switch--disabled' : ''}}"
          catchtap="onSwitchMatchFromModal"
        >
          <text>{{colorModalMatch.isCurrent ? '当前场次' : '切换'}}</text>
        </view>
      </view>

    </view>
  </view>
</view>
