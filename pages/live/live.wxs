/**
 * 颜色比较（忽略 HEX 大小写）
 * @param {string} a
 * @param {string} b
 * @returns {boolean}
 */
function eqColor(a, b) {
  return (a || '').toLowerCase() === (b || '').toLowerCase();
}

/**
 * 当前选中队伍下，色球是否为该队当前颜色
 * @param {string} sel teamA | teamB
 * @param {string} teamA
 * @param {string} teamB
 * @param {string} ball
 * @returns {boolean}
 */
function ballActive(sel, teamA, teamB, ball) {
  if (sel === 'teamA') return eqColor(teamA, ball);
  if (sel === 'teamB') return eqColor(teamB, ball);
  return false;
}

/**
 * 队名截断：最多保留前 12 个字符，不追加省略号（篮球底栏）。
 * @param {string} name
 * @returns {string}
 */
function limitTeamName(name) {
  var safe = name || '';
  if (safe.length <= 12) return safe;
  return safe.slice(0, 12);
}

/**
 * 足球/羽毛球队名：最多 5 字，超出直接截断无省略号。
 * @param {string} name
 * @returns {string}
 */
function limitTeamNamePro(name) {
  var safe = name || '';
  if (safe.length <= 5) return safe;
  return safe.slice(0, 5);
}

/**
 * 足球/羽毛球队名展示宽度（rpx）：按实际字数缩小，最多按 5 字宽。
 * @param {string} name
 * @returns {number}
 */
function proTeamNameWidthRpx(name) {
  var display = limitTeamNamePro(name);
  var len = display.length;
  if (len < 1) len = 1;
  return len * 11 + 2;
}

/**
 * 记分牌顶栏赛名：最多 10 字，超出直接截断无省略号。
 * @param {string} name
 * @returns {string}
 */
function limitMatchNameBoard(name) {
  var safe = name || '';
  if (safe.length <= 10) return safe;
  return safe.slice(0, 10);
}

/**
 * 增强渲染档位转中文标签（抽屉工具条展示用）。
 * @param {string} mode  off | lite | standard | strong
 * @returns {string}
 */
function enhanceModeLabel(mode) {
  if (mode === 'vk') return '超频';
  if (mode === 'strong') return '高性能';
  if (mode === 'standard') return '标准';
  if (mode === 'lite') return '轻量';
  return '关闭';
}

function zeroPad2(n) {
  var s = '' + n;
  return s.length < 2 ? '0' + s : s;
}

module.exports = {
  eqColor: eqColor,
  ballActive: ballActive,
  limitTeamName: limitTeamName,
  limitTeamNamePro: limitTeamNamePro,
  proTeamNameWidthRpx: proTeamNameWidthRpx,
  limitMatchNameBoard: limitMatchNameBoard,
  enhanceModeLabel: enhanceModeLabel,
  zeroPad2: zeroPad2
};
