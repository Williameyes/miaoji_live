page {
  width: 100vw;
  height: 100vh;
  background-color: #000000 !important;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

.container {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background: #000000;
  overflow: hidden;
  margin: 0;
  padding: 0;
  /* 使用更加正式的系统字体组合，移除全局可能的加粗 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* 背景层：离屏 Canvas (仅供 JS 取帧，不可见) */
.bg-layer-canvas {
  position: absolute;
  left: -9999px;
  top: -9999px;
  width: 120px;
  height: 135px;
}

/* 左右边缘扩散层 */
.ambient-layer {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 18%;
  overflow: hidden;
  z-index: 0;
  pointer-events: none;
}

.ambient-left {
  left: 0;
}

.ambient-right {
  right: 0;
}

.ambient-image {
  position: absolute;
  width: 100%;
  height: 100%;
  object-fit: cover;
  filter: blur(12rpx) brightness(1.18) saturate(1.65) drop-shadow(0 0 24rpx rgba(255,255,255,0.08));
  opacity: 0.78;
  transition: opacity 1000ms ease-in-out;
  animation: ambientBreath 8s ease-in-out infinite alternate;
}

@keyframes ambientBreath {
  0% { transform: scale(2.1) translateX(-2rpx); }
  100% { transform: scale(2.1) translateX(2rpx); }
}

.ambient-left .ambient-image {
  object-position: left center;
  transform-origin: left center;
}

.ambient-right .ambient-image {
  object-position: right center;
  transform-origin: right center;
}

.ambient-mask {
  position: absolute;
  inset: 0;
  z-index: 1;
}

.ambient-left .ambient-mask {
  background: linear-gradient(to left, transparent 0%, rgba(0,0,0,0.18) 100%);
}

.ambient-right .ambient-mask {
  background: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.18) 100%);
}

/* 全屏时相机/画布（无 .live-stage 包裹的旧路径保留）：用 cover 等比裁切。 */
.camera-bg {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  object-fit: cover;
  background-color: #000000;
  z-index: 0;
}

/* 16:9 取景框内：铺满父级（与窗口内接 16:9 一致，典型相机 16:9 时约 1:1 等比、无长条全屏强拉） */
.live-stage {
  position: fixed;
  z-index: 1;
  pointer-events: none;
  overflow: hidden;
}

.live-stage .camera-bg,
.live-stage .enhance-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
  object-fit: contain;
  pointer-events: none;
  z-index: 1;
  background: transparent;
}

.live-stage .camera-bg {
  z-index: 0;
  background-color: #000000;
}

/* 硬恢复相机卸载间隙：静态遮罩（pointer-events:none，不挡状态灯与记分 UI） */
.recovery-veil {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  background: #050608;
  overflow: hidden;
}

.recovery-veil-art {
  width: 100%;
  height: 100%;
  opacity: 0.22;
  display: block;
}

/* 专门针对安卓曲面屏/白边的全屏溢出覆盖 (已废弃，改为全局物理溢出) */

.overlay {
  width: 100%;
  height: calc(100% + env(safe-area-inset-bottom));
  height: calc(100% + constant(safe-area-inset-bottom));
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  pointer-events: none;
}

/* 底角双灯：right/bottom 由内联 recoverFabStackStyle 按 16:9 外黑边计算 */
.recover-fab-stack {
  position: fixed;
  z-index: 24;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  pointer-events: none;
  box-sizing: border-box;
}

/* 相机设置 ◎：left/bottom 由内联 leftCameraFabStyle 按 16:9 外黑边计算，与右下双灯对称 */
.left-camera-fab-stack {
  position: fixed;
  z-index: 24;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
  pointer-events: none;
  box-sizing: border-box;
}

/* 相机入口：弱于 REC，仍保持可发现（略透 + 收敛描边/光晕） */
.left-cam-fab.recover-fab {
  opacity: 0.7;
}

.left-cam-fab.recover-fab--ok .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.14);
}

.left-cam-fab-progress {
  background: conic-gradient(
    from -90deg,
    rgba(95, 217, 95, 0.22) 0deg,
    rgba(48, 52, 58, 0.55) 360deg
  ) !important;
}

.left-cam-fab-inner {
  background: rgba(10, 12, 16, 0.52) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.14) !important;
}

.left-cam-fab {
  align-self: flex-start;
}

.left-cam-fab-glyph {
  font-size: 14rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0;
  color: rgba(255, 255, 255, 0.78) !important;
}

/* 上飘胶囊：与回放倍速、抽屉毛玻璃同系，竖排以免挡取景 */
.left-camera-panel {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 8rpx;
  margin-bottom: 0;
  padding: 6rpx 0;
  pointer-events: auto;
  max-width: 120rpx;
}

.left-camera-pill {
  min-height: 40rpx;
  padding: 0 10rpx;
  border-radius: 20rpx;
  font-size: 16rpx;
  font-weight: 500;
  line-height: 1.1;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.left-camera-pill--focus {
  color: #86efac;
  background: rgba(9, 18, 14, 0.38);
  border-color: rgba(110, 231, 183, 0.35);
}

.left-camera-pill--active {
  color: #f8fafc;
  background: rgba(74, 222, 128, 0.22);
  border-color: rgba(74, 222, 128, 0.45);
}

/* 自动记分：左侧 BLE 圆钮（与 ◎ 同栈，REC 同款 recover-fab） */
.live-ble-fab.recover-fab {
  pointer-events: auto;
  opacity: 0.88;
}

.live-ble-fab--muted.recover-fab {
  opacity: 0.58;
}

.live-ble-fab-progress--on {
  background: conic-gradient(
    from -90deg,
    rgba(95, 217, 95, 0.35) 0deg,
    rgba(48, 52, 58, 0.55) 360deg
  ) !important;
}

.live-ble-fab-progress--off {
  background: conic-gradient(
    from -90deg,
    rgba(120, 120, 130, 0.2) 0deg,
    rgba(48, 52, 58, 0.55) 360deg
  ) !important;
}

.live-ble-fab-inner {
  background: rgba(10, 12, 16, 0.52) !important;
  border: 1rpx solid rgba(255, 255, 255, 0.12) !important;
}

.live-ble-fab-text {
  font-size: 10rpx !important;
  font-weight: 700 !important;
  letter-spacing: 0.5rpx !important;
  color: rgba(255, 255, 255, 0.88) !important;
  font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace !important;
}

.live-ble-panel-backdrop {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 28;
  background: rgba(0, 0, 0, 0.22);
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: calc(24rpx + env(safe-area-inset-top)) 0 0 0;
  box-sizing: border-box;
  pointer-events: auto;
}

.live-ble-panel--compact {
  pointer-events: auto;
  width: auto;
  min-width: 200rpx;
  max-width: 280rpx;
  padding: 12rpx 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(14, 16, 20, 0.94);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.4);
  box-sizing: border-box;
}

.live-ble-busy-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 0;
}

.live-ble-busy-text {
  font-size: 13rpx;
  color: rgba(255, 255, 255, 0.75);
  flex: 1;
  min-width: 0;
}

.live-ble-busy-cancel {
  font-size: 13rpx;
  font-weight: 600;
  color: #93c5fd;
  flex-shrink: 0;
}

.live-ble-input--compact {
  width: 100%;
  height: 44rpx;
  padding: 0 12rpx;
  margin-bottom: 10rpx;
  border-radius: 10rpx;
  background: rgba(0, 0, 0, 0.38);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  box-sizing: border-box;
}

.live-ble-actions--compact {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  justify-content: space-between;
}

.live-ble-actions--remote {
  margin-top: 10rpx;
}

.live-ble-remote-status {
  margin-top: 8rpx;
  font-size: 12rpx;
  line-height: 1.25;
  color: rgba(255, 255, 255, 0.64);
  text-align: center;
}

.live-ble-btn {
  border-radius: 999rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

button.live-ble-btn {
  margin: 0;
  line-height: 1.2;
  max-width: 100%;
  white-space: normal;
}

button.live-ble-btn::after {
  border: 0;
}

.live-ble-btn--ghost {
  color: rgba(255, 255, 255, 0.75);
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.live-ble-btn--primary {
  color: #0f172a;
  background: linear-gradient(180deg, #86efac 0%, #4ade80 100%);
  border: 1rpx solid rgba(74, 222, 128, 0.45);
}

.live-ble-btn--warn {
  color: #fff;
  background: rgba(248, 113, 113, 0.22);
  border: 1rpx solid rgba(248, 113, 113, 0.45);
}

.live-ble-btn--disabled {
  opacity: 0.45;
  pointer-events: none;
}

.live-ble-btn--sm {
  min-width: 0;
  padding: 8rpx 16rpx;
  font-size: 13rpx;
}

/* 呼出条：在 16:9 画幅内左侧，叠层高于角标/记分条热区 */
.camera-settings-panel-host {
  position: fixed;
  z-index: 25;
  pointer-events: none;
  box-sizing: border-box;
}

.camera-settings-panel-host .left-camera-panel--in-stage {
  pointer-events: auto;
  max-height: 70vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 常驻状态钮：更小、更通透，内盘显示 OK / REC / ↻ */
.recover-fab {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  opacity: 0.62;
}

.recover-fab-ring {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.recover-fab-progress {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/** 与硬恢复同款 conic 色；整环略透明以免压住中心 REC 字 */
.recover-fab-progress--highlight-save {
  opacity: 0.88;
}

.recover-fab-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  margin-top: -15rpx;
  border-radius: 50%;
  background: rgba(10, 12, 16, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.recover-fab-text {
  font-size: 10rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
}

.recover-fab--ok .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(95, 217, 95, 0.28);
}

.recover-fab--recording .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(70, 190, 255, 0.32);
}

.recover-fab--recovering .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 208, 74, 0.35);
}

.recover-fab--warn .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 114, 114, 0.32);
}

.recover-fab--actionable .recover-fab-inner {
  background: rgba(52, 18, 18, 0.48);
}

.recover-fab--busy {
  opacity: 0.78;
}

.recover-fab--recording.recover-fab {
  opacity: 0.72;
}

.recover-fab--ack .recover-fab-ring {
  animation: recoverFabAckFlash 0.75s ease-out;
}

@keyframes recoverFabAckFlash {
  0% {
    box-shadow: 0 0 0 0 rgba(95, 217, 95, 0.45);
  }
  100% {
    box-shadow: 0 0 0 10rpx rgba(95, 217, 95, 0);
  }
}

/* 第二颗状态灯：与上颗相同 DOM，复用 .recover-fab-text；副标题 OK / EX 区分 */
.recover-fab--cache-locked {
  pointer-events: none;
}

.recover-fab--cache-tap.recover-fab {
  opacity: 0.72;
}

.recover-fab--cache--ok .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(95, 217, 95, 0.28);
}

.recover-fab--cache--warn .recover-fab-ring,
.recover-fab--cache--severe .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 114, 114, 0.35);
}

.recover-fab--cache--ok .recover-fab-inner {
  background: rgba(10, 14, 12, 0.46);
  border: 1rpx solid rgba(95, 217, 95, 0.22);
}

.recover-fab--cache-tap .recover-fab-inner {
  background: rgba(52, 18, 18, 0.45);
  border: 1rpx solid rgba(255, 180, 180, 0.25);
}

.recover-fab-progress--cache-alert {
  background: rgba(255, 88, 88, 0.32);
}

/* 自绘轻提示：半透明条，短 transition，无 wx.showToast */
.light-hint {
  position: fixed;
  left: 50%;
  bottom: 22%;
  z-index: 90;
  max-width: 72vw;
  padding: 7rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.75);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.32);
  transform: translateX(-50%);
  pointer-events: none;
  box-sizing: border-box;
  transition: opacity 0.18s ease-out;
}

/* 较系统 Toast 略小一号，与记分条/角标体量协调 */
.light-hint__text {
  font-size: 22rpx;
  line-height: 1.38;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 400;
  text-align: center;
}

/* 透明手势层 */
.gesture-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 5; /* 位于相机之上，UI 之下 */
}

.gesture-layer--disabled {
  pointer-events: none;
}

/* 底部居中记分板 */
.bottom-center-board {
  position: absolute;
  bottom: calc(4rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  width: 96vw;
  gap: 0;
}

.match-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  /* 下压进入透明热区，但与色块保留约 2rpx 间距 */
  margin-bottom: -13rpx;
  transform: translateY(0);
  position: relative;
  z-index: 2;
  pointer-events: auto;
}

.match-name-banner {
  font-size: 12rpx;
  line-height: 14rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  padding: 0 10rpx;
  opacity: 0.9;
  flex: 1;
  text-align: center;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
  pointer-events: auto;
}

/* 记分条：色带视觉高度约 30rpx（约为原先 60rpx 的 50%），整行仍保留约 60rpx 操作热区 */
.main-score-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 60rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
  padding: 0;
  box-sizing: border-box;
}

/* 球队组：宽度固定为 12 字占位 + 边距（JS），勿依赖 flex 自动分配以免拉满半屏 */
.team-group {
  position: relative;
  display: block;
  flex: 0 0 auto;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 60rpx;
  overflow: visible;
}

/* 半高色条：仅负责背景，不参与点击逻辑 */
.team-group-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  pointer-events: none;
  opacity: 0.75;
}

.team-group-bg--left {
  border-radius: 6rpx 0 0 6rpx;
}

.team-group-bg--right {
  border-radius: 0 6rpx 6rpx 0;
}

.team-group-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 60rpx;
  padding: 0 10rpx;
  overflow: hidden;
}

.team-name {
  flex: 1 1 0;
  min-width: 0;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

/* 队名在固定宽度区域内水平居中（WXS 已按 12 字截断，无省略号） */
.team-name--a,
.team-name--b {
  justify-content: center;
}

.team-name-inner {
  display: block;
  font-size: 11rpx;
  font-weight: 400;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
  box-sizing: border-box;
}

.team-name--a .team-name-inner,
.team-name--b .team-name-inner {
  text-align: center;
}

.score-value {
  font-size: 13rpx;
  font-weight: bold;
  flex: 0 0 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

/* 中间节次：与球队区相同，半高色条 + 全高热区 */
.period-center-outer {
  position: relative;
  flex: 0 0 auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 60rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.period-strip {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  background: rgba(34, 211, 238, 0.8);
  pointer-events: none;
  opacity: 0.75;
}

.period-text {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 10rpx;
  font-weight: bold;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

/* --- 自动记分模式优化 --- */
.period-center-outer--auto {
  min-width: 72rpx;
  min-height: 60rpx;
  padding: 0 4rpx;
}

.period-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 1;
  max-width: 100%;
  line-height: 1;
  gap: 1rpx;
}

.period-text--auto {
  font-size: 7rpx;
  line-height: 1.1;
  min-height: 0 !important;
  height: auto;
  padding: 0;
}

.period-time {
  font-size: 8rpx;
  font-weight: 600;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: 0;
}

/* 24 秒：右下角与记分栏同高正方格 */
.shot-clock-box {
  position: absolute;
  right: 2vw;
  bottom: calc(4rpx + env(safe-area-inset-bottom));
  width: 60rpx;
  height: 60rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.14);
  border-radius: 6rpx;
  z-index: 3;
  pointer-events: none;
}

.shot-clock-digit {
  font-size: 8rpx;
  font-weight: 600;
  line-height: 1;
  color: #ffffff;
  font-variant-numeric: tabular-nums;
}

.shot-clock-digit--warn {
  color: #ff4d4f;
  animation: shotClockPulse 0.5s infinite alternate;
}

.replay-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  background: #000;
}

/* 与 .live-stage 同逻辑：内联 liveStageInlineStyle 定宽高档位置；子级 100% 相对此框 */
.replay-stage {
  overflow: hidden;
  box-sizing: border-box;
  z-index: 1;
  pointer-events: auto;
}

/* 可拖拽缩放区域：在 16:9 replay-stage 内铺满，承载 movable-view */
.replay-movable-area {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
  overflow: hidden;
}

/* 可拖拽缩放视图：与 movable-area 等大，内部视频居中 */
.replay-movable-view {
  width: 100%;
  height: 100%;
  position: relative;
}

/*
 * 回放全屏悬停层：不挡 16:9 画面内手势；状态角标左上；工具列在右侧黑边（inline replayRailStyle）。
 */
.replay-chrome {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 102;
  pointer-events: none;
  box-sizing: border-box;
}

/* 纯状态指示：与左缘留白，避免贴边；非按钮 */
.replay-status-indicator {
  position: fixed;
  left: calc(24rpx + env(safe-area-inset-left));
  left: calc(24rpx + constant(safe-area-inset-left));
  top: calc(10rpx + env(safe-area-inset-top));
  top: calc(10rpx + constant(safe-area-inset-top));
  z-index: 103;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  height: 30rpx;
  padding: 0 12rpx;
  border-radius: 15rpx;
  background: rgba(0, 0, 0, 0.22);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  pointer-events: none;
  box-sizing: border-box;
}

.replay-status-indicator__dot {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background-color: #ff4d4f;
  box-shadow: 0 0 4rpx rgba(255, 77, 79, 0.65);
  animation: replayIndicatorBreath 1.6s ease-in-out infinite;
}

.replay-status-indicator__text {
  font-size: 12rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.72);
  letter-spacing: 0.2rpx;
  line-height: 1;
}

@keyframes replayIndicatorBreath {
  0% {
    transform: scale(0.92);
    opacity: 0.65;
  }
  50% {
    transform: scale(1.08);
    opacity: 1;
  }
  100% {
    transform: scale(0.92);
    opacity: 0.65;
  }
}

/* 右侧工具列：与 recover-fab-stack 共用 right；竖排每键独占一行，插入「还原」不挤压邻键 */
.replay-rail {
  position: fixed;
  z-index: 103;
  pointer-events: none;
}

/* 与 .recover-fab-stack 同宽（40rpx）、同间距，几何与 buildCornerFabStylesInLetterboxPx 中 fabR=40 一致，避免侵入 16:9 画面 */
.replay-rail__stack {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  width: 40rpx;
  min-width: 40rpx;
  pointer-events: auto;
  box-sizing: border-box;
}

/* 仅外环 + 居中字/标：去掉内盘视觉，字号可读 */
.replay-side-fab.recover-fab {
  opacity: 0.72;
  flex-shrink: 0;
}

.replay-side-fab .replay-side-fab-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(14, 18, 22, 0.42);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.12);
}

.replay-side-fab-label {
  font-size: 14rpx;
  font-weight: 600;
  letter-spacing: -0.2rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.9);
  text-align: center;
}

.replay-side-fab-label--dismiss {
  font-size: 16rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.replay-side-fab--active .recover-fab-ring.replay-side-fab-ring {
  background: rgba(255, 255, 255, 0.12);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.42);
}

.replay-side-fab--active .replay-side-fab-label {
  color: #ffffff;
}

.replay-side-fab-ring--icon .replay-icon {
  width: 18rpx;
  height: 18rpx;
  background-color: rgba(255, 255, 255, 0.78);
}

/* 回放操作小图标：使用 CSS mask 渲染 SVG，颜色跟随父级半透明白 */
.replay-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.5);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

/* 全屏还原图标（四角朝外箭头） */
.replay-icon--fitscreen {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

.replay-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 120;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.replay-mask-text {
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-shadow: 0 0 24rpx rgba(255,255,255,0.35);
  transform-origin: center center;
}

/* 进入回放：与 live.js introMs≈520ms 对齐，缩短全黑等待 */
.replay-mask--replay {
  background: rgba(0,0,0,1);
  animation: replayMaskMotion 0.52s both;
}

.replay-mask--replay .replay-mask-text {
  animation: replayBadgeMotion 0.52s both;
}

/* 回到直播：反向旋转收束，与 REPLAY 动效区分 */
.replay-mask--live .replay-mask-text {
  animation: liveBadgeMotion 680ms cubic-bezier(0.34, 1.2, 0.64, 1) both;
}

@keyframes replayMaskMotion {
  0% { opacity: 0; }
  35% { opacity: 1; } /* 0.35s / 1.0s = 35% */
  100% { opacity: 0; }
}

@keyframes replayBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(0.6) rotate(-10deg);
  }
  35% {
    opacity: 1;
    transform: scale(1.1) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: scale(1.3) rotate(5deg);
  }
}

@keyframes liveBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(1.4) rotate(10deg);
  }
  40% {
    opacity: 1;
    transform: scale(0.92) rotate(-6deg);
  }
  70% {
    opacity: 0.9;
    transform: scale(1.06) rotate(2deg);
  }
  100% {
    opacity: 0;
    transform: scale(0.75) rotate(-12deg);
  }
}

.drawer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 200;
  background: transparent;
  pointer-events: auto;
}

/* 抽屉顶部控制区容器 */
.drawer-top-controls {
  position: fixed;
  top: calc(16rpx + env(safe-area-inset-top));
  left: 50%;
  transform: translateX(-50%);
  z-index: 210;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  pointer-events: none; /* 让子元素响应事件 */
}

/* 抽屉顶部相机设置面板及影院模式面板公共基础 */
.drawer-camera-settings-panel {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 6rpx 12rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  pointer-events: auto;
}

.drawer-camera-pill {
  min-height: 36rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  font-size: 14rpx;
  font-weight: 500;
  line-height: 1.1;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  white-space: nowrap;
}

.drawer-camera-pill--focus {
  color: #86efac;
  background: rgba(9, 18, 14, 0.38);
  border-color: rgba(110, 231, 183, 0.35);
}

.drawer-camera-pill--active {
  color: #f8fafc;
  background: rgba(74, 222, 128, 0.32);
  border-color: rgba(74, 222, 128, 0.55);
}

/*
 * 左右抽屉列表缩略图：与 index 高光一致 280×180 比例（内容区宽约 148rpx → 单卡高约 95rpx）
 */
.drawer-list-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 280 / 180;
  min-height: 96rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.drawer-list-thumb:last-child {
  margin-bottom: 0;
}

/* 比赛卡片：在统一缩略图比例内排布文字 */
.lm-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.lm-card--current {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 抽屉内队名片段（字号独立，便于列表阅读） */
.lm-name {
  font-size: 16rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  text-align: center;
  line-height: 1.2;
}

.lm-vs {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 400;
  margin: 1rpx 0;
}

/* 高光视频缩略图：与 lm-card 完全一致的毛玻璃样式 */
.drawer-item {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: none;
}

/* 抽屉顶部统计条（左右抽屉共用） */
.clip-count-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rpx 10rpx 4rpx;
  pointer-events: none;
}

.clip-count-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* 片段序号角标（左上角，弱化） */
.clip-index-badge {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  font-size: 12rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.4;
  letter-spacing: 0.3rpx;
  pointer-events: none;
}

/* 右上：播放示意（与序号对称，呼吸间距一致） */
.clip-play-btn {
  position: absolute;
  top: 9rpx;
  right: 9rpx;
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
  pointer-events: none;
}

/* 正中：比分（无队名，球衣色 + 高对比描边） */
.clip-score-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  pointer-events: none;
}

.clip-score-digit {
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.6rpx;
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 1),
    0 0 6rpx rgba(0, 0, 0, 0.95),
    1rpx 1rpx 2rpx rgba(0, 0, 0, 1),
    -1rpx -1rpx 2rpx rgba(0, 0, 0, 1);
}

.clip-score-colon {
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 1),
    0 0 6rpx rgba(0, 0, 0, 0.95);
}

/* 左下：时间文字（呼吸间距一致） */
.clip-time-bl {
  position: absolute;
  left: 9rpx;
  bottom: 9rpx;
  font-size: 11rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.3;
  letter-spacing: 0.2rpx;
  pointer-events: none;
}

/* ══════════════════════════════════════════
   颜色设置浮层 — 极致透明、高通透感重构
══════════════════════════════════════════ */

/* 全屏遮罩 */
.color-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 300;
  background: rgba(0, 0, 0, 0.15);
  display: flex; 
  align-items: center;
  justify-content: center;
}

/* 浮层主体容器：width 85%，动态高度 */
.color-modal-container {
  width: 78%;
  max-width: 520rpx;
  background: rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(50rpx);
  -webkit-backdrop-filter: blur(50rpx);
  border-radius: 24rpx;
  padding: 20rpx 22rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

/* ── 队名卡片显示层 ── */
.cm-teams-header {
  width: 100%;
  min-height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2%;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* ── 缓存 Footer 区域：颜色选择器下方隔离区 ── */
.cm-cache-footer {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
}

/* 极细分割线，将 Footer 与颜色圆点视觉隔离 */
.cm-cache-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin-bottom: 12rpx;
}

/* 半透明深色容器：提示 + 操作成为一个功能区整体 */
.cm-cache-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.14);
  border-radius: 10rpx;
}

/* 弱化提示文案：白色 60% 透明度，12px 换算约 24rpx */
.cm-cache-text {
  flex: 1;
  font-size: 12rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
  min-width: 0;
}

/* 胶囊操作按钮：主题色青绿，无下划线 */
.cm-cache-btn {
  flex-shrink: 0;
  font-size: 12rpx;
  line-height: 1;
  color: #22d3ee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.35);
  background: rgba(34, 211, 238, 0.08);
  text-decoration: none;
  box-sizing: border-box;
}

/* 已清空状态：弱化显示，仅为确认反馈 */
.cm-cache-done {
  flex-shrink: 0;
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.35);
}

.cm-team-item {
  flex: 1;
  min-height: 44rpx;
  background: transparent;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx;
  min-width: 0;
  transition: all 0.3s;
}

/* 主队：队名在左，色块靠右贴近 VS */
.cm-team-item--left {
  justify-content: flex-end;
  flex-direction: row;
}

/* 客队：色块在左、队名在右 */
.cm-team-item--right {
  justify-content: flex-start;
  flex-direction: row;
}

.cm-team-item--active {
  border-width: 2rpx;
  animation: cmBreathing 2s ease-in-out infinite;
}

@keyframes cmBreathing {
  0% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
  50% { box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.6); opacity: 1; }
  100% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
}

/* 颜色浮层：队服色预览（默认纯色块；--jersey 为球衣剪影） */
.cm-color-swatch {
  flex-shrink: 0;
  width: 44rpx;
  height: 30rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.14);
  box-sizing: border-box;
}

/* 球衣剪影：无额外底框，颜色直接跟 colorModalMatch.team*.bgColor（mask 固定、fill 用背景色） */
.cm-color-swatch--jersey {
