}

.live-toolbar-icon--back {
  -webkit-mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
  mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
}


/* 双 slot 容器：绝对定位叠放，通过 z-index 切换前后层 */
.replay-slot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.replay-slot--active {
  z-index: 2;
}
.replay-slot--back {
  z-index: 1;
}

.replay-video-fullscreen {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: translate(-50%, -50%);
}

/* 竖屏录像在横屏回放时旋转 90 度铺满可视区域 */
.replay-video-fullscreen--rotated {
  width: 100%;
  height: 100%;
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ══ 操作指南弹窗（毛玻璃深色双列布局）══ */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 28rpx;
  padding-right: max(36rpx, constant(safe-area-inset-right));
  padding-right: max(36rpx, env(safe-area-inset-right));
  box-sizing: border-box;
  overflow: visible;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/*
 * 与卡片同宽的定位锚点：卡片在屏内水平居中，主按钮 absolute 挂在锚点右侧、靠近底边。
 */
.guide-sheet {
  position: relative;
  width: 86%;
  max-width: 760rpx;
  flex-shrink: 0;
  overflow: visible;
}

.guide-sheet--dy {
  width: 90%;
  max-width: 640rpx;
}

/* 主操作在卡片外：右侧、略低于卡片垂直中心，贴近右下角区域 */
.guide-outside-btn {
  position: absolute;
  z-index: 2;
  left: 100%;
  bottom: 20rpx;
  margin-left: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
  letter-spacing: 0.4rpx;
  color: rgba(240, 253, 244, 0.98);
  border: 1rpx solid rgba(74, 222, 128, 0.55);
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.52), rgba(22, 163, 74, 0.34));
  box-shadow:
    0 0 0 1rpx rgba(0, 0, 0, 0.12),
    0 10rpx 28rpx rgba(0, 0, 0, 0.38);
  white-space: nowrap;
  box-sizing: border-box;
}

/* 毛玻璃卡片，与场次矩形风格一致 */
.guide-card {
  width: 88%;
  max-width: 820rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/*
 * 快速上手第一步：高度参照取景 16:9 内接区（约 100vw×9/16），略收边距，避免铺满压抑；
 * 超出时可滚动，保留与预览区一致的「透气」边带。
 */
.guide-card--quick {
  width: 100%;
  max-height: min(82vh, calc(100vw * 9 / 16 * 0.92 + 96rpx));
  padding: 26rpx 22rpx 22rpx;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* 抖音画幅第二步：纵向分区 + 固定高度滚动区，长截图不撑破屏（底部栏已外置，滚动区加高） */
.guide-card--dy-frame {
  width: 100%;
  max-height: min(92vh, calc(100vw * 9 / 16 + 220rpx));
  padding: 24rpx 22rpx 16rpx;
  min-height: 0;
}

.guide-title-bar--dy {
  margin-bottom: 14rpx;
}

.guide-dy-scroll {
  flex: 1;
  min-height: 0;
  max-height: min(62vh, calc(100vw * 9 / 16 - 8rpx));
  height: min(62vh, calc(100vw * 9 / 16 - 8rpx));
  margin-bottom: 0;
  box-sizing: border-box;
}

.guide-dy-callout {
  padding: 14rpx 16rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  background: rgba(230, 67, 64, 0.14);
  border: 1rpx solid rgba(248, 113, 113, 0.35);
  box-sizing: border-box;
}

.guide-dy-callout__title {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(254, 226, 226, 0.98);
  line-height: 1.45;
  margin-bottom: 8rpx;
}

.guide-dy-callout__sub {
  display: block;
  font-size: 15rpx;
  color: rgba(254, 202, 202, 0.82);
  line-height: 1.5;
}

.guide-dy-step {
  margin-bottom: 20rpx;
}

.guide-dy-step--last {
  margin-bottom: 8rpx;
}

.guide-dy-step__label {
  display: block;
  font-size: 17rpx;
  font-weight: 700;
  color: #4ade80;
  margin-bottom: 6rpx;
  letter-spacing: 0.3rpx;
}

.guide-dy-step__path {
  display: block;
  font-size: 15rpx;
  color: rgba(255, 255, 255, 0.72);
  line-height: 1.5;
  margin-bottom: 10rpx;
}

.guide-dy-shot {
  display: block;
  width: 100%;
  border-radius: 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  background: rgba(0, 0, 0, 0.2);
  vertical-align: top;
}

/* 主操作：与绿色能力提示同系，区别于描边「关闭」 */
.guide-close--primary {
  border: 1rpx solid rgba(74, 222, 128, 0.45);
  background: linear-gradient(135deg, rgba(74, 222, 128, 0.38), rgba(22, 163, 74, 0.22));
  color: rgba(240, 253, 244, 0.98);
  font-weight: 600;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.28);
}

/* 标题区域 */
.guide-title-bar {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-main-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
}

/* 双列容器 */
.guide-columns {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
}

.guide-col {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

/* 竖向分隔线 */
.guide-divider-v {
  width: 1rpx;
  align-self: stretch;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

/* 分区标题行 */
.guide-section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.guide-section-emoji {
  font-size: 20rpx;
  line-height: 1;
}

.guide-section-title {
  font-size: 19rpx;
  font-weight: 700;
  color: #4ade80;
  letter-spacing: 0.5rpx;
}

/* 操作条目行 */
.guide-item {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 8rpx;
  line-height: 1.6;
}

/* 全宽跨列条目 */
.guide-item-full {
  margin-top: 0;
  padding: 0 4rpx;
}

.guide-action {
  font-size: 17rpx;
  font-weight: 600;
  color: #fbbf24;
  white-space: nowrap;
  flex-shrink: 0;
}

.guide-sep {
  font-size: 15rpx;
  color: rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
  margin: 0 4rpx;
}

.guide-desc {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.72);
  flex: 1;
  line-height: 1.6;
}

/* 全宽分隔线（列区与补充项之间） */
.guide-full-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 16rpx 0 12rpx;
}

/* 底部关闭按钮（居中，仅文字 + 边框） */
.guide-close-bar {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.guide-close {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 36rpx;
  border-radius: 23rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
}

/* 兼容旧 class，避免残留节点可见 */
.guide-key, .guide-title, .guide-btn-container, .guide-confirm-btn {
  display: none;
}

/* 横屏适配 */
@media screen and (orientation: landscape) {
  .guide-overlay {
    padding: 20rpx 32rpx;
    padding-right: max(40rpx, constant(safe-area-inset-right));
    padding-right: max(40rpx, env(safe-area-inset-right));
  }

  .guide-sheet {
    width: 70%;
    max-width: 800rpx;
  }

  .guide-sheet--dy {
    width: 58%;
    max-width: 720rpx;
  }

  .guide-outside-btn {
    bottom: 16rpx;
    margin-left: 14rpx;
    min-height: 42rpx;
    padding: 0 20rpx;
    font-size: 18rpx;
  }

  .guide-card {
    width: 72%;
    max-width: 860rpx;
    padding: 24rpx 24rpx 18rpx;
  }

  /* 引导卡片在 .guide-sheet 内铺满宽度，勿沿用横屏 .guide-card 的 72% */
  .guide-card.guide-card--quick,
  .guide-card.guide-card--dy-frame {
    width: 100%;
  }

  .guide-card--quick {
    max-height: min(80vh, calc(100vw * 9 / 16 * 0.9 + 72rpx));
    padding: 20rpx 20rpx 18rpx;
  }

  .guide-card--dy-frame {
    max-height: min(90vh, calc(100vw * 9 / 16 + 180rpx));
    padding: 18rpx 18rpx 12rpx;
  }

  .guide-dy-scroll {
    max-height: min(56vh, calc(100vw * 9 / 16 - 12rpx));
    height: min(56vh, calc(100vw * 9 / 16 - 12rpx));
  }

  .guide-dy-callout__title {
    font-size: 16rpx;
  }

  .guide-dy-callout__sub {
    font-size: 14rpx;
  }

  .guide-dy-step__label {
    font-size: 16rpx;
  }

  .guide-dy-step__path {
    font-size: 14rpx;
  }

  .guide-main-title {
    font-size: 24rpx;
  }

  .guide-title-bar {
    margin-bottom: 16rpx;
  }

  .guide-col {
    padding: 0 12rpx;
  }

  .guide-section-title {
    font-size: 17rpx;
  }

  .guide-action, .guide-desc {
    font-size: 15rpx;
  }

  .guide-item {
    margin-bottom: 6rpx;
  }

  .guide-full-divider {
    margin: 12rpx 0 10rpx;
  }

  .guide-close-bar {
    margin-top: 14rpx;
  }

  .guide-close {
    height: 40rpx;
    font-size: 18rpx;
    padding: 0 28rpx;
  }

  .light-hint__text {
    font-size: 20rpx;
  }
}

/* ══════════════════════════════════════════
   管理抽屉
   z-index: backdrop 195 / left-drawer 200 / drawer-panel 201 / back-btn 210
   color-modal 300
══════════════════════════════════════════ */

/* 遮罩（低于两侧面板） */
.drawer-mode-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 195;
  background: rgba(0, 0, 0, 0.08);
}

/* ── 左侧比赛列表抽屉 ── */
.left-drawer {
  position: fixed;
  top: 50%;
  left: 0;
  width: 168rpx;
  max-height: 48vh;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

/*
 * 可视高度 ≈ 1.8×单卡高度（单卡≈148×180/280≈95rpx），略小于两卡+间距，保证 2 条时可滚动
 */
.match-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.left-drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 右侧高光列表抽屉 ── */
.drawer-panel {
  position: fixed;
  top: 50%;
  right: 0;
  width: 168rpx;
  max-height: 52vh;
  z-index: 201;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.clip-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 24色无滚动矩阵：12列 x 2行 ── */
.cm-matrix-palette {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 1.4%;
  row-gap: 10rpx;
  margin: 12rpx 0 0;
  padding: 0 2rpx;
  box-sizing: border-box;
  justify-items: center;
  align-items: center;
}

.cm-matrix-ball {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
}

.cm-matrix-ball--active {
  transform: scale(1.28);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.85);
  z-index: 2;
  border-color: rgba(255, 255, 255, 0.5);
}

/* ── 操作行 ── */
.cm-action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
  padding-top: 4rpx;
}

/* 切换按钮：添加圆角并适配比例 */
.cm-btn-switch {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(0, 122, 255, 0.75);
  border-radius: 12rpx; /* 调整圆角与浮层弧度一致 */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
}

.cm-btn-switch--disabled {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(16, 185, 129, 0.75); /* 改为绿色 */
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
  opacity: 1;
}

/* ── 权益续杯全屏层（高于 guide-overlay 500） ── */
.vip-gate-root {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 540;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.vip-gate-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 120% 80% at 50% 20%, rgba(37, 99, 235, 0.35), transparent 55%),
    radial-gradient(ellipse 90% 70% at 80% 70%, rgba(16, 174, 255, 0.22), transparent 50%),
    linear-gradient(165deg, #0b1220 0%, #030712 48%, #0f172a 100%);
  filter: saturate(1.08);
}

.vip-gate-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(18px);
}

.vip-gate-card {
  position: relative;
  z-index: 1;
  width: 88%;
  max-width: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(30, 31, 35, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(22rpx);
}

.vip-gate-kicker {
  font-size: 18rpx;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 16rpx;
  line-height: 1.25;
}

.vip-gate-sub {
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(226, 232, 240, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-minor {
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 28rpx;
}

.vip-gate-share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0;
  margin: 0 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(120deg, #2563eb 0%, #0ea5e9 55%, #22d3ee 100%);
  box-shadow: 0 12rpx 36rpx rgba(37, 99, 235, 0.35);
}

.vip-gate-share-btn::after {
  border: none;
}

.vip-gate-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.vip-gate-link {
  font-size: 22rpx;
  color: #5c9cf2;
  padding: 8rpx 4rpx;
}

.vip-gate-link--sep {
  color: #4a6fa8;
  padding: 8rpx 0;
}

@media screen and (orientation: landscape) {
  .vip-gate-root {
    padding: 18rpx 40rpx;
  }

  .vip-gate-card {
    width: 62%;
    max-width: 700rpx;
    min-width: 500rpx;
    padding: 24rpx 26rpx 18rpx;
    border-radius: 20rpx;
  }

  .vip-gate-kicker {
    font-size: 14rpx;
    margin-bottom: 8rpx;
  }

  .vip-gate-title {
    font-size: 28rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-sub {
    font-size: 20rpx;
    line-height: 1.45;
    margin-bottom: 8rpx;
  }

  .vip-gate-minor {
    font-size: 17rpx;
    line-height: 1.4;
    margin-bottom: 14rpx;
  }

  .vip-gate-share-btn {
    height: 72rpx;
    line-height: 72rpx;
    font-size: 24rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-row {
    justify-content: center;
    gap: 12rpx;
  }

  .vip-gate-link {
    font-size: 19rpx;
    padding: 4rpx 2rpx;
  }
}

/* ══ 共用 AF/AE（与回放徽标、毛玻璃条风格统一） */
.focus-ui-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 6;
  pointer-events: none;
  overflow: hidden;
}

/*
 * 对焦：仅方框+提示为簇，曝光条吸屏右；长按空白区仍由下层 gesture 接收。
 */
.ae-af-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.ae-focus-cluster {
  position: absolute;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}

.ae-focus-cluster--center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  align-items: center;
}

.ae-focus-bracket {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border: 2rpx solid rgba(74, 222, 128, 0.92);
  background: rgba(0, 0, 0, 0.04);
  border-radius: 3rpx;
  pointer-events: auto;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.2);
}

.ae-double-tap-hint {
  margin-top: 6rpx;
  max-width: 220rpx;
  font-size: 12rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.85);
  font-weight: 500;
  pointer-events: none;
}

/* 对焦点位成功：短时扩散高亮；无 transform，避免与 .ae-focus-cluster--center 的 translate 争用 */
.ae-focus-cluster--flash .ae-focus-bracket {
  animation: aeBracketLockRipple 0.55s ease-out;
}

@keyframes aeBracketLockRipple {
  0% {
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55);
  }
  100% {
    box-shadow: 0 0 0 18rpx rgba(74, 222, 128, 0);
  }
}

/* 吸右侧的竖向曝光区：加高滑轨；无大圆角底，仅小 padding 增触区 */
.ae-sun-rail--dock-right {
  position: absolute;
  right: 2%;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 8rpx 12rpx;
  width: 104rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.ae-sun-rail--dock-right .ae-sun-track {
  position: relative;
  width: 5rpx;
  height: 220rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(187, 247, 208, 0.75) 0%, rgba(34, 197, 94, 0.2) 100%);
}

.ae-sun-thumb {
  position: absolute;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  margin-top: -10rpx;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6rpx rgba(74, 222, 128, 0.75);
}

.ae-sun-glyph {
  font-size: 22rpx;
  line-height: 1;
  color: #86efac;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
  pointer-events: none;
  flex-shrink: 0;
}

/* 录制中关闭状态钮 ACK 动画，减少 setData/合成与编码同屏争用 */
.container--rec-performance .recover-fab--ack .recover-fab-ring {
  animation: none;
}

@media screen and (orientation: landscape) {
  .ae-sun-rail--dock-right .ae-sun-track {
    height: 260rpx;
  }
  .ae-sun-rail--dock-right {
    right: 1.5%;
  }
}

/* ===== Enhance render canvas =====
 * WebGL 锐化画布：全屏覆盖在 <camera> 之上；指针事件透传给 .gesture-layer
 * 仅在 render-pipeline 启动成功后由 data.enhanceCanvasVisible 触发进入视图树。
 */
/* 全屏时 WebGL 画布（无 .live-stage 时回退，当前直播页用 .live-stage 子级规则） */
.enhance-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
  background: transparent;
}

/* 开启增强时 <camera> 只承担 onCameraFrame 吐帧，视觉上被 canvas 替代。
   微信原生层级在部分机型（尤其 iOS）对 z-index 不敏感，直接把 camera
   视觉上近乎透明，强制让 canvas 成为用户眼中的预览层；
   opacity 不能是 0（部分基础库会把"完全不可见"的 camera 判死，停止 onCameraFrame）。 */
.camera-bg--under-enhance {
  opacity: 0.01;
}

/* ===== Enhance render debug toolbar =====
 * 抽屉（drawerMode===1）顶部常驻胶囊条；展示当前档位 + FPS，提供 3 档切换。
 * 仅在机型通过白名单（enhanceWhitelisted）时进入视图树。
 */
.enhance-mode-toolbar {
  position: fixed;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 220;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 5rpx 8rpx 5rpx 10rpx;
  background: rgba(18, 20, 26, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  pointer-events: auto;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.28);
  max-width: 96vw;
  box-sizing: border-box;
}
.enhance-mode-status {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
  padding: 0 2rpx 0 4rpx;
  min-width: 0;
  max-width: 38vw;
}
.enhance-mode-k {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.5rpx;
}
.enhance-mode-v {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  /* FPS 数字等宽对齐，跳动时不抖 */
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.enhance-mode-group {
  display: flex;
  flex-wrap: nowrap;
  gap: 2rpx;
  padding: 1rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 999rpx;
  flex-shrink: 0;
}
.enhance-mode-btn {
  font-size: 16rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.62);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}
.enhance-mode-btn--active {
  color: #fff;
  background: linear-gradient(135deg, #2563EB, #7C3AED);
  box-shadow: 0 2rpx 10rpx rgba(99, 102, 241, 0.38);
}

/* VK 模式按钮：独立家族，用橙红色调以视觉区隔，暗示"破坏性动作"（会暂停精彩回放）。 */
.enhance-mode-btn--vk {
  color: #fca5a5;
  border: 1rpx solid rgba(239, 68, 68, 0.38);
}
.enhance-mode-btn--vk.enhance-mode-btn--active {
  color: #fff;
  background: linear-gradient(135deg, #E64340, #F97316);
  box-shadow: 0 2rpx 10rpx rgba(230, 67, 64, 0.45);
  border-color: transparent;
}

/* 切换中的 toolbar：禁用点击 + 降低透明度，防止 orchestrator 执行期间用户连点乱序 */
.enhance-mode-toolbar--transitioning {
  opacity: 0.55;
  pointer-events: none;
}

