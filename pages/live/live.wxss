page {
  width: 100vw;
  height: 100vh;
  background-color: #000000 !important;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

.container {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background: #000000;
  overflow: hidden;
  margin: 0;
  padding: 0;
  /* 使用更加正式的系统字体组合，移除全局可能的加粗 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

.camera-bg {
  width: 110vw;
  height: 110vh;
  position: fixed;
  top: -5vh;
  left: -5vw;
  object-fit: cover;
  background-color: #000000;
  z-index: 0;
}

/* 专门针对安卓曲面屏/白边的全屏溢出覆盖 (已废弃，改为全局物理溢出) */

.overlay {
  width: 100%;
  height: calc(100% + env(safe-area-inset-bottom));
  height: calc(100% + constant(safe-area-inset-bottom));
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  pointer-events: none;
}

/* 常驻状态钮：更小、更通透，内盘显示 OK / REC / ↻ */
.recover-fab {
  position: absolute;
  right: 10rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  z-index: 24;
  width: 40rpx;
  height: 40rpx;
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  opacity: 0.62;
}

.recover-fab-ring {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.recover-fab-progress {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.recover-fab-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  margin-top: -15rpx;
  border-radius: 50%;
  background: rgba(10, 12, 16, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.recover-fab-text {
  font-size: 10rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
}

.recover-fab--ok .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(95, 217, 95, 0.28);
}

.recover-fab--recording .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(70, 190, 255, 0.32);
}

.recover-fab--recovering .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 208, 74, 0.35);
}

.recover-fab--warn .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 114, 114, 0.32);
}

.recover-fab--actionable .recover-fab-inner {
  background: rgba(52, 18, 18, 0.48);
}

.recover-fab--busy {
  opacity: 0.78;
}

.recover-fab--recording.recover-fab {
  opacity: 0.72;
}

.recover-fab--ack .recover-fab-ring {
  animation: recoverFabAckFlash 0.75s ease-out;
}

@keyframes recoverFabAckFlash {
  0% {
    box-shadow: 0 0 0 0 rgba(95, 217, 95, 0.45);
  }
  100% {
    box-shadow: 0 0 0 10rpx rgba(95, 217, 95, 0);
  }
}

/* 透明手势层 */
.gesture-layer {
  position: absolute;
  top: -5vh;
  left: -5vw;
  width: 110vw;
  height: 110vh;
  z-index: 5; /* 位于相机之上，UI 之下 */
}

/* 底部居中计分板 */
.bottom-center-board {
  position: absolute;
  bottom: calc(4rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  width: 96vw;
  gap: 0;
}

.match-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  /* 下压进入透明热区，但与色块保留约 2rpx 间距 */
  margin-bottom: -13rpx;
  transform: translateY(0);
  position: relative;
  z-index: 2;
  pointer-events: none;
}

.match-name-banner {
  font-size: 12rpx;
  line-height: 14rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  padding: 0 10rpx;
  opacity: 0.9;
  flex: 1;
  text-align: center;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
  pointer-events: none;
}

/* 计分条：色带视觉高度约 30rpx（约为原先 60rpx 的 50%），整行仍保留约 60rpx 操作热区 */
.main-score-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 60rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
  padding: 0;
  box-sizing: border-box;
}

/* 球队组：宽度固定为 12 字占位 + 边距（JS），勿依赖 flex 自动分配以免拉满半屏 */
.team-group {
  position: relative;
  display: block;
  flex: 0 0 auto;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 60rpx;
  overflow: visible;
}

/* 半高色条：仅负责背景，不参与点击逻辑 */
.team-group-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  pointer-events: none;
  opacity: 0.75;
}

.team-group-bg--left {
  border-top-left-radius: 10rpx;
  border-bottom-left-radius: 10rpx;
}

.team-group-bg--right {
  border-top-right-radius: 10rpx;
  border-bottom-right-radius: 10rpx;
}

.team-group-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 60rpx;
  padding: 0 10rpx;
  overflow: hidden;
}

.team-name {
  flex: 1 1 0;
  min-width: 0;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

/* 队名在固定宽度区域内水平居中（WXS 已按 12 字截断，无省略号） */
.team-name--a,
.team-name--b {
  justify-content: center;
}

.team-name-inner {
  display: block;
  font-size: 11rpx;
  font-weight: 400;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
  box-sizing: border-box;
}

.team-name--a .team-name-inner,
.team-name--b .team-name-inner {
  text-align: center;
}

.score-value {
  font-size: 13rpx;
  font-weight: bold;
  flex: 0 0 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

/* 中间节次：与球队区相同，半高色条 + 全高热区 */
.period-center-outer {
  position: relative;
  flex: 0 0 auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 60rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.period-strip {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  background: rgba(34, 211, 238, 0.8);
  pointer-events: none;
  opacity: 0.75;
}

.period-text {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 10rpx;
  font-weight: bold;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.replay-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  background: #000;
}

/* 可拖拽缩放区域：全屏铺满，承载 movable-view */
.replay-movable-area {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

/* 可拖拽缩放视图：与 movable-area 等大，内部视频居中 */
.replay-movable-view {
  width: 100vw;
  height: 100vh;
  position: relative;
}

/* 独立控制层：整体 pointer-events:none，手势穿透到 movable-view */
.replay-control-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  box-sizing: border-box;
  pointer-events: none;
}

/* 回放顶部控制行：绝对定位在左上角，横排排列徽标与倍速按钮 */
.replay-top-bar {
  position: absolute;
  left: calc(16rpx + env(safe-area-inset-left));
  left: calc(16rpx + constant(safe-area-inset-left));
  top: calc(10rpx + env(safe-area-inset-top));
  top: calc(10rpx + constant(safe-area-inset-top));
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}

/* 实时回看提示徽标：精致胶囊样式 */
.replay-hint-badge {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.2); 
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

/* 倍速按钮组 */
.replay-speed-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  pointer-events: auto;
}

/* 单个倍速按钮：默认半透明胶囊 */
.replay-speed-btn {
  height: 42rpx;
  min-width: 64rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 当前激活倍速：高亮白色 */
.replay-speed-btn--active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.45);
}

.replay-hint-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  margin-right: 10rpx;
  box-shadow: 0 0 6rpx #ff4d4f;
  animation: breathing 1.5s ease-in-out infinite;
}

@keyframes breathing {
  0% {
    transform: scale(0.9);
    opacity: 0.6;
    box-shadow: 0 0 2rpx #ff4d4f;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
    box-shadow: 0 0 12rpx #ff4d4f;
  }
  100% {
    transform: scale(0.9);
    opacity: 0.6;
    box-shadow: 0 0 2rpx #ff4d4f;
  }
}

.replay-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 120;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.replay-mask-text {
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-shadow: 0 0 24rpx rgba(255,255,255,0.35);
  transform-origin: center center;
}

/* 进入回放：1.0s 快进慢出逻辑 */
.replay-mask--replay {
  background: rgba(0,0,0,1);
  animation: replayMaskMotion 1s both;
}

.replay-mask--replay .replay-mask-text {
  animation: replayBadgeMotion 1s both;
}

/* 回到直播：反向旋转收束，与 REPLAY 动效区分 */
.replay-mask--live .replay-mask-text {
  animation: liveBadgeMotion 680ms cubic-bezier(0.34, 1.2, 0.64, 1) both;
}

@keyframes replayMaskMotion {
  0% { opacity: 0; }
  35% { opacity: 1; } /* 0.35s / 1.0s = 35% */
  100% { opacity: 0; }
}

@keyframes replayBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(0.6) rotate(-10deg);
  }
  35% {
    opacity: 1;
    transform: scale(1.1) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: scale(1.3) rotate(5deg);
  }
}

@keyframes liveBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(1.4) rotate(10deg);
  }
  40% {
    opacity: 1;
    transform: scale(0.92) rotate(-6deg);
  }
  70% {
    opacity: 0.9;
    transform: scale(1.06) rotate(2deg);
  }
  100% {
    opacity: 0;
    transform: scale(0.75) rotate(-12deg);
  }
}

.drawer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 200;
  background: transparent;
  pointer-events: auto;
}

/*
 * 左右抽屉列表缩略图：与 index 高光一致 280×180 比例（内容区宽约 148rpx → 单卡高约 95rpx）
 */
.drawer-list-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 280 / 180;
  min-height: 96rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.drawer-list-thumb:last-child {
  margin-bottom: 0;
}

/* 比赛卡片：在统一缩略图比例内排布文字 */
.lm-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.lm-card--current {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 抽屉内队名片段（字号独立，便于列表阅读） */
.lm-name {
  font-size: 16rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  text-align: center;
  line-height: 1.2;
}

.lm-vs {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 400;
  margin: 1rpx 0;
}

/* 高光视频缩略图：与 .drawer-list-thumb 同外框，叠层封面 */
.drawer-item {
  background: rgba(0, 0, 0, 0.25);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* ══════════════════════════════════════════
   颜色设置浮层 — 极致透明、高通透感重构
══════════════════════════════════════════ */

/* 全屏遮罩 */
.color-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 300;
  background: rgba(0, 0, 0, 0.15);
  display: flex; 
  align-items: center;
  justify-content: center;
}

/* 浮层主体容器：width 85%，动态高度 */
.color-modal-container {
  width: 85%;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(50rpx);
  -webkit-backdrop-filter: blur(50rpx);
  border-radius: 40rpx;
  padding: 4%; /* 动态撑开 */
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
}

/* ── 队名卡片显示层 ── */
.cm-teams-header {
  width: 100%;
  min-height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2%;
}

.cm-team-item {
  flex: 1;
  min-height: 56rpx;
  background: transparent;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx;
  min-width: 0;
  transition: all 0.3s;
}

/* 主队：队名在左，色块靠右贴近 VS */
.cm-team-item--left {
  justify-content: flex-end;
  flex-direction: row;
}

/* 客队：色块在左、队名在右 */
.cm-team-item--right {
  justify-content: flex-start;
  flex-direction: row;
}

.cm-team-item--active {
  border-width: 2rpx;
  animation: cmBreathing 2s ease-in-out infinite;
}

@keyframes cmBreathing {
  0% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
  50% { box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.6); opacity: 1; }
  100% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
}

/* 颜色浮层：队服色预览（纯色圆角矩形） */
.cm-color-swatch {
  flex-shrink: 0;
  width: 44rpx;
  height: 30rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.14);
  box-sizing: border-box;
}

.cm-color-swatch--left {
  margin-left: 8rpx;
  margin-right: 0;
}

.cm-color-swatch--right {
  margin-right: 10rpx;
  margin-left: 0;
}

.cm-team-name {
  font-size: 16rpx;
  font-weight: bold;
  color: #000000;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.cm-team-name--left {
  text-align: right;
  margin-right: 4rpx;
}

.cm-team-name--right {
  text-align: left;
  margin-left: 4rpx;
}

.cm-vs-divider {
  font-size: 16rpx; /* 与队名同大 */
  font-weight: bold;
  color: #000000; /* 固定黑色 */
  margin: 0 12rpx;
}



.drawer-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: transparent;
  pointer-events: none;
}

.drawer-back-btn {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 210;
  width: 46rpx;
  height: 46rpx;
  border-radius: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.14);
  border: 1px solid rgba(255,255,255,0.10);
  backdrop-filter: blur(8px);
  pointer-events: auto;
  opacity: 0.55;
}

/* 全局矢量图标容器：46rpx，mask 居中不拉伸 */
.live-toolbar-icon {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.92);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.live-toolbar-icon--back {
  -webkit-mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
  mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
}


.replay-video-fullscreen {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100vw;
  height: 100vh;
  object-fit: contain;
  transform: translate(-50%, -50%);
}

/* 竖屏录像在横屏回放时旋转 90 度铺满可视区域 */
.replay-video-fullscreen--rotated {
  width: 100vh;
  height: 100vw;
  transform: translate(-50%, -50%) rotate(90deg);
}

/* 操作指南弹窗 (专业导播风格) */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 500;
  background: rgba(0, 0, 0, 0.7); /* 透明度调到 70 */
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10px);
}

.guide-card {
  width: 85%;
  max-height: 80vh;
  background: rgba(30, 31, 35, 0.85);
  border-radius: 24rpx;
  padding: 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  border: 1px solid rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20rpx);
  position: relative;
  padding-left: calc(32rpx + env(safe-area-inset-left));
  padding-right: calc(32rpx + env(safe-area-inset-right));
}

.guide-close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  z-index: 10;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  line-height: 1;
  color: #F5F5F7;
}

.guide-scroll {
  flex: 1;
  max-height: 70vh;
}

.guide-list {
  display: flex;
  flex-direction: column;
  padding-top: 10rpx;
}

.guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  line-height: 1.8;
}

.guide-key {
  font-size: 22rpx;
  font-weight: bold;
  color: #5C9CF2;
  white-space: nowrap;
}

.guide-desc {
  font-size: 20rpx;
  color: #F5F5F7;
  flex: 1;
}

/* 移除不再需要的旧样式 */
.guide-title, .guide-btn-container, .guide-confirm-btn {
  display: none;
}

/* ══════════════════════════════════════════
   管理抽屉
   z-index: backdrop 195 / left-drawer 200 / drawer-panel 201 / back-btn 210
   color-modal 300
══════════════════════════════════════════ */

/* 遮罩（低于两侧面板） */
.drawer-mode-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 195;
  background: rgba(0, 0, 0, 0.08);
}

/* ── 左侧比赛列表抽屉 ── */
.left-drawer {
  position: fixed;
  top: 50%;
  left: 0;
  width: 168rpx;
  max-height: 48vh;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

/*
 * 可视高度 ≈ 1.8×单卡高度（单卡≈148×180/280≈95rpx），略小于两卡+间距，保证 2 条时可滚动
 */
.match-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.left-drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 右侧高光列表抽屉 ── */
.drawer-panel {
  position: fixed;
  top: 50%;
  right: 0;
  width: 168rpx;
  max-height: 48vh;
  z-index: 201;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.clip-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 24色无滚动矩阵：12列 x 2行 ── */
.cm-matrix-palette {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 1.5%;
  row-gap: 12rpx; /* 添加垂直间距，防止误触 */
  margin-top: 5%; /* 布局间距 */
  justify-items: center;
  align-items: center;
}

.cm-matrix-ball {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
}

.cm-matrix-ball--active {
  transform: scale(1.28);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.85);
  z-index: 2;
  border-color: rgba(255, 255, 255, 0.5);
}

/* ── 操作行 ── */
.cm-action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 5%; /* 布局间距 */
}

/* 切换按钮：添加圆角并适配比例 */
.cm-btn-switch {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(0, 122, 255, 0.75);
  border-radius: 12rpx; /* 调整圆角与浮层弧度一致 */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
}

.cm-btn-switch--disabled {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(16, 185, 129, 0.75); /* 改为绿色 */
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
  opacity: 1;
}

/* ── 权益续杯全屏层（高于 guide-overlay 500） ── */
.vip-gate-root {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 540;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.vip-gate-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 120% 80% at 50% 20%, rgba(37, 99, 235, 0.35), transparent 55%),
    radial-gradient(ellipse 90% 70% at 80% 70%, rgba(16, 174, 255, 0.22), transparent 50%),
    linear-gradient(165deg, #0b1220 0%, #030712 48%, #0f172a 100%);
  filter: saturate(1.08);
}

.vip-gate-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(18px);
}

.vip-gate-card {
  position: relative;
  z-index: 1;
  width: 88%;
  max-width: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(30, 31, 35, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(22rpx);
}

.vip-gate-kicker {
  font-size: 18rpx;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 16rpx;
  line-height: 1.25;
}

.vip-gate-sub {
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(226, 232, 240, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-minor {
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 28rpx;
}

.vip-gate-share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0;
  margin: 0 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(120deg, #2563eb 0%, #0ea5e9 55%, #22d3ee 100%);
  box-shadow: 0 12rpx 36rpx rgba(37, 99, 235, 0.35);
}

.vip-gate-share-btn::after {
  border: none;
}

.vip-gate-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.vip-gate-link {
  font-size: 22rpx;
  color: #5c9cf2;
  padding: 8rpx 4rpx;
}

.vip-gate-link--sep {
  color: #4a6fa8;
  padding: 8rpx 0;
}

@media screen and (orientation: landscape) {
  .vip-gate-root {
    padding: 18rpx 40rpx;
  }

  .vip-gate-card {
    width: 62%;
    max-width: 700rpx;
    min-width: 500rpx;
    padding: 24rpx 26rpx 18rpx;
    border-radius: 20rpx;
  }

  .vip-gate-kicker {
    font-size: 14rpx;
    margin-bottom: 8rpx;
  }

  .vip-gate-title {
    font-size: 28rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-sub {
    font-size: 20rpx;
    line-height: 1.45;
    margin-bottom: 8rpx;
  }

  .vip-gate-minor {
    font-size: 17rpx;
    line-height: 1.4;
    margin-bottom: 14rpx;
  }

  .vip-gate-share-btn {
    height: 72rpx;
    line-height: 72rpx;
    font-size: 24rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-row {
    justify-content: center;
    gap: 12rpx;
  }

  .vip-gate-link {
    font-size: 19rpx;
    padding: 4rpx 2rpx;
  }
}
