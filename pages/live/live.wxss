  border: none;
  border-radius: 0;
}

.cm-color-swatch__jersey-fill {
  width: 30rpx;
  height: 30rpx;
  background-color: #221f20;
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.cm-color-swatch--left {
  margin-left: 8rpx;
  margin-right: 0;
}

.cm-color-swatch--right {
  margin-right: 10rpx;
  margin-left: 0;
}

.cm-team-name {
  font-size: 16rpx;
  font-weight: bold;
  color: #000000;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.cm-team-name--left {
  text-align: right;
  margin-right: 4rpx;
}

.cm-team-name--right {
  text-align: left;
  margin-left: 4rpx;
}

.cm-vs-divider {
