/* ========== 严重存储：对齐系统 wx.showModal（与 VK 确认框同系；宽度用 px 封顶，横屏不致 80vw 铺满） ========== */
.storage-pressure-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  box-sizing: border-box;
}
.storage-pressure-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.storage-pressure-panel {
  position: relative;
  z-index: 1;
  align-self: center;
  width: 86%;
  max-width: 300px;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
}
.storage-pressure-title {
  font-size: 17px;
  font-weight: 700;
  color: #000;
  text-align: center;
  padding: 22px 18px 8px;
  line-height: 1.35;
}
.storage-pressure-text {
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 1.45;
  color: #666;
  text-align: center;
  padding: 0 18px 18px;
  max-height: 38vh;
  overflow-y: auto;
  word-break: break-word;
  overflow-wrap: break-word;
  white-space: normal;
}
.storage-pressure-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.storage-pressure-btn {
  flex: 1 1 0;
  width: 0;
  min-height: 44px;
  padding: 10px 6px;
  text-align: center;
  font-size: 17px;
  border-radius: 0;
  background: #fff;
  line-height: 1.3;
  white-space: nowrap;
  box-sizing: border-box;
}
.storage-pressure-btn--secondary {
  color: #000;
  border-right: 1rpx solid rgba(0, 0, 0, 0.08);
}
.storage-pressure-btn--primary {
  color: #e64340;
  font-weight: 600;
}

/* 高级加载动效：正在定位高光时刻 */
.replay-premium-loader {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.replay-loader-ring {
  position: absolute;
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.1);
  border-top-color: #ffffff;
  animation: replayLoaderSpin 1.2s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}

.replay-loader-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #ffffff;
  border-radius: 50%;
  box-shadow: 0 0 15rpx rgba(255, 255, 255, 0.8);
  animation: replayDotPulse 1.5s ease-in-out infinite;
}

@keyframes replayLoaderSpin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes replayDotPulse {
  0%, 100% { transform: scale(0.8); opacity: 0.5; }
  50% { transform: scale(1.2); opacity: 1; }
}

@keyframes replayTextPulse {
  from { opacity: 0.4; transform: scale(0.98); }
  to { opacity: 0.9; transform: scale(1); }
}

/* --- 自动模式状态框 (BLE Sync) --- */
.auto-mode-status-box--inline {
  margin-top: 4rpx;
  transform: scale(0.72);
  transform-origin: center top;
}

.wxs-clock-driver {
  width: 0;
  height: 0;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.auto-mode-status-box {
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
  padding: 8rpx 20rpx;
  margin-left: 16rpx;
  height: 64rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.4);
}

.auto-mode-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 80rpx;
}

.auto-mode-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.5);
  font-weight: 600;
  letter-spacing: 1rpx;
  margin-bottom: -2rpx;
}

.auto-mode-value {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: 700;
  font-family: "DIN Alternate", "Courier New", Courier, monospace;
}

.auto-mode-value--warn {
  color: #ff4d4f;
  text-shadow: 0 0 8rpx rgba(255, 77, 79, 0.6);
  animation: shotClockPulse 0.5s infinite alternate;
}

.auto-mode-divider {
  width: 1rpx;
  height: 32rpx;
  background: rgba(255, 255, 255, 0.15);
  margin: 0 16rpx;
}

@keyframes shotClockPulse {
  from { opacity: 1; }
  to { opacity: 0.7; }
}

/* 影院模式开关 */
.cinema-mode-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: 500;
}

.cinema-mode-text {
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: 1rpx;
}

.cinema-mode-dot {
  width: 6rpx;
  height: 6rpx;
  background-color: #4ade80;
  border-radius: 50%;
  margin-left: 8rpx;
  box-shadow: 0 0 6rpx #4ade80;
  animation: cinemaPulse 2s infinite;
}

@keyframes cinemaPulse {
  0% { opacity: 0.4; }
  50% { opacity: 1; }
  100% { opacity: 0.4; }
}
