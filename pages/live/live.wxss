page {
  width: 100vw;
  height: 100vh;
  background-color: #000000 !important;
  overflow: hidden;
  margin: 0;
  padding: 0;
}

.container {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  background: #000000;
  overflow: hidden;
  margin: 0;
  padding: 0;
  /* 使用更加正式的系统字体组合，移除全局可能的加粗 */
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
}

/* 与 WebGL 画布均用 100vw×100vh，避免 110% 溢出 + cover 放大边缘畸变；几何与系统 window 一致 */
.camera-bg {
  width: 100vw;
  height: 100vh;
  position: fixed;
  top: 0;
  left: 0;
  object-fit: cover;
  background-color: #000000;
  z-index: 0;
}

/* 硬恢复相机卸载间隙：静态遮罩（pointer-events:none，不挡状态灯与记分 UI） */
.recovery-veil {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  pointer-events: none;
  background: #050608;
  overflow: hidden;
}

.recovery-veil-art {
  width: 100%;
  height: 100%;
  opacity: 0.22;
  display: block;
}

/* 专门针对安卓曲面屏/白边的全屏溢出覆盖 (已废弃，改为全局物理溢出) */

.overlay {
  width: 100%;
  height: calc(100% + env(safe-area-inset-bottom));
  height: calc(100% + constant(safe-area-inset-bottom));
  position: absolute;
  top: 0;
  left: 0;
  z-index: 10;
  pointer-events: none;
}

/* 常驻状态钮：更小、更通透，内盘显示 OK / REC / ↻ */
.recover-fab {
  position: absolute;
  right: 10rpx;
  bottom: calc(10rpx + env(safe-area-inset-bottom));
  z-index: 24;
  width: 40rpx;
  height: 40rpx;
  pointer-events: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  opacity: 0.62;
}

.recover-fab-ring {
  position: relative;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.1);
}

.recover-fab-progress {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/** 与硬恢复同款 conic 色；整环略透明以免压住中心 REC 字 */
.recover-fab-progress--highlight-save {
  opacity: 0.88;
}

.recover-fab-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 30rpx;
  height: 30rpx;
  margin-left: -15rpx;
  margin-top: -15rpx;
  border-radius: 50%;
  background: rgba(10, 12, 16, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.recover-fab-text {
  font-size: 10rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.82);
  text-align: center;
}

.recover-fab--ok .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(95, 217, 95, 0.28);
}

.recover-fab--recording .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(70, 190, 255, 0.32);
}

.recover-fab--recovering .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 208, 74, 0.35);
}

.recover-fab--warn .recover-fab-ring {
  box-shadow: 0 0 0 1rpx rgba(255, 114, 114, 0.32);
}

.recover-fab--actionable .recover-fab-inner {
  background: rgba(52, 18, 18, 0.48);
}

.recover-fab--busy {
  opacity: 0.78;
}

.recover-fab--recording.recover-fab {
  opacity: 0.72;
}

.recover-fab--ack .recover-fab-ring {
  animation: recoverFabAckFlash 0.75s ease-out;
}

@keyframes recoverFabAckFlash {
  0% {
    box-shadow: 0 0 0 0 rgba(95, 217, 95, 0.45);
  }
  100% {
    box-shadow: 0 0 0 10rpx rgba(95, 217, 95, 0);
  }
}

/* 透明手势层 */
.gesture-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 5; /* 位于相机之上，UI 之下 */
}

/* 底部居中记分板 */
.bottom-center-board {
  position: absolute;
  bottom: calc(4rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: auto;
  width: 96vw;
  gap: 0;
}

.match-name-row {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  /* 下压进入透明热区，但与色块保留约 2rpx 间距 */
  margin-bottom: -13rpx;
  transform: translateY(0);
  position: relative;
  z-index: 2;
  pointer-events: auto;
}

.match-name-banner {
  font-size: 12rpx;
  line-height: 14rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.8);
  padding: 0 10rpx;
  opacity: 0.9;
  flex: 1;
  text-align: center;
  overflow: visible;
  text-overflow: clip;
  white-space: normal;
  word-break: break-all;
  pointer-events: auto;
}

/* 记分条：色带视觉高度约 30rpx（约为原先 60rpx 的 50%），整行仍保留约 60rpx 操作热区 */
.main-score-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 60rpx;
  background: transparent;
  border: none;
  box-shadow: none;
  overflow: visible;
  padding: 0;
  box-sizing: border-box;
}

/* 球队组：宽度固定为 12 字占位 + 边距（JS），勿依赖 flex 自动分配以免拉满半屏 */
.team-group {
  position: relative;
  display: block;
  flex: 0 0 auto;
  flex-shrink: 0;
  box-sizing: border-box;
  min-height: 60rpx;
  overflow: visible;
}

/* 半高色条：仅负责背景，不参与点击逻辑 */
.team-group-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  pointer-events: none;
  opacity: 0.75;
}

.team-group-bg--left {
  border-top-left-radius: 10rpx;
  border-bottom-left-radius: 10rpx;
}

.team-group-bg--right {
  border-top-right-radius: 10rpx;
  border-bottom-right-radius: 10rpx;
}

.team-group-row {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-start;
  gap: 4rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 60rpx;
  padding: 0 10rpx;
  overflow: hidden;
}

.team-name {
  flex: 1 1 0;
  min-width: 0;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  overflow: hidden;
}

/* 队名在固定宽度区域内水平居中（WXS 已按 12 字截断，无省略号） */
.team-name--a,
.team-name--b {
  justify-content: center;
}

.team-name-inner {
  display: block;
  font-size: 11rpx;
  font-weight: 400;
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow: hidden;
  text-overflow: clip;
  white-space: nowrap;
  box-sizing: border-box;
}

.team-name--a .team-name-inner,
.team-name--b .team-name-inner {
  text-align: center;
}

.score-value {
  font-size: 13rpx;
  font-weight: bold;
  flex: 0 0 40rpx;
  width: 40rpx;
  min-width: 40rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

/* 中间节次：与球队区相同，半高色条 + 全高热区 */
.period-center-outer {
  position: relative;
  flex: 0 0 auto;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 64rpx;
  min-height: 60rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
}

.period-strip {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  z-index: 0;
  height: 30rpx;
  transform: translateY(-50%);
  background: rgba(34, 211, 238, 0.8);
  pointer-events: none;
  opacity: 0.75;
}

.period-text {
  position: relative;
  z-index: 1;
  color: #fff;
  font-size: 10rpx;
  font-weight: bold;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.replay-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 100;
  background: #000;
}

/* 可拖拽缩放区域：全屏铺满，承载 movable-view */
.replay-movable-area {
  position: absolute;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1;
  overflow: hidden;
}

/* 可拖拽缩放视图：与 movable-area 等大，内部视频居中 */
.replay-movable-view {
  width: 100vw;
  height: 100vh;
  position: relative;
}

/* 独立控制层：整体 pointer-events:none，手势穿透到 movable-view */
.replay-control-overlay {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 3;
  box-sizing: border-box;
  pointer-events: none;
}

/* 回放顶部控制行：绝对定位在左上角，横排排列徽标与倍速按钮 */
.replay-top-bar {
  position: absolute;
  left: calc(16rpx + env(safe-area-inset-left));
  left: calc(16rpx + constant(safe-area-inset-left));
  top: calc(10rpx + env(safe-area-inset-top));
  top: calc(10rpx + constant(safe-area-inset-top));
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  pointer-events: none;
}

/* 实时回看提示徽标：精致胶囊样式 */
.replay-hint-badge {
  height: 42rpx;
  padding: 0 16rpx;
  border-radius: 21rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.2); 
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(10px);
  pointer-events: none;
  display: flex;
  align-items: center;
  justify-content: center;
  letter-spacing: 0.5rpx;
  flex-shrink: 0;
}

/* 倍速按钮组 */
.replay-speed-group {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  pointer-events: auto;
}

/* 单个倍速按钮：默认半透明胶囊 */
.replay-speed-btn {
  height: 42rpx;
  min-width: 64rpx;
  padding: 0 14rpx;
  border-radius: 21rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.5);
  background: rgba(0, 0, 0, 0.15);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 图标型按钮变体：收窄宽度，居中显示 mask 图标 */
.replay-speed-btn--icon {
  min-width: 44rpx;
  padding: 0 11rpx;
}

/* 回放操作小图标：使用 CSS mask 渲染 SVG，颜色跟随父级半透明白 */
.replay-icon {
  width: 20rpx;
  height: 20rpx;
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.5);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

/* 全屏还原图标（四角朝外箭头） */
.replay-icon--fitscreen {
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
}

/* 当前激活倍速：高亮白色 */
.replay-speed-btn--active {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.18);
  border-color: rgba(255, 255, 255, 0.45);
}

.replay-hint-badge::before {
  content: '';
  width: 8rpx;
  height: 8rpx;
  background-color: #ff4d4f;
  border-radius: 50%;
  margin-right: 10rpx;
  box-shadow: 0 0 6rpx #ff4d4f;
  animation: breathing 1.5s ease-in-out infinite;
}

@keyframes breathing {
  0% {
    transform: scale(0.9);
    opacity: 0.6;
    box-shadow: 0 0 2rpx #ff4d4f;
  }
  50% {
    transform: scale(1.2);
    opacity: 1;
    box-shadow: 0 0 12rpx #ff4d4f;
  }
  100% {
    transform: scale(0.9);
    opacity: 0.6;
    box-shadow: 0 0 2rpx #ff4d4f;
  }
}

.replay-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 120;
  background: rgba(0,0,0,0.92);
  display: flex;
  align-items: center;
  justify-content: center;
}

.replay-mask-text {
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  letter-spacing: 10rpx;
  text-shadow: 0 0 24rpx rgba(255,255,255,0.35);
  transform-origin: center center;
}

/* 进入回放：与 live.js introMs≈520ms 对齐，缩短全黑等待 */
.replay-mask--replay {
  background: rgba(0,0,0,1);
  animation: replayMaskMotion 0.52s both;
}

.replay-mask--replay .replay-mask-text {
  animation: replayBadgeMotion 0.52s both;
}

/* 回到直播：反向旋转收束，与 REPLAY 动效区分 */
.replay-mask--live .replay-mask-text {
  animation: liveBadgeMotion 680ms cubic-bezier(0.34, 1.2, 0.64, 1) both;
}

@keyframes replayMaskMotion {
  0% { opacity: 0; }
  35% { opacity: 1; } /* 0.35s / 1.0s = 35% */
  100% { opacity: 0; }
}

@keyframes replayBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(0.6) rotate(-10deg);
  }
  35% {
    opacity: 1;
    transform: scale(1.1) rotate(0deg);
  }
  100% {
    opacity: 0;
    transform: scale(1.3) rotate(5deg);
  }
}

@keyframes liveBadgeMotion {
  0% {
    opacity: 0;
    transform: scale(1.4) rotate(10deg);
  }
  40% {
    opacity: 1;
    transform: scale(0.92) rotate(-6deg);
  }
  70% {
    opacity: 0.9;
    transform: scale(1.06) rotate(2deg);
  }
  100% {
    opacity: 0;
    transform: scale(0.75) rotate(-12deg);
  }
}

.drawer-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 200;
  background: transparent;
  pointer-events: auto;
}

/*
 * 左右抽屉列表缩略图：与 index 高光一致 280×180 比例（内容区宽约 148rpx → 单卡高约 95rpx）
 */
.drawer-list-thumb {
  position: relative;
  width: 100%;
  aspect-ratio: 280 / 180;
  min-height: 96rpx;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.drawer-list-thumb:last-child {
  margin-bottom: 0;
}

/* 比赛卡片：在统一缩略图比例内排布文字 */
.lm-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 6rpx;
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
}

.lm-card--current {
  background: rgba(16, 185, 129, 0.12);
  border-color: rgba(16, 185, 129, 0.3);
}

/* 抽屉内队名片段（字号独立，便于列表阅读） */
.lm-name {
  font-size: 16rpx;
  font-weight: 600;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  text-align: center;
  line-height: 1.2;
}

.lm-vs {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.3);
  font-weight: 400;
  margin: 1rpx 0;
}

/* 高光视频缩略图：与 lm-card 完全一致的毛玻璃样式 */
.drawer-item {
  background: rgba(255, 255, 255, 0.1);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  box-shadow: none;
}

/* 抽屉顶部统计条（左右抽屉共用） */
.clip-count-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 6rpx 10rpx 4rpx;
  pointer-events: none;
}

.clip-count-label {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.55);
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* 片段序号角标（左上角，弱化） */
.clip-index-badge {
  position: absolute;
  top: 9rpx;
  left: 9rpx;
  font-size: 12rpx;
  font-weight: 400;
  color: rgba(255, 255, 255, 0.4);
  line-height: 1.4;
  letter-spacing: 0.3rpx;
  pointer-events: none;
}

/* 右上：播放示意（与序号对称，呼吸间距一致） */
.clip-play-btn {
  position: absolute;
  top: 9rpx;
  right: 9rpx;
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.4;
  pointer-events: none;
}

/* 正中：比分（无队名，球衣色 + 高对比描边） */
.clip-score-center {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  pointer-events: none;
}

.clip-score-digit {
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: 0.6rpx;
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 1),
    0 0 6rpx rgba(0, 0, 0, 0.95),
    1rpx 1rpx 2rpx rgba(0, 0, 0, 1),
    -1rpx -1rpx 2rpx rgba(0, 0, 0, 1);
}

.clip-score-colon {
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  text-shadow:
    0 0 2rpx rgba(0, 0, 0, 1),
    0 0 6rpx rgba(0, 0, 0, 0.95);
}

/* 左下：时间文字（呼吸间距一致） */
.clip-time-bl {
  position: absolute;
  left: 9rpx;
  bottom: 9rpx;
  font-size: 11rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.3;
  letter-spacing: 0.2rpx;
  pointer-events: none;
}

/* ══════════════════════════════════════════
   颜色设置浮层 — 极致透明、高通透感重构
══════════════════════════════════════════ */

/* 全屏遮罩 */
.color-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 300;
  background: rgba(0, 0, 0, 0.15);
  display: flex; 
  align-items: center;
  justify-content: center;
}

/* 浮层主体容器：width 85%，动态高度 */
.color-modal-container {
  width: 86%;
  max-width: 620rpx;
  background: rgba(255, 255, 255, 0.42);
  backdrop-filter: blur(50rpx);
  -webkit-backdrop-filter: blur(50rpx);
  border-radius: 32rpx;
  padding: 28rpx 28rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

/* ── 队名卡片显示层 ── */
.cm-teams-header {
  width: 100%;
  min-height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2%;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
  box-sizing: border-box;
}

/* ── 缓存 Footer 区域：颜色选择器下方隔离区 ── */
.cm-cache-footer {
  width: 100%;
  margin-top: 20rpx;
  box-sizing: border-box;
}

/* 极细分割线，将 Footer 与颜色圆点视觉隔离 */
.cm-cache-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.12);
  margin-bottom: 12rpx;
}

/* 半透明深色容器：提示 + 操作成为一个功能区整体 */
.cm-cache-row {
  width: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 10rpx 14rpx;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.14);
  border-radius: 10rpx;
}

/* 弱化提示文案：白色 60% 透明度，12px 换算约 24rpx */
.cm-cache-text {
  flex: 1;
  font-size: 12rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.6);
  min-width: 0;
}

/* 胶囊操作按钮：主题色青绿，无下划线 */
.cm-cache-btn {
  flex-shrink: 0;
  font-size: 12rpx;
  line-height: 1;
  color: #22d3ee;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.35);
  background: rgba(34, 211, 238, 0.08);
  text-decoration: none;
  box-sizing: border-box;
}

/* 已清空状态：弱化显示，仅为确认反馈 */
.cm-cache-done {
  flex-shrink: 0;
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.35);
}

.cm-team-item {
  flex: 1;
  min-height: 44rpx;
  background: transparent;
  border-radius: 12rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 10rpx;
  min-width: 0;
  transition: all 0.3s;
}

/* 主队：队名在左，色块靠右贴近 VS */
.cm-team-item--left {
  justify-content: flex-end;
  flex-direction: row;
}

/* 客队：色块在左、队名在右 */
.cm-team-item--right {
  justify-content: flex-start;
  flex-direction: row;
}

.cm-team-item--active {
  border-width: 2rpx;
  animation: cmBreathing 2s ease-in-out infinite;
}

@keyframes cmBreathing {
  0% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
  50% { box-shadow: 0 0 12rpx rgba(255, 255, 255, 0.6); opacity: 1; }
  100% { box-shadow: 0 0 2rpx rgba(255, 255, 255, 0.2); opacity: 0.8; }
}

/* 颜色浮层：队服色预览（默认纯色块；--jersey 为球衣剪影） */
.cm-color-swatch {
  flex-shrink: 0;
  width: 44rpx;
  height: 30rpx;
  border-radius: 6rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.14);
  box-sizing: border-box;
}

/* 球衣剪影：无额外底框，颜色直接跟 colorModalMatch.team*.bgColor（mask 固定、fill 用背景色） */
.cm-color-swatch--jersey {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 36rpx;
  background: transparent;
  border: none;
  border-radius: 0;
}

.cm-color-swatch__jersey-fill {
  width: 30rpx;
  height: 30rpx;
  background-color: #221f20;
  -webkit-mask-image: url("data:image/svg+xml;base64,");
  mask-image: url("data:image/svg+xml;base64,");
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.cm-color-swatch--left {
  margin-left: 8rpx;
  margin-right: 0;
}

.cm-color-swatch--right {
  margin-right: 10rpx;
  margin-left: 0;
}

.cm-team-name {
  font-size: 16rpx;
  font-weight: bold;
  color: #000000;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  min-width: 0;
}

.cm-team-name--left {
  text-align: right;
  margin-right: 4rpx;
}

.cm-team-name--right {
  text-align: left;
  margin-left: 4rpx;
}

.cm-vs-divider {
  font-size: 16rpx; /* 与队名同大 */
  font-weight: bold;
  color: #000000; /* 固定黑色 */
  margin: 0 12rpx;
}



.drawer-cover {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  background: transparent;
  pointer-events: none;
  opacity: 0.32;
}

.drawer-back-btn {
  position: absolute;
  top: 18rpx;
  left: 18rpx;
  z-index: 210;
  width: 46rpx;
  height: 46rpx;
  border-radius: 23rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,0.14);
  border: 1px solid rgba(255,255,255,0.10);
  backdrop-filter: blur(8px);
  pointer-events: auto;
  opacity: 0.55;
}

/* 全局矢量图标容器：46rpx，mask 居中不拉伸 */
.live-toolbar-icon {
  width: 46rpx;
  height: 46rpx;
  flex-shrink: 0;
  background-color: rgba(255, 255, 255, 0.92);
  -webkit-mask-size: contain;
  mask-size: contain;
  -webkit-mask-repeat: no-repeat;
  mask-repeat: no-repeat;
  -webkit-mask-position: center;
  mask-position: center;
}

.live-toolbar-icon--back {
  -webkit-mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
  mask-image: url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAyNCAyNCI+PHBhdGggZmlsbD0iIzAwMCIgZD0iTTE1LjQxIDcuNDFMMTQgNmwtNiA2IDYgNiAxLjQxLTEuNDFMMTAuODMgMTJ6Ii8+PC9zdmc+");
}


/* 双 slot 容器：绝对定位叠放，通过 z-index 切换前后层 */
.replay-slot {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}
.replay-slot--active {
  z-index: 2;
}
.replay-slot--back {
  z-index: 1;
}

.replay-video-fullscreen {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 100vw;
  height: 100vh;
  object-fit: contain;
  transform: translate(-50%, -50%);
}

/* 竖屏录像在横屏回放时旋转 90 度铺满可视区域 */
.replay-video-fullscreen--rotated {
  width: 100vh;
  height: 100vw;
  transform: translate(-50%, -50%) rotate(90deg);
}

/* ══ 操作指南弹窗（毛玻璃深色双列布局）══ */
.guide-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* 毛玻璃卡片，与场次矩形风格一致 */
.guide-card {
  width: 88%;
  max-width: 820rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.16);
  padding: 32rpx 28rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

/* 标题区域 */
.guide-title-bar {
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.guide-main-title {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.95);
  letter-spacing: 1rpx;
}

/* 双列容器 */
.guide-columns {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0;
}

.guide-col {
  flex: 1;
  min-width: 0;
  padding: 0 16rpx;
}

/* 竖向分隔线 */
.guide-divider-v {
  width: 1rpx;
  align-self: stretch;
  background: rgba(255, 255, 255, 0.12);
  flex-shrink: 0;
}

/* 分区标题行 */
.guide-section-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.guide-section-emoji {
  font-size: 20rpx;
  line-height: 1;
}

.guide-section-title {
  font-size: 19rpx;
  font-weight: 700;
  color: #4ade80;
  letter-spacing: 0.5rpx;
}

/* 操作条目行 */
.guide-item {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  margin-bottom: 8rpx;
  line-height: 1.6;
}

/* 全宽跨列条目 */
.guide-item-full {
  margin-top: 0;
  padding: 0 4rpx;
}

.guide-action {
  font-size: 17rpx;
  font-weight: 600;
  color: #fbbf24;
  white-space: nowrap;
  flex-shrink: 0;
}

.guide-sep {
  font-size: 15rpx;
  color: rgba(255, 255, 255, 0.28);
  flex-shrink: 0;
  margin: 0 4rpx;
}

.guide-desc {
  font-size: 17rpx;
  color: rgba(255, 255, 255, 0.72);
  flex: 1;
  line-height: 1.6;
}

/* 全宽分隔线（列区与补充项之间） */
.guide-full-divider {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin: 16rpx 0 12rpx;
}

/* 底部关闭按钮（居中，仅文字 + 边框） */
.guide-close-bar {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.guide-close {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 36rpx;
  border-radius: 23rpx;
  background: transparent;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.6);
  font-weight: 400;
}

/* 兼容旧 class，避免残留节点可见 */
.guide-key, .guide-title, .guide-btn-container, .guide-confirm-btn {
  display: none;
}

/* 横屏适配 */
@media screen and (orientation: landscape) {
  .guide-card {
    width: 72%;
    max-width: 860rpx;
    padding: 24rpx 24rpx 18rpx;
  }

  .guide-main-title {
    font-size: 24rpx;
  }

  .guide-title-bar {
    margin-bottom: 16rpx;
  }

  .guide-col {
    padding: 0 12rpx;
  }

  .guide-section-title {
    font-size: 17rpx;
  }

  .guide-action, .guide-desc {
    font-size: 15rpx;
  }

  .guide-item {
    margin-bottom: 6rpx;
  }

  .guide-full-divider {
    margin: 12rpx 0 10rpx;
  }

  .guide-close-bar {
    margin-top: 14rpx;
  }

  .guide-close {
    height: 40rpx;
    font-size: 18rpx;
    padding: 0 28rpx;
  }
}

/* ══════════════════════════════════════════
   管理抽屉
   z-index: backdrop 195 / left-drawer 200 / drawer-panel 201 / back-btn 210
   color-modal 300
══════════════════════════════════════════ */

/* 遮罩（低于两侧面板） */
.drawer-mode-backdrop {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 195;
  background: rgba(0, 0, 0, 0.08);
}

/* ── 左侧比赛列表抽屉 ── */
.left-drawer {
  position: fixed;
  top: 50%;
  left: 0;
  width: 168rpx;
  max-height: 48vh;
  z-index: 200;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

/*
 * 可视高度 ≈ 1.8×单卡高度（单卡≈148×180/280≈95rpx），略小于两卡+间距，保证 2 条时可滚动
 */
.match-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.left-drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 右侧高光列表抽屉 ── */
.drawer-panel {
  position: fixed;
  top: 50%;
  right: 0;
  width: 168rpx;
  max-height: 52vh;
  z-index: 201;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transform: translateY(-50%);
  pointer-events: none;
}

.clip-list-view {
  width: 100%;
  height: 172rpx;
  max-height: 172rpx;
  min-height: 0;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.drawer-scroll {
  flex: 1;
  height: 100%;
  min-height: 0;
  width: 100%;
  padding: 0 10rpx;
  box-sizing: border-box;
  background: transparent;
  pointer-events: auto;
  overflow: hidden;
}

/* ── 24色无滚动矩阵：12列 x 2行 ── */
.cm-matrix-palette {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(12, 1fr);
  column-gap: 1.5%;
  row-gap: 12rpx;
  margin: 18rpx 0 0;
  padding: 0 4rpx;
  box-sizing: border-box;
  justify-items: center;
  align-items: center;
}

.cm-matrix-ball {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  box-sizing: border-box;
}

.cm-matrix-ball--active {
  transform: scale(1.28);
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.85);
  z-index: 2;
  border-color: rgba(255, 255, 255, 0.5);
}

/* ── 操作行 ── */
.cm-action-row {
  width: 100%;
  display: flex;
  justify-content: center;
  margin-top: 8rpx;
  padding-top: 4rpx;
}

/* 切换按钮：添加圆角并适配比例 */
.cm-btn-switch {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(0, 122, 255, 0.75);
  border-radius: 12rpx; /* 调整圆角与浮层弧度一致 */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
}

.cm-btn-switch--disabled {
  min-width: 80rpx;
  height: 32rpx;
  padding: 0 20rpx;
  background: rgba(16, 185, 129, 0.75); /* 改为绿色 */
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 14rpx;
  font-weight: bold;
  opacity: 1;
}

/* ── 权益续杯全屏层（高于 guide-overlay 500） ── */
.vip-gate-root {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 540;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.vip-gate-bg {
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 120% 80% at 50% 20%, rgba(37, 99, 235, 0.35), transparent 55%),
    radial-gradient(ellipse 90% 70% at 80% 70%, rgba(16, 174, 255, 0.22), transparent 50%),
    linear-gradient(165deg, #0b1220 0%, #030712 48%, #0f172a 100%);
  filter: saturate(1.08);
}

.vip-gate-bg::after {
  content: '';
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  backdrop-filter: blur(18px);
}

.vip-gate-card {
  position: relative;
  z-index: 1;
  width: 88%;
  max-width: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(30, 31, 35, 0.88);
  border: 1px solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 24rpx 80rpx rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(22rpx);
}

.vip-gate-kicker {
  font-size: 18rpx;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #f8fafc;
  margin-bottom: 16rpx;
  line-height: 1.25;
}

.vip-gate-sub {
  font-size: 24rpx;
  line-height: 1.65;
  color: rgba(226, 232, 240, 0.95);
  margin-bottom: 12rpx;
}

.vip-gate-minor {
  font-size: 20rpx;
  line-height: 1.5;
  color: rgba(148, 163, 184, 0.95);
  margin-bottom: 28rpx;
}

.vip-gate-share-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0;
  margin: 0 0 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(120deg, #2563eb 0%, #0ea5e9 55%, #22d3ee 100%);
  box-shadow: 0 12rpx 36rpx rgba(37, 99, 235, 0.35);
}

.vip-gate-share-btn::after {
  border: none;
}

.vip-gate-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.vip-gate-link {
  font-size: 22rpx;
  color: #5c9cf2;
  padding: 8rpx 4rpx;
}

.vip-gate-link--sep {
  color: #4a6fa8;
  padding: 8rpx 0;
}

@media screen and (orientation: landscape) {
  .vip-gate-root {
    padding: 18rpx 40rpx;
  }

  .vip-gate-card {
    width: 62%;
    max-width: 700rpx;
    min-width: 500rpx;
    padding: 24rpx 26rpx 18rpx;
    border-radius: 20rpx;
  }

  .vip-gate-kicker {
    font-size: 14rpx;
    margin-bottom: 8rpx;
  }

  .vip-gate-title {
    font-size: 28rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-sub {
    font-size: 20rpx;
    line-height: 1.45;
    margin-bottom: 8rpx;
  }

  .vip-gate-minor {
    font-size: 17rpx;
    line-height: 1.4;
    margin-bottom: 14rpx;
  }

  .vip-gate-share-btn {
    height: 72rpx;
    line-height: 72rpx;
    font-size: 24rpx;
    margin-bottom: 10rpx;
  }

  .vip-gate-row {
    justify-content: center;
    gap: 12rpx;
  }

  .vip-gate-link {
    font-size: 19rpx;
    padding: 4rpx 2rpx;
  }
}

/* ══ 开赛前引导 + 共用 AF/AE（与 replay-hint 胶囊、毛玻璃条风格统一） */
.focus-ui-layer {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 6;
  pointer-events: none;
  overflow: hidden;
}

.focus-guide {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

/* 半透明脉冲环：开赛前强提示，录制中由 container--rec-performance 关闭动效以省 CPU */
.focus-guide-ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(74, 222, 128, 0.4);
  background: rgba(74, 222, 128, 0.1);
  box-shadow: 0 0 0 1rpx rgba(255, 255, 255, 0.1);
  animation: focusGuidePulse 1.6s ease-in-out infinite;
}

@keyframes focusGuidePulse {
  0% {
    transform: scale(0.88);
    opacity: 0.6;
  }
  50% {
    transform: scale(1.04);
    opacity: 1;
  }
  100% {
    transform: scale(0.88);
    opacity: 0.6;
  }
}

.focus-guide-text {
  margin-top: 28rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.75);
  letter-spacing: 0.4rpx;
  max-width: 80%;
  text-align: center;
}

/*
 * 对焦：仅方框+提示为簇，曝光条吸屏右；长按空白区仍由下层 gesture 接收。
 */
.ae-af-wrap {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
}

.ae-focus-cluster {
  position: absolute;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  pointer-events: none;
}

.ae-focus-cluster--center {
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  align-items: center;
}

.ae-focus-bracket {
  width: 56rpx;
  height: 56rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border: 2rpx solid rgba(74, 222, 128, 0.92);
  background: rgba(0, 0, 0, 0.04);
  border-radius: 3rpx;
  pointer-events: auto;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.2);
}

.ae-focus-bracket--locked {
  border-color: #22c55e;
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.2), 0 0 0 4rpx rgba(34, 197, 94, 0.28);
}

.ae-double-tap-hint {
  margin-top: 6rpx;
  max-width: 220rpx;
  font-size: 12rpx;
  line-height: 1.4;
  color: rgba(255, 255, 255, 0.82);
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.85);
  font-weight: 500;
  pointer-events: none;
}

/* 对焦点位成功：短时扩散高亮；无 transform，避免与 .ae-focus-cluster--center 的 translate 争用 */
.ae-focus-cluster--flash .ae-focus-bracket {
  animation: aeBracketLockRipple 0.55s ease-out;
}

@keyframes aeBracketLockRipple {
  0% {
    box-shadow: 0 0 0 0 rgba(74, 222, 128, 0.55);
  }
  100% {
    box-shadow: 0 0 0 18rpx rgba(74, 222, 128, 0);
  }
}

/* 吸右侧的竖向曝光区：加高滑轨；无大圆角底，仅小 padding 增触区 */
.ae-sun-rail--dock-right {
  position: absolute;
  right: 2%;
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 8rpx 12rpx;
  width: 104rpx;
  box-sizing: border-box;
  pointer-events: auto;
}

.ae-sun-rail--dock-right .ae-sun-track {
  position: relative;
  width: 5rpx;
  height: 220rpx;
  border-radius: 2rpx;
  background: linear-gradient(180deg, rgba(187, 247, 208, 0.75) 0%, rgba(34, 197, 94, 0.2) 100%);
}

.ae-sun-thumb {
  position: absolute;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  margin-left: -10rpx;
  margin-top: -10rpx;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 6rpx rgba(74, 222, 128, 0.75);
}

.ae-sun-glyph {
  font-size: 22rpx;
  line-height: 1;
  color: #86efac;
  text-shadow: 0 0 6rpx rgba(0, 0, 0, 0.45);
  pointer-events: none;
  flex-shrink: 0;
}

/* 录制中关闭引导脉冲与状态钮 ACK 动画，减少 setData/合成与编码同屏争用 */
.container--rec-performance .focus-guide-ring {
  animation: none;
  opacity: 0.55;
}

.container--rec-performance .recover-fab--ack .recover-fab-ring {
  animation: none;
}

@media screen and (orientation: landscape) {
  .focus-guide-text {
    font-size: 17rpx;
    margin-top: 20rpx;
  }
  .focus-guide-ring {
    width: 170rpx;
    height: 170rpx;
  }
  .ae-sun-rail--dock-right .ae-sun-track {
    height: 260rpx;
  }
  .ae-sun-rail--dock-right {
    right: 1.5%;
  }
}

/* ===== Enhance render canvas =====
 * WebGL 锐化画布：全屏覆盖在 <camera> 之上；指针事件透传给 .gesture-layer
 * 仅在 render-pipeline 启动成功后由 data.enhanceCanvasVisible 触发进入视图树。
 */
/* 增强渲染画布：与 .camera-bg 同尺寸/位置，顶点 shader 做 object-fit:cover 与原生预览对齐。 */
.enhance-canvas {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  pointer-events: none;
  z-index: 1;
  background: transparent;
}

/* 开启增强时 <camera> 只承担 onCameraFrame 吐帧，视觉上被 canvas 替代。
   微信原生层级在部分机型（尤其 iOS）对 z-index 不敏感，直接把 camera
   视觉上近乎透明，强制让 canvas 成为用户眼中的预览层；
   opacity 不能是 0（部分基础库会把"完全不可见"的 camera 判死，停止 onCameraFrame）。 */
.camera-bg--under-enhance {
  opacity: 0.01;
}

/* ===== Enhance render debug toolbar =====
 * 抽屉（drawerMode===1）顶部常驻胶囊条；展示当前档位 + FPS，提供 3 档切换。
 * 仅在机型通过白名单（enhanceWhitelisted）时进入视图树。
 */
.enhance-mode-toolbar {
  position: fixed;
  top: 14rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 220;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 5rpx 8rpx 5rpx 10rpx;
  background: rgba(18, 20, 26, 0.78);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  pointer-events: auto;
  box-shadow: 0 2rpx 14rpx rgba(0, 0, 0, 0.28);
  max-width: 96vw;
  box-sizing: border-box;
}
.enhance-mode-status {
  display: flex;
  flex-direction: column;
  line-height: 1.15;
  padding: 0 2rpx 0 4rpx;
  min-width: 0;
  max-width: 38vw;
}
.enhance-mode-k {
  font-size: 12rpx;
  color: rgba(255, 255, 255, 0.5);
  letter-spacing: 0.5rpx;
}
.enhance-mode-v {
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.9);
  /* FPS 数字等宽对齐，跳动时不抖 */
  font-variant-numeric: tabular-nums;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.enhance-mode-group {
  display: flex;
  flex-wrap: nowrap;
  gap: 2rpx;
  padding: 1rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 999rpx;
  flex-shrink: 0;
}
.enhance-mode-btn {
  font-size: 16rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.62);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}
.enhance-mode-btn--active {
  color: #fff;
  background: linear-gradient(135deg, #2563EB, #7C3AED);
  box-shadow: 0 2rpx 10rpx rgba(99, 102, 241, 0.38);
}

/* VK 模式按钮：独立家族，用橙红色调以视觉区隔，暗示"破坏性动作"（会暂停精彩回放）。 */
.enhance-mode-btn--vk {
  color: #fca5a5;
  border: 1rpx solid rgba(239, 68, 68, 0.38);
}
.enhance-mode-btn--vk.enhance-mode-btn--active {
  color: #fff;
  background: linear-gradient(135deg, #E64340, #F97316);
  box-shadow: 0 2rpx 10rpx rgba(230, 67, 64, 0.45);
  border-color: transparent;
}

/* 切换中的 toolbar：禁用点击 + 降低透明度，防止 orchestrator 执行期间用户连点乱序 */
.enhance-mode-toolbar--transitioning {
  opacity: 0.55;
  pointer-events: none;
}

/* ========== 严重存储：对齐系统 wx.showModal（与 VK 确认框同系；宽度用 px 封顶，横屏不致 80vw 铺满） ========== */
.storage-pressure-overlay {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  z-index: 2500;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px 20px;
  box-sizing: border-box;
}
.storage-pressure-backdrop {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}
.storage-pressure-panel {
  position: relative;
  z-index: 1;
  align-self: center;
  width: 86%;
  max-width: 300px;
  box-sizing: border-box;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
}
.storage-pressure-title {
  font-size: 17px;
  font-weight: 700;
  color: #000;
  text-align: center;
  padding: 22px 18px 8px;
  line-height: 1.35;
}
.storage-pressure-text {
  width: 100%;
  box-sizing: border-box;
  font-size: 14px;
  line-height: 1.45;
  color: #666;
  text-align: center;
  padding: 0 18px 18px;
  max-height: 38vh;
  overflow-y: auto;
  word-break: break-word;
  overflow-wrap: break-word;
  white-space: normal;
}
.storage-pressure-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  width: 100%;
  box-sizing: border-box;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.storage-pressure-btn {
  flex: 1 1 0;
  width: 0;
  min-height: 44px;
  padding: 10px 6px;
  text-align: center;
  font-size: 17px;
  border-radius: 0;
  background: #fff;
  line-height: 1.3;
  white-space: nowrap;
  box-sizing: border-box;
}
.storage-pressure-btn--secondary {
  color: #000;
  border-right: 1rpx solid rgba(0, 0, 0, 0.08);
}
.storage-pressure-btn--primary {
  color: #e64340;
  font-weight: 600;
}
