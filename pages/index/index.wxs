function fmtStart(startAt, createdAt) {
  var s = +startAt;
  var c = +createdAt;
  var t = s > 0 ? s : (c > 0 ? c : 0);
  if (t <= 0) {
    return '';
  }
  var d = getDate(t);
  return (d.getMonth() + 1) + '/' + d.getDate() + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes()) + ' 开赛';
}

function pad2(n) {
  return n < 10 ? '0' + n : '' + n;
}

module.exports = {
  fmtStart: fmtStart
};
