page {
  background-color: #f8fafc;
  min-height: 100%;
}

.help-page {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

.help-intro {
  margin-bottom: 28rpx;
}

.help-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.help-intro-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.help-intro-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: #64748b;
}

.help-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx 32rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.help-card--warn {
  border: 1rpx solid rgba(251, 191, 36, 0.35);
  background: linear-gradient(180deg, #fffbeb 0%, #ffffff 48%);
}

.help-card--last {
  margin-bottom: 16rpx;
}

.help-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 20rpx;
  gap: 12rpx;
}

.help-card-icon {
  font-size: 32rpx;
  line-height: 1;
}

.help-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.help-p {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #475569;
  margin-bottom: 16rpx;
}

.help-p:last-child {
  margin-bottom: 0;
}

.help-p--emph {
  color: #b45309;
  font-weight: 500;
}

.help-p--tip {
  font-size: 26rpx;
  color: #64748b;
  padding: 16rpx 18rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  margin-top: 8rpx;
}

/* 与直播页操作指南第二步相同的画幅引导图（浅色卡片内展示） */
.help-dy-demo {
  margin-top: 8rpx;
  margin-bottom: 8rpx;
  padding: 20rpx 18rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.help-dy-step {
  margin-bottom: 28rpx;
}

.help-dy-step--last {
  margin-bottom: 0;
}

.help-dy-step__label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #15803d;
  margin-bottom: 8rpx;
  letter-spacing: 0.2rpx;
}

.help-dy-step__path {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 14rpx;
}

.help-dy-shot {
  display: block;
  width: 100%;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  background: #ffffff;
  vertical-align: top;
}

.help-steps {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.help-step {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.help-step--last {
  border-bottom: none;
  padding-bottom: 0;
}

.help-step-num {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #ffffff;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  border-radius: 12rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.help-step-body {
  flex: 1;
  min-width: 0;
}

.help-step-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.help-step-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748b;
}

.help-bullets {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.help-bullet {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
}

.help-bullet-dot {
  color: #3b82f6;
  font-size: 28rpx;
  line-height: 1.5;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.help-bullet-text {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.6;
  color: #475569;
}

.help-faq {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.help-faq-item {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.help-faq-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.help-faq-q {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.help-faq-a {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748b;
}

.help-footer {
  text-align: center;
  padding: 8rpx 16rpx 0;
}

.help-footer-text {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}
