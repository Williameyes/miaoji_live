.mine-page {
  min-height: 100vh;
  padding: 0 40rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-color: #f8fafc;
}

.nav-title-wrap {
  padding: 24rpx 0 32rpx;
}

.nav-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
}

.profile-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 40rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.profile-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.profile-row-hover {
  opacity: 0.92;
}

.avatar-wrap {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: transparent;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background-color: #e2e8f0;
  flex-shrink: 0;
  display: block;
}

.nick-input {
  width: 100%;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  min-height: 48rpx;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
}

.profile-logged .profile-text {
  align-self: stretch;
}

.profile-text {
  margin-left: 32rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
  min-width: 0;
}

.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.4;
}

.hint-strong {
  color: #f59e0b;
  font-weight: 500;
}

.sub-muted {
  color: #94a3b8;
}

.vip-status-row {
  margin-top: 18rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.vip-status-icon {
  font-size: 18rpx;
  line-height: 1;
  color: #fbbf24;
  opacity: 0.92;
}

.vip-status-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  font-weight: 400;
  color: #b6892d;
  letter-spacing: 0.2rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.vip-status-text--expired {
  color: #9ca3af;
}

.vip-renew-entry {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 0 4rpx 8rpx;
}

.vip-renew-text {
  font-size: 22rpx;
  font-weight: 400;
  color: #94a3b8;
}

.vip-renew-arrow {
  margin-left: 4rpx;
  font-size: 24rpx;
  line-height: 1;
  color: #94a3b8;
}

.nick {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-actions {
  margin-top: 36rpx;
}

.btn-login {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  margin: 0;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 48rpx;
  box-shadow: 0 12rpx 32rpx rgba(37, 99, 235, 0.28);
}

.btn-login::after {
  border: none;
}

.logout-actions {
  margin-top: 36rpx;
}

.btn-logout {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  background: #ffffff;
  color: #e64340;
  font-weight: 600;
  font-size: 28rpx;
  border: 2rpx solid #fecaca;
  border-radius: 44rpx;
}

.btn-logout::after {
  border: none;
}

.list-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx;
}

.list-item-hover {
  background-color: #f1f5f9;
}

.list-label {
  font-size: 30rpx;
  color: #1e293b;
}

.list-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  line-height: 1;
}

.list-divider {
  height: 1rpx;
  background: #f1f5f9;
  margin: 0 36rpx;
}
