<view class="mine-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-title-wrap">
    <text class="nav-title">我的</text>
  </view>

  <view class="profile-card">
    <view wx:if="{{!loggedIn}}" class="profile-row profile-row-guest">
      <image class="avatar" src="{{defaultAvatar}}" mode="aspectFill" />
      <view class="profile-text">
        <text class="nick">{{displayNick}}</text>
      </view>
    </view>

    <view wx:else class="profile-row profile-logged">
      <view class="avatar-wrap">
        <image class="avatar" src="{{displayAvatarSrc || defaultAvatar}}" mode="aspectFill" />
      </view>
      <view class="profile-text">
        <input
          class="nick-input"
          type="nickname"
          value="{{displayNick}}"
          placeholder="填写昵称"
          bindblur="onNicknameConfirm"
        />
      </view>
    </view>
    <view class="vip-status-row" wx:if="{{loggedIn}}">
      <text class="vip-status-icon">✦</text>
      <text class="vip-status-text {{vipStatusExpired ? 'vip-status-text--expired' : ''}}">{{vipStatusText}}</text>
      <view class="vip-renew-entry" wx:if="{{vipStatusRenewHintVisible}}" bindtap="onVipRenewTap">
        <text class="vip-renew-text">去续期</text>
        <text class="vip-renew-arrow">›</text>
      </view>
    </view>

    <view class="login-actions" wx:if="{{!loggedIn}}">
      <button class="btn-login" type="primary" bindtap="handleLogin">微信登录</button>
    </view>

    <view class="logout-actions" wx:if="{{loggedIn}}">
      <button class="btn-logout" bindtap="handleLogout">退出登录</button>
    </view>
  </view>

  <!-- 去续期自定义引导弹窗 -->
  <view class="renew-overlay" wx:if="{{showRenewModal}}" catchtouchmove="onRenewModalCatchMove" bindtap="closeRenewModal">
    <view class="renew-card" catchtap="stopRenewModalBubble">
      <view class="renew-kicker">HoopsLive</view>
      <view class="renew-title">去续期</view>
      <view class="renew-sub">邀请好友完成登录可续期 5 天</view>
      <view class="renew-minor">将小程序分享给球友，完成首次登录即可帮你续期</view>
      <button class="renew-share-btn" open-type="share">立即分享，继续试用</button>
      <view class="renew-dismiss" bindtap="closeRenewModal">我知道了</view>
    </view>
  </view>

  <view class="list-card">
    <view class="list-item" hover-class="list-item-hover" bindtap="onAboutTap">
      <text class="list-label">关于秒记</text>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-divider"></view>
    <view class="list-item" hover-class="list-item-hover" bindtap="onFeedbackTap">
      <text class="list-label">使用反馈</text>
      <text class="list-arrow">›</text>
    </view>
  </view>
</view>
