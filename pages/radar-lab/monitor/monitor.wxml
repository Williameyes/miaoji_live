<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">监控现场</view>
    <view class="rl-title">{{matchTitle}}</view>
    <view class="rl-sub" wx:if="{{matchId}}">
      场次 #{{matchId}}
      <text class="rl-badge {{statusBadgeClass}}" wx:if="{{matchStatus}}">{{statusLabel}}</text>
      <text wx:if="{{polling}}" style="margin-left:12rpx;color:#94a3b8;">· 每20秒刷新</text>
    </view>
  </view>

  <!-- 场次选择 -->
  <view class="rl-card" wx:if="{{!matchId || matches.length}}">
    <view class="rl-card-inner">
      <view class="rl-section-title">选择场次</view>
      <view class="rl-field">
        <input class="rl-input" placeholder="输入场次 ID" value="{{matchId}}" bindinput="onMatchIdInput" />
      </view>
      <button class="rl-btn rl-btn-secondary" bindtap="onLoadMatch">加载监控</button>
      <block wx:if="{{matches.length}}">
        <view style="margin-top:24rpx;">
          <block wx:for="{{matches}}" wx:key="id">
            <view class="rl-list-item" bindtap="onPickMatch" data-id="{{item.id}}" hover-class="rl-list-item-hover">
              <view class="rl-list-main">
                <view class="rl-list-title">{{item.teamA}} vs {{item.teamB}}</view>
                <view class="rl-list-desc">#{{item.id}}</view>
              </view>
              <text class="rl-list-arrow">›</text>
            </view>
          </block>
        </view>
      </block>
    </view>
  </view>

  <block wx:if="{{matchId}}">
    <!-- 实时指标 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="mon-metrics">
          <view class="mon-metric">
            <text class="mon-metric-label">当前在线</text>
            <text class="mon-metric-value">{{currentOnline}}</text>
          </view>
          <view class="mon-metric">
            <text class="mon-metric-label">峰值在线</text>
            <text class="mon-metric-value">{{peakOnline}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Canvas 曲线 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="rl-section-title">全网合流热度</view>
        <view class="mon-canvas-wrap">
          <canvas type="2d" id="heatCanvas" class="mon-canvas"></canvas>
          <view class="rl-empty" wx:if="{{timelineEmpty && canvasReady}}">等待雷达上报数据…</view>
        </view>
      </view>
    </view>

    <!-- 操作区 -->
    <view class="mon-actions">
      <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onOpenBindModal">绑定直播雷达</button>
      <button
        class="rl-btn rl-btn-danger"
        disabled="{{submitting || !canStop}}"
        bindtap="onStopMonitoring"
      >关闭监控</button>
    </view>

    <view class="rl-notice">
      <text class="rl-notice-text">同场次可多次粘贴不同主播口令实现多路并行；关闭监控将释放全部 Worker 并结算数据。</text>
    </view>
  </block>

  <!-- 绑定弹窗 -->
  <view class="rl-modal-mask" wx:if="{{showBindModal}}" bindtap="onCloseBindModal" catchtouchmove="stopModalBubble">
    <view class="rl-modal" catchtap="stopModalBubble">
      <view class="rl-modal-title">绑定 / 追加直播雷达</view>
      <view class="rl-field">
        <text class="rl-label">粘贴抖音分享口令或链接</text>
        <textarea
          class="rl-textarea"
          placeholder="7@5.com … https://v.douyin.com/xxx/"
          value="{{bindRawText}}"
          bindinput="onBindInput"
          maxlength="-1"
        />
      </view>
      <view class="rl-modal-actions">
        <button class="rl-btn rl-btn-secondary" bindtap="onCloseBindModal">取消</button>
        <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onSubmitBind">启动监控</button>
      </view>
    </view>
  </view>

</view>
