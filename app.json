{
  "pages": [
    "pages/index/index",
    "pages/tournament/tournament",
    "pages/mine/mine",
    "pages/help/help",
    "pages/promo-landing/promo-landing"
  ],
  "subpackages": [
    {
      "root": "packageLive",
      "name": "packageLive",
      "pages": [
        "pages/live/live",
        "pages/web-score-panel/web-score-panel",
        "pages/sub-score-panel/sub-score-panel"
      ]
    },
    {
      "root": "packageReport",
      "name": "packageReport",
      "pages": [
        "pages/report/report"
      ]
    },
    {
      "root": "packagePromo",
      "name": "packagePromo",
      "pages": [
        "pages/promo-bind/promo-bind",
        "pages/promo-square/promo-square",
        "pages/promo-my/promo-my",
        "pages/promo-review/promo-review",
        "pages/tournament-detail/tournament-detail"
      ]
    },
    {
      "root": "packageLab",
      "name": "packageLab",
      "pages": [
        "pages/sync-lab/collector/collector",
        "pages/radar-lab/index/index",
        "pages/radar-lab/mount/index",
        "pages/radar-lab/warmup/index",
        "pages/radar-lab/oam/oam",
        "pages/radar-lab/oam/tournament-list/tournament-list",
        "pages/radar-lab/oam/match-edit/match-edit",
        "pages/radar-lab/oam/promo-publish/promo-publish",
        "pages/radar-lab/oam/tournament-edit/tournament-edit",
        "pages/radar-lab/monitor/index",
        "pages/radar-lab/monitor/promo",
        "pages/radar-lab/monitor/detail",
        "pages/radar-lab/settlement/detail",
        "pages/radar-lab/poster/poster"
      ]
    },
    {
      "root": "packageRec",
      "name": "packageRec",
      "pages": [
        "pages/highlight-rec/highlight-rec",
        "pages/shooting-training/shooting-training"
      ]
    }
  ],
  "lazyCodeLoading": "requiredComponents",
  "preloadRule": {
    "packageLive/pages/live/live": {
      "network": "all",
      "packages": ["packageReport"]
    },
    "pages/index/index": {
      "network": "all",
      "packages": ["packageLive", "packageReport"]
    },
    "pages/tournament/tournament": {
      "network": "all",
      "packages": ["packagePromo"]
    }
  },
  "window": {
    "initialRenderingCache": "static",
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#000000",
    "navigationBarTitleText": "高光记分 - 篮球足球羽毛球比赛计分助手",
    "navigationBarTextStyle": "white",
    "navigationStyle": "custom",
    "backgroundColor": "#000000",
    "backgroundColorTop": "#000000",
    "backgroundColorBottom": "#F8FAFC"
  },
  "tabBar": {
    "custom": true,
    "color": "#64748B",
    "selectedColor": "#2563EB",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "直播记分",
        "iconPath": "assets/tab/tab-score.png",
        "selectedIconPath": "assets/tab/tab-score-active.png"
      },
      {
        "pagePath": "pages/tournament/tournament",
        "text": "赛事资讯",
        "iconPath": "assets/tab/tab-score.png",
        "selectedIconPath": "assets/tab/tab-score-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/tab/tab-mine.png",
        "selectedIconPath": "assets/tab/tab-mine-active.png"
      }
    ]
  },
  "workers": "workers",
  "sitemapLocation": "sitemap.json"
}
