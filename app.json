{
  "pages": [
    "pages/index/index",
    "pages/live/live",
    "pages/mine/mine",
    "pages/help/help"
  ],
  "subpackages": [
    {
      "root": "packageReport",
      "name": "packageReport",
      "pages": [
        "pages/report/report"
      ]
    },
    {
      "root": "packageLab",
      "name": "packageLab",
      "pages": [
        "pages/sync-lab/index/index",
        "pages/sync-lab/collector/collector",
        "pages/sync-lab/broadcaster/broadcaster",
        "pages/radar-lab/index/index",
        "pages/radar-lab/oam/oam",
        "pages/radar-lab/oam/tournament-list/tournament-list",
        "pages/radar-lab/oam/match-edit/match-edit",
        "pages/radar-lab/oam/tournament-edit/tournament-edit",
        "pages/radar-lab/monitor/index",
        "pages/radar-lab/monitor/detail",
        "pages/radar-lab/poster/poster"
      ]
    }
  ],
  "preloadRule": {
    "pages/live/live": {
      "network": "all",
      "packages": ["packageReport"]
    },
    "pages/index/index": {
      "network": "wifi",
      "packages": ["packageReport"]
    }
  },
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#000000",
    "navigationBarTitleText": "高光记分",
    "navigationBarTextStyle": "white",
    "navigationStyle": "custom",
    "backgroundColor": "#000000",
    "backgroundColorTop": "#000000",
    "backgroundColorBottom": "#F8FAFC"
  },
  "tabBar": {
    "custom": true,
    "color": "#64748B",
    "selectedColor": "#2563EB",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "记分",
        "iconPath": "assets/tab/tab-score.png",
        "selectedIconPath": "assets/tab/tab-score-active.png"
      },
      {
        "pagePath": "pages/mine/mine",
        "text": "我的",
        "iconPath": "assets/tab/tab-mine.png",
        "selectedIconPath": "assets/tab/tab-mine-active.png"
      }
    ]
  },
  "sitemapLocation": "sitemap.json",
  "permission": {
    "scope.camera": {
      "desc": "用于扫描篮球记分牌，实现自动 OCR 识别比分"
    },
    "scope.writePhotosAlbum": {
      "desc": "用于保存赛事影响力战报海报到相册"
    }
  }
}
