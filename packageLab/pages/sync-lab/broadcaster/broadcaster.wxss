/* 直播端样式 */
.bc-root {
  min-height: 100vh;
  background: #f8fafc;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx calc(60rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 状态栏 */
.bc-status-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 28rpx 0 24rpx;
}
.bc-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.bc-status-dot--idle         { background: #cbd5e1; }
.bc-status-dot--scanning     { background: #f59e0b; }
.bc-status-dot--connecting   { background: #f59e0b; }
.bc-status-dot--reconnecting { background: #f97316; }
.bc-status-dot--connected    { background: #22c55e; }
.bc-status-text { font-size: 26rpx; color: #64748b; }

/* 连接卡片（未连接状态） */
.bc-connect-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-top: 24rpx;
}
.bc-connect-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}
.bc-code-input {
  width: 100%;
  height: 88rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 48rpx;
  font-weight: 800;
  color: #0f172a;
  text-align: center;
  letter-spacing: 16rpx;
  margin-bottom: 32rpx;
  background: #f8fafc;
  box-sizing: border-box;
}
.bc-primary-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #22c55e, #16a34a);
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(22,163,74,0.22);
}

/* 加载状态 */
.bc-loading-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.bc-spinner {
  width: 72rpx;
  height: 72rpx;
  border: 6rpx solid #e2e8f0;
  border-top-color: #3b82f6;
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }
.bc-loading-text { font-size: 28rpx; color: #64748b; }

/* 比分大字 */
.bc-score-root {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
  padding-top: 12rpx;
}
.bc-connection-pill {
  align-self: flex-start;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: #e2e8f0;
  border-radius: 999rpx;
  padding: 10rpx 18rpx;
  margin-bottom: 16rpx;
}
.bc-connection-pill__label {
  font-size: 20rpx;
  color: #64748b;
}
.bc-connection-pill__value {
  font-size: 28rpx;
  line-height: 1;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 6rpx;
}
.bc-score-board {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 32rpx;
  width: 100%;
  padding: 36rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
  margin-bottom: 16rpx;
  box-sizing: border-box;
}
.bc-team-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.bc-team-label { font-size: 26rpx; color: #94a3b8; }
.bc-score-big {
  font-size: 112rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1;
}
.bc-colon {
  font-size: 72rpx;
  font-weight: 800;
  color: #cbd5e1;
  padding: 0 8rpx;
  padding-bottom: 16rpx;
}

/* 元数据条 */
.bc-meta-strip {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  width: 100%;
  padding: 18rpx 0;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  margin-bottom: 20rpx;
}
.bc-meta-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.bc-meta-val { font-size: 32rpx; font-weight: 700; color: #1e293b; }
.bc-meta-key { font-size: 18rpx; color: #94a3b8; }
.bc-meta-sep { font-size: 28rpx; color: #e2e8f0; }

/* 异常帧提示 */
.bc-anomaly {
  align-self: flex-start;
  font-size: 22rpx;
  color: #f59e0b;
  margin-bottom: 12rpx;
}

.bc-debug-card {
  width: 100%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 16rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
  box-sizing: border-box;
  margin-bottom: 18rpx;
}
.bc-debug-grid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
  margin-bottom: 10rpx;
}
.bc-debug-item {
  flex: 1;
  min-width: 0;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 12rpx 14rpx;
}
.bc-debug-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}
.bc-debug-row + .bc-debug-row {
  margin-top: 10rpx;
}
.bc-debug-key {
  font-size: 20rpx;
  color: #94a3b8;
  flex-shrink: 0;
}
.bc-debug-val {
  font-size: 20rpx;
  color: #334155;
  text-align: right;
  word-break: break-all;
}
.bc-debug-val--strong {
  font-size: 26rpx;
  font-weight: 700;
}

/* 断开按钮 */
.bc-disconnect-btn {
  margin-top: auto;
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: #f1f5f9;
  color: #ef4444;
}
