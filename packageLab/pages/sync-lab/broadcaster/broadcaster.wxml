<!-- 直播端 -->
<view class="bc-root" style="padding-top: {{statusBarHeight}}px;">

  <!-- 状态栏 -->
  <view class="bc-status-bar">
    <view class="bc-status-dot bc-status-dot--{{bleState}}"></view>
    <text class="bc-status-text">{{bleStateText}}{{connectedName ? ' · ' + connectedName : ''}}</text>
  </view>

  <!-- 未连接：输入匹配码 -->
  <view class="bc-connect-card" wx:if="{{bleState === 'idle'}}">
    <text class="bc-connect-label">采集端匹配码</text>
    <input
      class="bc-code-input"
      type="number"
      maxlength="4"
      placeholder="输入4位数字"
      value="{{matchCodeInput}}"
      bindinput="onMatchCodeInput"
    />
    <view class="bc-primary-btn" bindtap="onConnectTap">搜索并连接</view>
  </view>

  <!-- 扫描 / 连接中 -->
  <view class="bc-loading-card" wx:elif="{{bleState === 'scanning' || bleState === 'connecting' || bleState === 'reconnecting'}}">
    <view class="bc-spinner"></view>
    <text class="bc-loading-text">{{bleStateText}}</text>
  </view>

  <!-- 已连接：比分大字显示 -->
  <view class="bc-score-root" wx:elif="{{bleState === 'connected'}}">

    <view class="bc-connection-pill" wx:if="{{matchCodeInput}}">
      <text class="bc-connection-pill__label">匹配码</text>
      <text class="bc-connection-pill__value">{{matchCodeInput}}</text>
    </view>

    <view class="bc-score-board">
      <!-- 主队 -->
      <view class="bc-team-col">
        <text class="bc-team-label">主队</text>
        <text class="bc-score-big">{{homeScore}}</text>
      </view>
      <view class="bc-colon">:</view>
      <!-- 客队 -->
      <view class="bc-team-col">
        <text class="bc-team-label">客队</text>
        <text class="bc-score-big">{{awayScore}}</text>
      </view>
    </view>

    <!-- 时间 / 节次 / 24s -->
    <view class="bc-meta-strip">
      <view class="bc-meta-item">
        <text class="bc-meta-val">Q{{period}}</text>
        <text class="bc-meta-key">节次</text>
      </view>
      <view class="bc-meta-sep">|</view>
      <view class="bc-meta-item">
        <text class="bc-meta-val">{{minutes}}:{{seconds < 10 ? '0' : ''}}{{seconds}}</text>
        <text class="bc-meta-key">时间</text>
      </view>
      <view class="bc-meta-sep">|</view>
      <view class="bc-meta-item">
        <text class="bc-meta-val">{{shotClock}}s</text>
        <text class="bc-meta-key">进攻</text>
      </view>
    </view>

    <!-- 异常提示 -->
    <view class="bc-anomaly" wx:if="{{anomalyHint}}">{{anomalyHint}}</view>

    <view class="bc-debug-card" wx:if="{{debugMode}}">
      <view class="bc-debug-grid">
        <view class="bc-debug-item">
          <text class="bc-debug-key">收包</text>
          <text class="bc-debug-val bc-debug-val--strong">{{rxPacketCount}}</text>
        </view>
        <view class="bc-debug-item">
          <text class="bc-debug-key">最近接收</text>
          <text class="bc-debug-val">{{lastRxAtText || '--:--:--'}}</text>
        </view>
      </view>
      <view class="bc-debug-row">
        <text class="bc-debug-key">最近帧</text>
        <text class="bc-debug-val">{{lastFrameText || '等待数据'}}</text>
      </view>
    </view>

    <view class="bc-disconnect-btn" bindtap="onDisconnectTap">断开连接</view>
  </view>

</view>
