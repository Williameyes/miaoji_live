/* 采集端：暗黑数字控制台上下分屏布局 */
page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #111111;
}

.col-root {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #111111;
  color: #f5f5f5;
}

.col-ocr-vk-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.col-locked {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #111111;
}

.col-locked-icon {
  font-size: 34rpx;
  font-weight: 900;
  color: #facc15;
  letter-spacing: 4rpx;
}

.col-locked-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.58);
}

.col-shell {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: #111111;
}

/* 相机全屏渲染：保持 UI 百分比坐标与 onCameraFrame 底层帧一致 */
.col-viewfinder {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: #050505;
  z-index: 1;
}

.col-camera-full {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  z-index: 1;
}

.col-roi-layer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  overflow: visible;
  z-index: 30;
  pointer-events: none;
}

.col-roi-box {
  position: relative;
  border: 3rpx solid rgba(250, 204, 21, 0.95);
  background: rgba(250, 204, 21, 0.05);
  box-sizing: border-box;
  overflow: visible;
  z-index: 31;
  pointer-events: auto;
}

.col-roi-box--sel {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.12);
}

.col-roi-tag {
  display: inline-block;
  padding: 2rpx 8rpx;
  font-size: 18rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.72);
}

.col-roi-raw {
  position: absolute;
  top: -24rpx;
  left: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  color: rgba(74, 222, 128, 0.62);
  pointer-events: none;
}

.col-roi-handle-se {
  position: absolute;
  right: -14rpx;
  bottom: -14rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #38bdf8;
  border: 4rpx solid #ffffff;
  box-shadow: 0 0 0 14rpx rgba(56, 189, 248, 0.2);
  pointer-events: auto;
}

.col-ocr-hint {
  position: absolute;
  top: 12px;
  left: 15px;
  z-index: 41;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
  color: #dbeafe;
  background: rgba(15, 23, 42, 0.62);
}

.col-debug-panel {
  position: absolute;
  top: 12px;
  right: 15px;
  z-index: 41;
  max-width: 320rpx;
  padding: 8rpx 10rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.66);
  border: 1rpx solid rgba(163, 230, 53, 0.22);
}

.col-debug-text {
  font-size: 14rpx;
  line-height: 1.35;
  color: #a3e635;
  word-break: break-all;
}

/* 底部操作台：遮盖相机底部，不改变相机物理渲染坐标系 */
.col-console {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 35vh;
  z-index: 10;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #111111;
  border-top: 2rpx solid rgba(250, 204, 21, 0.22);
  box-sizing: border-box;
}

.col-console-status {
  height: 28px;
  flex-shrink: 0;
  padding: 0 12px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  background: #101010;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  box-sizing: border-box;
}

.col-status-left,
.col-status-right {
  min-width: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6px;
}

.col-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.col-status-dot--ok {
  background: #22c55e;
  box-shadow: 0 0 8px rgba(34, 197, 94, 0.78);
}

.col-status-dot--bad {
  background: #ef4444;
  box-shadow: 0 0 8px rgba(239, 68, 68, 0.72);
}

.col-status-text,
.col-status-code,
.col-status-ocr {
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 20rpx;
  line-height: 1;
  color: rgba(255, 255, 255, 0.78);
}

.col-status-code {
  max-width: none;
  color: #facc15;
  font-weight: 800;
}

.col-status-code--muted {
  color: rgba(255, 255, 255, 0.5);
}

.col-status-ocr {
  padding: 2px 6px;
  border-radius: 999px;
  color: #bbf7d0;
  background: rgba(34, 197, 94, 0.18);
}

.col-status-new-room {
  padding: 4px 8px;
  border-radius: 999px;
  font-size: 18rpx;
  line-height: 1;
  font-weight: 900;
  color: #111111;
  background: #facc15;
  white-space: nowrap;
}

.col-zoom-section {
  height: 44px;
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 4rpx 20rpx;
  box-sizing: border-box;
  background: #111111;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.col-zoom-slider-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
}

.col-zoom-slider {
  flex: 1;
  min-width: 0;
  margin: 0;
  padding: 0;
}

.col-monitor {
  height: 42px;
  flex-shrink: 0;
  margin: 6rpx 18rpx;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222222;
  border: 2rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: inset 0 0 28rpx rgba(0, 0, 0, 0.42);
  box-sizing: border-box;
}

.col-monitor-text {
  width: 100%;
  padding: 0 16rpx;
  box-sizing: border-box;
  font-family: ui-monospace, Menlo, Monaco, Consolas, monospace;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.1;
  color: #f8fafc;
  text-align: center;
  white-space: nowrap;
}

.col-ocr-toggles {
  display: flex;
  gap: 8px;
  padding: 0 18rpx 6rpx;
  box-sizing: border-box;
}

.col-ocr-toggle {
  flex: 1;
  min-height: 34px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: #1f1f1f;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 12px;
  box-sizing: border-box;
}

.col-ocr-toggle--on {
  border-color: rgba(250, 204, 21, 0.55);
  background: rgba(250, 204, 21, 0.12);
}

.col-ocr-toggle-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #e5e7eb;
}

.col-ocr-toggle-state {
  font-size: 22rpx;
  font-weight: 900;
  color: #94a3b8;
}

.col-ocr-toggle--on .col-ocr-toggle-state {
  color: #facc15;
}

.col-profile-row {
  display: flex;
  gap: 8px;
  padding: 0 18rpx 6rpx;
  box-sizing: border-box;
}

.col-profile-btn {
  flex: 1;
  min-height: 32px;
  border-radius: 8px;
  border: 1px solid rgba(255, 255, 255, 0.14);
  background: #1a1a1a;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #94a3b8;
  box-sizing: border-box;
}

.col-profile-btn--active {
  border-color: rgba(96, 165, 250, 0.6);
  background: rgba(59, 130, 246, 0.18);
  color: #93c5fd;
}

.col-action-grid {
  flex: 1;
  min-height: 92px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: 42px 42px 42px;
  gap: 8px 10px;
  padding: 7px 10px 9px;
  box-sizing: border-box;
}

.col-console-btn {
  min-height: 40px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 1.1;
  text-align: center;
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.28);
}

.col-console-btn--success {
  background: #16a34a;
}

.col-console-btn--danger {
  background: #dc2626;
}

.col-console-btn--primary {
  background: #2563eb;
}

.col-console-btn--warning {
  background: #b45309;
}

.col-console-btn--preset-save {
  background: #2f2f2f;
}

.col-console-btn--preset-load {
  background: #1d4ed8;
}

.col-console-btn--audit-export {
  grid-column: 1 / -1;
  background: #475569;
}

.col-console-btn--pressed {
  opacity: 0.86;
  transform: scale(0.97);
  box-shadow: inset 0 8rpx 20rpx rgba(0, 0, 0, 0.36);
}
