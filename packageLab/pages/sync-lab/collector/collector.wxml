<!-- 采集端：暗黑数字控制台上下分屏布局 -->
<!-- 登录 + 白名单双重门控：未授权用户页面内容完全不渲染 -->
<view class="col-root">
  <canvas type="webgl" id="ocrVkCanvas" class="col-ocr-vk-canvas"></canvas>

  <view class="col-locked" wx:if="{{!isLogin || !isInWhitelist}}">
    <view class="col-locked-icon">LOCK</view>
    <view class="col-locked-text">需要登录或权限</view>
  </view>

  <view wx:if="{{isLogin && isInWhitelist}}" class="col-shell">
    <!-- 上半部分：取景与采集区 -->
    <view class="col-viewfinder">
      <camera
        wx:if="{{cameraMounted}}"
        class="col-camera-full"
        device-position="back"
        flash="off"
        zoom="{{cameraZoom}}"
        mode="normal"
        resolution="medium"
        frame-size="medium"
        binderror="onCameraError"
        bindinitdone="onCameraInit"
      ></camera>

      <view class="col-ocr-hint" wx:if="{{ocrEnabled || ocrTransitioning}}">
        OCR 调试中
      </view>

      <view class="col-debug-panel" wx:if="{{debugMode && debugText}}">
        <view class="col-debug-text">{{debugText}}</view>
      </view>
    </view>

    <view class="col-roi-layer">
      <view
        wx:for="{{rois}}"
        wx:key="label"
        class="col-roi-box{{selectedRoiIdx === index ? ' col-roi-box--sel' : ''}}"
        style="position:absolute;{{item.pctStyle}}"
        data-idx="{{index}}"
        catchtouchstart="onRoiBodyTouchStart"
        catchtouchmove="onRoiBodyTouchMove"
        catchtouchend="onRoiTouchEnd"
        catchtouchcancel="onRoiTouchEnd"
      >
        <view class="col-roi-tag">{{item.label}}</view>
        <text class="col-roi-raw">{{item.rawText}}</text>
        <view
          class="col-roi-handle-se"
          data-idx="{{index}}"
          catchtouchstart="onRoiResizeTouchStart"
          catchtouchmove="onRoiResizeTouchMove"
          catchtouchend="onRoiTouchEnd"
          catchtouchcancel="onRoiTouchEnd"
        ></view>
      </view>
    </view>

    <!-- 下半部分：纯黑数字控制台 -->
    <view class="col-console">
      <view
        class="col-console-status"
        bindlongpress="onExportCollectorLogs"
        show-menu-by-longpress="{{false}}"
      >
        <view class="col-status-left">
          <view class="col-status-dot{{wsState === 'connected' ? ' col-status-dot--ok' : ' col-status-dot--bad'}}"></view>
          <text class="col-status-text">{{wsStateText}}</text>
          <text class="col-status-ocr" wx:if="{{ocrTransitioning}}">OCR 切换中</text>
          <text class="col-status-ocr" wx:elif="{{ocrEnabled}}">OCR 实时</text>
        </view>
        <view class="col-status-right">
          <text class="col-status-code" wx:if="{{matchCode}}">房间码：{{matchCode}}</text>
          <text class="col-status-code col-status-code--muted" wx:else>房间码：未生成</text>
          <view
            wx:if="{{wsState !== 'idle'}}"
            class="col-status-new-room"
            catchtap="onNewRoomTap"
          >新房间</view>
        </view>
      </view>

      <view class="col-zoom-section">
        <view class="col-zoom-slider-wrap">
          <slider
            class="col-zoom-slider"
            min="1"
            max="4"
            step="0.1"
            value="{{cameraZoom}}"
            bindchange="onCameraZoomChange"
            show-value="{{false}}"
            backgroundColor="#2b2b2b"
            activeColor="#facc15"
            block-size="20"
          />
        </view>
      </view>

      <view
        class="col-monitor"
        bindlongpress="onToggleDebug"
        show-menu-by-longpress="{{false}}"
      >
        <text class="col-monitor-text">主: {{ homeScore }} | 客: {{ awayScore }} | 倒计时: {{ minutes }}:{{ seconds < 10 ? '0' + seconds : seconds }}</text>
      </view>

      <view class="col-action-grid">
        <view
          class="col-console-btn col-console-btn--ocr{{ocrEnabled ? ' col-console-btn--danger' : ' col-console-btn--success'}}"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onToggleOcr"
        >{{ocrTransitioning ? 'OCR 切换中' : (ocrEnabled ? '关闭 OCR' : '开启 OCR')}}</view>

        <view
          class="col-console-btn col-console-btn--preset-save"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onSavePreset"
        >保存预设</view>

        <view
          wx:if="{{wsState === 'connected'}}"
          class="col-console-btn col-console-btn--sync col-console-btn--warning"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onStopTap"
        >停止同步</view>
        <view
          wx:else
          class="col-console-btn col-console-btn--sync col-console-btn--primary"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onStartTap"
        >开启同步</view>

        <view
          class="col-console-btn col-console-btn--preset-load"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onLoadPreset"
        >恢复预设</view>

        <view
          class="col-console-btn col-console-btn--audit-export"
          hover-class="col-console-btn--pressed"
          hover-stay-time="80"
          catchtap="onExportCollectorAuditFile"
        >导出审计</view>
      </view>
    </view>
  </view>
</view>
