<!-- 采集端：暗黑数字控制台上下分屏布局 -->
<!-- 登录 + 白名单双重门控：未授权用户页面内容完全不渲染 -->
<view class="col-root">
  <canvas type="webgl" id="ocrVkCanvas" class="col-ocr-vk-canvas"></canvas>
  <canvas type="2d" id="cropProcessorCanvas" style="position: fixed; left: -9999px; top: -9999px; width: 240px; height: 80px;"></canvas>

  <view class="col-locked" wx:if="{{!isLogin || !isInWhitelist}}">
    <view class="col-locked-icon">LOCK</view>
    <view class="col-locked-text">需要登录或权限</view>
  </view>

  <view wx:if="{{isLogin && isInWhitelist}}" class="col-shell">
    <!-- 上半部分：取景与采集区 -->
    <view class="col-viewfinder">
      <camera
        wx:if="{{cameraMounted}}"
        class="col-camera-full"
        device-position="back"
        flash="off"
        zoom="{{cameraZoom}}"
        mode="normal"
        resolution="medium"
        frame-size="medium"
        binderror="onCameraError"
        bindinitdone="onCameraInit"
      ></camera>

      <view class="col-ocr-hint" style="background: {{timeSyncMode === 'crop_image' ? 'rgba(16, 185, 129, 0.9)' : 'rgba(37, 99, 235, 0.85)'}}; font-weight: bold;">
        {{timeSyncMode === 'crop_image' ? '📷 实时切图模式：拖动黄色 [时间] 框对准计分牌倒计时' : (ocrEnabled ? 'OCR 实时识别中' : 'OCR 待开启')}}
      </view>

      <view class="col-debug-panel" wx:if="{{debugMode && debugText}}">
        <view class="col-debug-text">{{debugText}}</view>
      </view>
    </view>

    <view class="col-roi-layer">
      <view
        wx:for="{{rois}}"
        wx:key="label"
        wx:if="{{timeSyncMode !== 'crop_image' || item.label === '时间'}}"
        class="col-roi-box{{selectedRoiIdx === index ? ' col-roi-box--sel' : ''}}"
        style="position:absolute;{{item.pctStyle}}"
        data-idx="{{index}}"
        catchtouchstart="onRoiBodyTouchStart"
        catchtouchmove="onRoiBodyTouchMove"
        catchtouchend="onRoiTouchEnd"
        catchtouchcancel="onRoiTouchEnd"
      >
        <view class="col-roi-tag">{{item.label}}</view>
        <text class="col-roi-raw">{{item.rawText}}</text>
        <view
          class="col-roi-handle-se"
          data-idx="{{index}}"
          catchtouchstart="onRoiResizeTouchStart"
          catchtouchmove="onRoiResizeTouchMove"
          catchtouchend="onRoiTouchEnd"
          catchtouchcancel="onRoiTouchEnd"
        ></view>
      </view>
    </view>

    <!-- 下半部分：纯黑数字控制台 -->
    <view class="col-console">
      <view
        class="col-console-status"
        bindlongpress="onExportCollectorLogs"
        show-menu-by-longpress="{{false}}"
      >
        <view class="col-status-left">
          <view class="col-status-dot{{wsState === 'connected' ? ' col-status-dot--ok' : ' col-status-dot--bad'}}"></view>
          <text class="col-status-text">{{wsStateText}}</text>
          <view
            class="col-status-ocr"
            style="background: {{timeSyncMode === 'crop_image' ? '#10b981' : '#2563eb'}}; color: #fff; margin-left: 6px; padding: 2px 6px; border-radius: 4px;"
            catchtap="onTimeSyncModeSwitch"
          >{{timeSyncMode === 'crop_image' ? '切图同步' : 'OCR模式'}} ↺</view>
        </view>
        <view class="col-status-right">
          <text class="col-status-code" wx:if="{{matchCode}}">房间码：{{matchCode}}</text>
          <text class="col-status-code col-status-code--muted" wx:else>房间码：未生成</text>
          <view
            wx:if="{{wsState !== 'idle'}}"
            class="col-status-new-room"
            catchtap="onNewRoomTap"
          >新房间</view>
        </view>
      </view>

      <view class="col-zoom-section">
        <view class="col-zoom-slider-wrap">
          <slider
            class="col-zoom-slider"
            min="1"
            max="4"
            step="0.1"
            value="{{cameraZoom}}"
            bindchange="onCameraZoomChange"
            show-value="{{false}}"
            backgroundColor="#2b2b2b"
            activeColor="#facc15"
            block-size="20"
          />
        </view>
      </view>

      <view
        class="col-monitor"
        bindlongpress="onToggleDebug"
        show-menu-by-longpress="{{false}}"
      >
        <text class="col-monitor-text">{{timeSyncMode === 'crop_image' ? ('时间切图模式 | 房间: ' + (matchCode || '未连房')) : (ocrDisplayProfileLabel + ' | 主: ' + homeScore + ' | 客: ' + awayScore + ' | 倒计时: ' + minutes + ':' + (seconds < 10 ? '0' + seconds : seconds))}}</text>
      </view>

      <view class="col-profile-row" wx:if="{{timeSyncMode !== 'crop_image'}}">
        <view
          class="col-profile-btn{{ocrDisplayProfile === 'led' ? ' col-profile-btn--active' : ''}}"
          data-profile="led"
          catchtap="onSelectDisplayProfile"
        >LED大屏</view>
        <view
          class="col-profile-btn{{ocrDisplayProfile === '7segment' ? ' col-profile-btn--active' : ''}}"
          data-profile="7segment"
          catchtap="onSelectDisplayProfile"
        >7段数码管</view>
      </view>

      <view class="col-ocr-toggles" wx:if="{{timeSyncMode !== 'crop_image'}}">
        <view
          class="col-ocr-toggle{{ocrEnableTime ? ' col-ocr-toggle--on' : ''}}"
          catchtap="onToggleOcrEnableTime"
        >
          <text class="col-ocr-toggle-label">剩余时间</text>
          <text class="col-ocr-toggle-state">{{ocrEnableTime ? '开' : '关'}}</text>
        </view>
        <view
          class="col-ocr-toggle{{ocrEnableScore ? ' col-ocr-toggle--on' : ''}}"
          catchtap="onToggleOcrEnableScore"
        >
          <text class="col-ocr-toggle-label">比分</text>
          <text class="col-ocr-toggle-state">{{ocrEnableScore ? '开' : '关'}}</text>
        </view>
      </view>

      <block wx:if="{{timeSyncMode === 'crop_image'}}">
        <view class="col-action-grid">
          <view
            wx:if="{{wsState === 'connected'}}"
            class="col-console-btn col-console-btn--sync col-console-btn--warning"
            style="grid-column: 1 / -1;"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onStopTap"
          >停止切图同步</view>
          <view
            wx:else
            class="col-console-btn col-console-btn--sync col-console-btn--primary"
            style="grid-column: 1 / -1;"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onStartTap"
          >开启切图同步</view>

          <view
            class="col-console-btn col-console-btn--preset-save"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onSavePreset"
          >保存预设</view>

          <view
            class="col-console-btn col-console-btn--preset-load"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onLoadPreset"
          >恢复预设</view>

          <view
            class="col-console-btn col-console-btn--audit-export"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onExportCollectorAuditFile"
          >导出审计</view>
        </view>
      </block>

      <block wx:else>
        <view class="col-action-grid">
          <view
            class="col-console-btn col-console-btn--ocr{{ocrEnabled ? ' col-console-btn--danger' : ' col-console-btn--success'}}"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onToggleOcr"
          >{{ocrTransitioning ? 'OCR 切换中' : (ocrEnabled ? '关闭 OCR' : '开启 OCR')}}</view>

          <view
            class="col-console-btn col-console-btn--preset-save"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onSavePreset"
          >保存预设</view>

          <view
            wx:if="{{wsState === 'connected'}}"
            class="col-console-btn col-console-btn--sync col-console-btn--warning"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onStopTap"
          >停止同步</view>
          <view
            wx:else
            class="col-console-btn col-console-btn--sync col-console-btn--primary"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onStartTap"
          >开启同步</view>

          <view
            class="col-console-btn col-console-btn--preset-load"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onLoadPreset"
          >恢复预设</view>

          <view
            class="col-console-btn col-console-btn--audit-export"
            hover-class="col-console-btn--pressed"
            hover-stay-time="80"
            catchtap="onExportCollectorAuditFile"
          >导出审计</view>
        </view>
      </block>
    </view>
  </view>
</view>
