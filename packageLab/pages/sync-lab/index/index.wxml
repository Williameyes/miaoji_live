<!-- sync-lab 入口：角色选择，风格对齐 mine 页浅色卡片设计 -->
<view class="sl-root">

  <!-- 顶部说明区 -->
  <view class="sl-header">
    <view class="sl-kicker">实验功能 · 内测</view>
    <view class="sl-title">自动记分同步</view>
    <view class="sl-sub">OCR 识别场馆记分牌，通过蓝牙将比分实时推送至直播端</view>
  </view>

  <!-- 角色卡片 -->
  <view class="sl-cards">

    <!-- 采集端 -->
    <view class="sl-card" bindtap="onGoCollector" hover-class="sl-card-hover">
      <view class="sl-card-left">
        <view class="sl-card-icon-wrap sl-card-icon-wrap--blue">
          <text class="sl-card-icon">📷</text>
        </view>
      </view>
      <view class="sl-card-body">
        <view class="sl-card-title">我是采集端</view>
        <view class="sl-card-desc">对准记分牌识别，广播比分数据</view>
      </view>
      <text class="sl-card-arrow">›</text>
    </view>

    <!-- 直播端 -->
    <view class="sl-card" bindtap="onGoBroadcaster" hover-class="sl-card-hover">
      <view class="sl-card-left">
        <view class="sl-card-icon-wrap sl-card-icon-wrap--green">
          <text class="sl-card-icon">📺</text>
        </view>
      </view>
      <view class="sl-card-body">
        <view class="sl-card-title">我是直播端</view>
        <view class="sl-card-desc">连接采集端，实时同步比分到直播</view>
      </view>
      <text class="sl-card-arrow">›</text>
    </view>

  </view>

  <!-- 底部提示 -->
  <view class="sl-notice">
    <text class="sl-notice-icon">⚠️</text>
    <text class="sl-notice-text">两端须同时打开小程序并保持屏幕常亮</text>
  </view>

</view>
