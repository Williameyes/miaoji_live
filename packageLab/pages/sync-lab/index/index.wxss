/* sync-lab 入口页 — 对齐 mine 页浅色卡片设计语言 */

.sl-root {
  min-height: 100vh;
  background: #f8fafc;
  padding: 48rpx 40rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ── 顶部说明区 ── */
.sl-header {
  margin-bottom: 48rpx;
}

.sl-kicker {
  font-size: 20rpx;
  letter-spacing: 0.14em;
  color: #f59e0b;
  font-weight: 600;
  margin-bottom: 12rpx;
  text-transform: uppercase;
}

.sl-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: -0.5rpx;
  margin-bottom: 16rpx;
}

.sl-sub {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
}

/* ── 角色卡片列表 ── */
.sl-cards {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  margin-bottom: 32rpx;
}

/* 卡片行：横向布局对齐 mine 的 list-item */
.sl-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #f1f5f9;
  transition: background 0.1s;
}

.sl-card:last-child {
  border-bottom: none;
}

.sl-card-hover {
  background-color: #f1f5f9;
}

/* 左侧彩色图标圆圈 */
.sl-card-left {
  flex-shrink: 0;
  margin-right: 28rpx;
}

.sl-card-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.sl-card-icon-wrap--blue {
  background: #dbeafe;
}

.sl-card-icon-wrap--green {
  background: #dcfce7;
}

.sl-card-icon {
  font-size: 40rpx;
  line-height: 1;
}

/* 正文 */
.sl-card-body {
  flex: 1;
  min-width: 0;
}

.sl-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.sl-card-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.4;
}

/* 右侧箭头 */
.sl-card-arrow {
  font-size: 40rpx;
  color: #cbd5e1;
  line-height: 1;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ── 底部提示 ── */
.sl-notice {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 10rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 16rpx;
  padding: 22rpx 28rpx;
}

.sl-notice-icon {
  font-size: 26rpx;
  line-height: 1.5;
  flex-shrink: 0;
}

.sl-notice-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.5;
}
