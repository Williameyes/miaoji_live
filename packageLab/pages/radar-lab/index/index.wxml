<!-- 直播雷达实验室入口 -->
<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">实验功能 · 内测</view>
    <view class="rl-title">直播雷达控制台</view>
    <view class="rl-sub">赛事资产维护、热度监测、推广监测与完赛战报（仅白名单）</view>
  </view>

  <view class="rl-card">
    <view class="rl-list-item" bindtap="onGoTournament" hover-class="rl-list-item-hover">
      <view class="rl-list-main">
        <view class="rl-list-title">🏆 赛事维护</view>
        <view class="rl-list-desc">创建与编辑赛事，查看排期与影响力概览</view>
      </view>
      <text class="rl-list-arrow">›</text>
    </view>
    <view class="rl-list-item" bindtap="onGoOam" hover-class="rl-list-item-hover">
      <view class="rl-list-main">
        <view class="rl-list-title">📋 场次维护</view>
        <view class="rl-list-desc">以场次为主线：列表管理、挂载监控、批量排程</view>
      </view>
      <text class="rl-list-arrow">›</text>
    </view>
    <view class="rl-list-item" bindtap="onGoMonitor" hover-class="rl-list-item-hover">
      <view class="rl-list-main">
        <view class="rl-list-title">📈 热度监测</view>
        <view class="rl-list-desc">纯热度采集中场次，不含广告/推广配置</view>
      </view>
      <text class="rl-list-arrow">›</text>
    </view>
    <view class="rl-list-item" bindtap="onGoPromo" hover-class="rl-list-item-hover">
      <view class="rl-list-main">
        <view class="rl-list-title">📣 推广监测</view>
        <view class="rl-list-desc">广告/推广场次：发布广场、生成小程序码、审批申请</view>
      </view>
      <text class="rl-list-arrow">›</text>
    </view>
    <view class="rl-list-item" bindtap="onGoPoster" hover-class="rl-list-item-hover">
      <view class="rl-list-main">
        <view class="rl-list-title">🎨 战报宣发</view>
        <view class="rl-list-desc">整届赛事影响力海报生成与保存相册</view>
      </view>
      <text class="rl-list-arrow">›</text>
    </view>
  </view>

  <view class="rl-notice">
    <text class="rl-notice-text">本功能为实验/内测，仅对白名单运营开放；关闭监控将同时结束该场次全部雷达任务。</text>
  </view>

</view>
