<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">完赛宣发</view>
    <view class="rl-title">影响力战报海报</view>
    <view class="rl-sub">聚合整届赛事场观、峰值与影响力得分，生成卡通风海报</view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="rl-field" wx:if="{{tournaments.length}}">
        <text class="rl-label">选择赛事</text>
        <picker mode="selector" range="{{tournaments}}" range-key="name" bindchange="onTournamentPicker">
          <view class="rl-input rl-picker-display">{{tournamentName || '请选择赛事'}}</view>
        </picker>
      </view>
      <view class="rl-empty" wx:else>暂无赛事，请先在数据维护中创建赛事</view>
      <button class="rl-btn rl-btn-primary" disabled="{{loading}}" bindtap="onGeneratePoster">生成战报海报</button>
    </view>
  </view>

  <view class="rl-card" wx:if="{{previewPath}}">
    <view class="rl-card-inner">
      <view class="rl-section-title">预览</view>
      <image class="poster-preview" src="{{previewPath}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
      <button class="rl-btn rl-btn-secondary" style="margin-top:24rpx;" bindtap="onSavePoster">保存到相册</button>
    </view>
  </view>

  <!-- 离屏 Canvas（不可见） -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas-offscreen"></canvas>

</view>
