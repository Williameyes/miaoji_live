/* packageLab/pages/radar-lab/score-sniffer/index.wxss */
@import '../common/common.wxss';

/* 标题行与徽章对其 */
.rl-section-header-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.rl-section-header-row .rl-section-title {
  margin-bottom: 0;
}

/* =========================================================================
 * 1. 首帧半自动标注卡片 (ROI Annotation)
 * ========================================================================= */
.frame-loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 32rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  border: 2rpx dashed #cbd5e1;
  text-align: center;
}

.loading-pulse-ring {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #dbeafe;
  border-top-color: #2563eb;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.loading-sub {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  max-width: 480rpx;
}

/* 缩放工具栏 */
.zoom-toolbar {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.zoom-toolbar-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.zoom-btn-group {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}

.zoom-btn {
  padding: 8rpx 18rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  transition: all 0.15s ease-out;
}

.zoom-btn.active {
  background: #2563eb;
  color: #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.25);
}

/* 标注画板容器与缩放 Stage */
.sniffer-preview-container {
  position: relative;
  width: 100%;
  border-radius: 16rpx;
  overflow: hidden;
  border: 2rpx solid #e2e8f0;
  background-color: #0f172a;
  margin: 12rpx 0 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.sniffer-preview-container.is-zoomed {
  border-color: #3b82f6;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.15);
}

.sniffer-stage {
  position: relative;
  width: 100%;
  transform-origin: 50% 88%;
  transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.sniffer-bg-img {
  width: 100%;
  display: block;
}

.sniffer-marker {
  position: absolute;
  box-sizing: border-box;
  pointer-events: none;
  transition: all 0.08s ease-out;
  border-radius: 6rpx;
}

.sniffer-marker.marker-a {
  border: 4rpx solid #10b981;
  background-color: rgba(16, 185, 129, 0.28);
}

.sniffer-marker.marker-b {
  border: 4rpx solid #3b82f6;
  background-color: rgba(59, 130, 246, 0.28);
}

.marker-tag {
  position: absolute;
  top: -34rpx;
  left: 0;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  font-weight: 700;
  line-height: 1.4;
}

.marker-a .marker-tag {
  background-color: #10b981;
  color: #ffffff;
}

.marker-b .marker-tag {
  background-color: #3b82f6;
  color: #ffffff;
}

.slider-control-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.slider-control-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 16rpx 20rpx 8rpx;
}

.slider-info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6rpx;
}

.slider-name {
  font-size: 24rpx;
  color: #334155;
  font-weight: 600;
}

.stepper-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.step-btn {
  width: 48rpx !important;
  height: 48rpx !important;
  line-height: 44rpx !important;
  text-align: center;
  border-radius: 10rpx;
  background: #e2e8f0;
  color: #1e293b;
  font-size: 30rpx;
  font-weight: 700;
  padding: 0 !important;
  margin: 0 !important;
}

.slider-val {
  min-width: 72rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #2563eb;
}

.slider-val.val-a {
  color: #059669;
}

.slider-val.val-b {
  color: #2563eb;
}

.size-tuning-toggle {
  text-align: center;
  padding: 10rpx 0;
}

.size-tuning-toggle-text {
  font-size: 24rpx;
  color: #64748b;
  text-decoration: underline;
}

.size-tuning-box {
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.size-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.size-label {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

.btn-submit-roi {
  margin-top: 12rpx;
}

/* =========================================================================
 * 2. 实时比分对抗条看板 (Scoreboard Hero)
 * ========================================================================= */
.scoreboard-hero {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%);
  border: 1rpx solid #e2e8f0;
  border-radius: 20rpx;
  padding: 36rpx 24rpx;
  margin: 20rpx 0 28rpx;
}

.hero-team-box {
  flex: 1;
  text-align: center;
  min-width: 0;
}

.hero-team-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-score {
  font-size: 72rpx;
  font-weight: 900;
  line-height: 1;
  font-family: -apple-system, BlinkMacSystemFont, 'DIN Alternate', 'Impact', sans-serif;
}

.hero-score.score-a {
  color: #2563eb;
}

.hero-score.score-b {
  color: #f59e0b;
}

.hero-center-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
}

.hero-period-pill {
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 22rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.hero-vs {
  font-size: 28rpx;
  font-weight: 800;
  color: #94a3b8;
  margin: 8rpx 0;
  letter-spacing: 2rpx;
}

.hero-clock {
  font-size: 22rpx;
  color: #64748b;
  font-weight: 600;
}

.snapshot-preview-section {
  margin-top: 24rpx;
}

.snapshot-img-wrap {
  width: 100%;
  border-radius: 14rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
  background: #000;
}

.snapshot-img {
  width: 100%;
  display: block;
}

/* =========================================================================
 * 3. 候选轮次切分列表 (Candidates)
 * ========================================================================= */
.candidates-wrapper {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.candidate-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 1rpx solid #f1f5f9;
}

.candidate-main {
  flex: 1;
  min-width: 0;
}

.candidate-header-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.candidate-round-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #475569;
  background: #e2e8f0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.candidate-match-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.candidate-score-text {
  color: #2563eb;
  font-weight: 800;
  margin: 0 8rpx;
}

.candidate-action-wrap {
  margin-left: 20rpx;
}

.candidate-bind-btn {
  height: 64rpx !important;
  line-height: 64rpx !important;
  font-size: 24rpx !important;
  padding: 0 24rpx !important;
  border-radius: 12rpx !important;
}
