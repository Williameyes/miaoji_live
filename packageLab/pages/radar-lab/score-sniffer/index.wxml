<!-- packageLab/pages/radar-lab/score-sniffer/index.wxml -->
<view class="rl-root">

  <!-- ===================================================================== -->
  <!-- 模式 1: 任务列表主页 (viewMode === 'list')                               -->
  <!-- ===================================================================== -->
  <block wx:if="{{viewMode === 'list'}}">
    <view class="rl-header list-page-header">
      <view class="list-header-left">
        <view class="rl-kicker">雷达实验 · 比分嗅探</view>
        <view class="rl-title">嗅探任务中心</view>
        <view class="rl-sub">一播多场自动切分 · 单框智能追踪 · 低频比对</view>
      </view>
      <button class="rl-btn rl-btn-primary btn-quick-create" bindtap="onGoCreate">
        + 新增嗅探
      </button>
    </view>

    <!-- 任务列表容器 -->
    <view class="task-list-section">
      <!-- 加载中骨架 -->
      <view class="list-loading-state" wx:if="{{listLoading}}">
        <view class="loading-pulse-ring"></view>
        <text class="loading-text">正在获取嗅探任务列表...</text>
      </view>

      <!-- 列表为空 -->
      <view class="rl-card empty-card" wx:elif="{{!taskList || taskList.length === 0}}">
        <view class="rl-card-inner empty-inner">
          <view class="empty-icon">🏀</view>
          <view class="empty-title">暂无进行中的比分嗅探任务</view>
          <view class="empty-desc">粘贴抖音直播口令或直播间链接，即可发起智能记分牌追踪</view>
          <button class="rl-btn rl-btn-primary empty-btn" bindtap="onGoCreate">
            立即发起第一场嗅探
          </button>
        </view>
      </view>

      <!-- 任务列表卡片 -->
      <view class="task-cards-list" wx:else>
        <view 
          class="rl-card task-item-card" 
          wx:for="{{taskList}}" 
          wx:key="session_id"
          data-id="{{item.session_id}}"
          bindtap="onTapSessionItem"
        >
          <view class="rl-card-inner">
            <!-- 卡片头部: 主播与状态 -->
            <view class="task-card-header">
              <view class="task-anchor-wrap">
                <text class="task-anchor-name">{{item.anchor_name || '主播直播间'}}</text>
                <text class="task-sport-tag">{{item.sport_type === 'badminton' ? '羽毛球' : '篮球'}}</text>
              </view>
              <text class="rl-badge {{item.badge.cls}}">{{item.badge.text}}</text>
            </view>

            <!-- 卡片中央: 核心比分展示 -->
            <view class="task-card-score-banner">
              <view class="task-score-text {{item.status === 'awaiting_roi' ? 'text-awaiting' : ''}}">
                {{item.scoreDisplay}}
              </view>
            </view>

            <!-- 卡片底部: 时间与快捷操作 -->
            <view class="task-card-footer">
              <text class="task-time-text">创建于 {{item.createdAtStr}}</text>
              <view class="task-actions-wrap" catchtap="true">
                <button 
                  class="rl-btn rl-btn-secondary btn-mini-action" 
                  size="mini" 
                  wx:if="{{item.status === 'sniffing' || item.status === 'awaiting_roi' || item.status === 'reconnecting'}}"
                  data-id="{{item.session_id}}"
                  bindtap="onStopSessionFromList"
                >
                  停止
                </button>
                <button 
                  class="rl-btn {{item.status === 'awaiting_roi' ? 'rl-btn-primary' : 'rl-btn-secondary'}} btn-mini-action" 
                  size="mini"
                  data-id="{{item.session_id}}"
                  bindtap="onTapSessionItem"
                >
                  {{item.status === 'awaiting_roi' ? '去画框' : '查看详情'}}
                </button>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ===================================================================== -->
  <!-- 模式 2: 发起新嗅探任务 (viewMode === 'create')                            -->
  <!-- ===================================================================== -->
  <block wx:elif="{{viewMode === 'create'}}">
    <view class="top-nav-bar">
      <view class="nav-back-btn" bindtap="onBackToList">
        <text class="nav-back-arrow">←</text> 返回任务列表
      </view>
      <text class="nav-title">发起新嗅探</text>
    </view>

    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="rl-section-title">挂载抖音直播间</view>
        
        <view class="rl-field">
          <text class="rl-label">抖音分享口令 / 直播间网址</text>
          <textarea 
            class="rl-textarea" 
            placeholder="粘贴完整的抖音分享口令或 https://live.douyin.com/..." 
            value="{{rawText}}" 
            bindinput="onInputRawText"
          />
        </view>

        <view class="rl-field">
          <text class="rl-label">运动类型</text>
          <picker bindchange="onSportChange" value="{{sportIndex}}" range="{{sportOptions}}">
            <view class="rl-input rl-picker-display">
              {{sportOptions[sportIndex]}}
            </view>
          </picker>
        </view>

        <button 
          class="rl-btn rl-btn-primary" 
          loading="{{actionLoading}}" 
          bindtap="onSubmitCreateSniffer"
        >
          🚀 立即启动比分嗅探
        </button>
      </view>
    </view>
  </block>

  <!-- ===================================================================== -->
  <!-- 模式 3: 会话详情与画框监控面板 (viewMode === 'detail')                     -->
  <!-- ===================================================================== -->
  <block wx:elif="{{viewMode === 'detail'}}">
    <view class="top-nav-bar">
      <view class="nav-back-btn" bindtap="onBackToList">
        <text class="nav-back-arrow">←</text> 返回任务列表
      </view>
      <text class="nav-title">嗅探监控看板</text>
    </view>

    <!-- 会话基本概览卡片 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="rl-section-header-row">
          <view class="session-summary-left">
            <view class="rl-section-title">{{session.anchor_name || '抖音直播间'}}</view>
            <view class="session-meta-sub">会话: {{sessionId}}</view>
          </view>
          <view class="session-summary-right">
            <text class="rl-badge {{session.status === 'sniffing' ? 'rl-badge-ok' : (session.status === 'awaiting_roi' ? 'rl-badge-warn' : 'rl-badge-muted')}}">
              {{statusLabel}}
            </text>
          </view>
        </view>

        <view class="session-actions-bar" wx:if="{{isSniffing}}">
          <button class="rl-btn rl-btn-danger btn-stop-detail" size="mini" bindtap="onStopCurrentSession">
            停止当前嗅探
          </button>
        </view>
      </view>
    </view>

    <!-- 首帧单框标注卡片 (当状态为 awaiting_roi 时展示) -->
    <view class="rl-card" wx:if="{{session && session.status === 'awaiting_roi'}}">
      <view class="rl-card-inner">
        <view class="rl-section-header-row">
          <view class="rl-section-title">首帧记分牌画框标注</view>
          <text class="rl-badge rl-badge-warn">等待标注</text>
        </view>

        <!-- 首帧抓取中 Loading 骨架 -->
        <view class="frame-loading-card" wx:if="{{!session.init_frame_url}}">
          <view class="loading-pulse-ring"></view>
          <text class="loading-title">正在接入直播流截取首帧画面...</text>
          <text class="loading-sub">雷达节点正在建联抓取无黑屏首帧（约需 3~8 秒），完成后将在此显示画面以供圈出记分牌。</text>
        </view>

        <!-- 首帧已就绪：展示单一记分牌框画板与控制项 -->
        <block wx:else>
          <view class="rl-notice">
            <text class="rl-notice-text">💡 仅需画一个框！请调整下方单一蓝色框，将记分牌上的【队名、比分、节次】整体框入即可，操作简单快捷。</text>
          </view>

          <!-- 视角缩放工具栏 -->
          <view class="zoom-toolbar">
            <text class="zoom-toolbar-label">画面视角：</text>
            <view class="zoom-btn-group">
              <view class="zoom-btn {{zoomLevel === 1.0 ? 'active' : ''}}" bindtap="onSetZoom" data-zoom="1.0">1.0x 全景</view>
              <view class="zoom-btn {{zoomLevel === 1.8 ? 'active' : ''}}" bindtap="onSetZoom" data-zoom="1.8">1.8x 放大</view>
              <view class="zoom-btn {{zoomLevel === 2.5 ? 'active' : ''}}" bindtap="onSetZoom" data-zoom="2.5">2.5x 特写</view>
            </view>
          </view>

          <!-- 画板容器 (基于 Y 轴中心缩放) -->
          <view class="sniffer-preview-container {{zoomLevel > 1.0 ? 'is-zoomed' : ''}}">
            <view class="sniffer-stage" style="transform: scale({{zoomLevel}}); transform-origin: 50% {{roiYPercent}}%;">
              <image class="sniffer-bg-img" src="{{session.init_frame_url}}" mode="widthFix" />
              <!-- 单一记分牌全景框 -->
              <view 
                class="sniffer-marker marker-scoreboard" 
                style="top: {{roiYPercent}}%; left: {{roiXPercent}}%; width: {{roiWidthPercent}}%; height: {{roiHeightPercent}}%;"
              >
                <text class="marker-tag">🏀 记分牌全景识别区 (框住队名与比分整体)</text>
              </view>
            </view>
          </view>

          <!-- 单框调节控制器 -->
          <view class="slider-control-group">
            <!-- 垂直位置 (Y 轴) -->
            <view class="slider-control-item">
              <view class="slider-info-row">
                <text class="slider-name">上下垂直位置 (Y 轴)</text>
                <view class="stepper-wrap">
                  <button class="step-btn" size="mini" bindtap="onStepY" data-delta="-0.5">-</button>
                  <text class="slider-val">{{roiYPercent}}%</text>
                  <button class="step-btn" size="mini" bindtap="onStepY" data-delta="0.5">+</button>
                </view>
              </view>
              <slider min="50" max="98" step="0.5" value="{{roiYPercent}}" bindchange="onSliderYChange" activeColor="#2563eb" block-size="20" />
            </view>

            <!-- 水平位置 (X 轴) -->
            <view class="slider-control-item">
              <view class="slider-info-row">
                <text class="slider-name">左右水平位置 (X 轴)</text>
                <view class="stepper-wrap">
                  <button class="step-btn" size="mini" bindtap="onStepX" data-delta="-0.5">-</button>
                  <text class="slider-val">{{roiXPercent}}%</text>
                  <button class="step-btn" size="mini" bindtap="onStepX" data-delta="0.5">+</button>
                </view>
              </view>
              <slider min="0" max="60" step="0.5" value="{{roiXPercent}}" bindchange="onSliderXChange" activeColor="#3b82f6" block-size="20" />
            </view>

            <!-- 框选宽度 -->
            <view class="slider-control-item">
              <view class="slider-info-row">
                <text class="slider-name">记分牌框宽度 (Width)</text>
                <view class="stepper-wrap">
                  <button class="step-btn" size="mini" bindtap="onStepWidth" data-delta="-0.5">-</button>
                  <text class="slider-val">{{roiWidthPercent}}%</text>
                  <button class="step-btn" size="mini" bindtap="onStepWidth" data-delta="0.5">+</button>
                </view>
              </view>
              <slider min="20" max="98" step="0.5" value="{{roiWidthPercent}}" bindchange="onSliderWidthChange" activeColor="#0ea5e9" block-size="20" />
            </view>

            <!-- 框选高度 -->
            <view class="slider-control-item">
              <view class="slider-info-row">
                <text class="slider-name">记分牌框高度 (Height)</text>
                <view class="stepper-wrap">
                  <button class="step-btn" size="mini" bindtap="onStepHeight" data-delta="-0.5">-</button>
                  <text class="slider-val">{{roiHeightPercent}}%</text>
                  <button class="step-btn" size="mini" bindtap="onStepHeight" data-delta="0.5">+</button>
                </view>
              </view>
              <slider min="4" max="30" step="0.5" value="{{roiHeightPercent}}" bindchange="onSliderHeightChange" activeColor="#0ea5e9" block-size="20" />
            </view>

            <button class="rl-btn rl-btn-primary btn-submit-roi" loading="{{submittingRoi}}" bindtap="onSubmitRoiAnnotation">
              确认单框标注并启动监控
            </button>
          </view>
        </block>
      </view>
    </view>

    <!-- 实时比分英雄看板 (嗅探进行中时高亮展示) -->
    <view class="rl-card" wx:if="{{session && session.status !== 'awaiting_roi'}}">
      <view class="rl-card-inner">
        <view class="rl-section-header-row">
          <view class="rl-section-title">实时动态比分</view>
          <text class="rl-badge {{session.status === 'reconnecting' ? 'rl-badge-warn' : 'rl-badge-ok'}}">
            {{statusLabel}}
          </text>
        </view>

        <!-- 对抗大比分牌 -->
        <view class="scoreboard-hero">
          <view class="hero-team-box">
            <view class="hero-team-name">{{currentScore.team_a || '主队'}}</view>
            <view class="hero-score score-a">{{currentScore.score_a || 0}}</view>
          </view>

          <view class="hero-center-box">
            <view class="hero-period-pill">{{currentScore.period || '第1节'}}</view>
            <view class="hero-vs">VS</view>
            <view class="hero-clock">{{currentScore.clock || '进行中'}}</view>
          </view>

          <view class="hero-team-box">
            <view class="hero-team-name">{{currentScore.team_b || '客队'}}</view>
            <view class="hero-score score-b">{{currentScore.score_b || 0}}</view>
          </view>
        </view>

        <!-- 断流自愈提示 -->
        <view class="rl-notice" wx:if="{{session.status === 'reconnecting'}}">
          <text class="rl-notice-text">⚠️ 直播流暂时断开，正在执行 5 分钟静默重试窗，比分已定格锁定...</text>
        </view>

        <!-- 实时记分牌画面切片预览 -->
        <view class="snapshot-preview-section" wx:if="{{session.latest_snapshot_url}}">
          <text class="rl-label">实时记分牌截图画面</text>
          <view class="snapshot-img-wrap">
            <image class="snapshot-img" src="{{session.latest_snapshot_url}}?t={{refreshTick}}" mode="widthFix" />
          </view>
        </view>
      </view>
    </view>

    <!-- 智能多场切分候选列表 -->
    <view class="rl-card" wx:if="{{candidates && candidates.length > 0}}">
      <view class="rl-card-inner">
        <view class="rl-section-title">识别比赛轮次 (同一直播间)</view>
        <view class="rl-sub" style="margin-bottom: 20rpx;">AI 自动感知比分清零与队名切换，点击可关联官方赛程</view>

        <view class="candidates-wrapper">
          <view class="candidate-row" wx:for="{{candidates}}" wx:key="id">
            <view class="candidate-main">
              <view class="candidate-header-line">
                <text class="candidate-round-badge">第 {{item.round_index}} 场</text>
                <text class="rl-badge {{item.review_status === 'confirmed' ? 'rl-badge-ok' : 'rl-badge-warn'}}">
                  {{item.review_status === 'confirmed' ? '已核准绑定' : '待人工核对'}}
                </text>
              </view>
              <view class="candidate-match-title">
                {{item.team_a_raw || '主队'}} <text class="candidate-score-text">{{item.score_a}} : {{item.score_b}}</text> {{item.team_b_raw || '客队'}}
              </view>
              <view class="rl-list-desc">状态: {{item.is_ended ? '已完赛' : '进行中'}} | 小节: {{item.period || '全场'}}</view>
            </view>
            <view class="candidate-action-wrap" wx:if="{{item.review_status !== 'confirmed'}}">
              <button class="rl-btn rl-btn-secondary candidate-bind-btn" size="mini" data-id="{{item.id}}" bindtap="onOpenBindModal">
                关联赛程
              </button>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

</view>
