<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">场次监控</view>
    <view class="rl-title">{{matchTitle}}</view>
    <view class="rl-sub" wx:if="{{matchId}}">
      <text wx:if="{{tournamentName}}">{{tournamentName}} · </text>
      <text class="rl-badge {{statusBadgeClass}}" wx:if="{{matchStatus}}">{{statusLabel}}</text>
      <text wx:if="{{polling}}" style="margin-left:12rpx;color:#94a3b8;">· 每20秒刷新</text>
    </view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="mon-metrics">
        <view class="mon-metric">
          <text class="mon-metric-label">当前在线</text>
          <text class="mon-metric-value">{{currentOnline}}</text>
        </view>
        <view class="mon-metric">
          <text class="mon-metric-label">峰值在线</text>
          <text class="mon-metric-value">{{peakOnline}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rl-card" wx:if="{{promoEnabled || totalPoolNumber > 0}}">
    <view class="rl-card-inner">
      <view class="mon-commercial-head">
        <view class="rl-section-title">推广与广告核销</view>
        <text class="rl-badge {{settlementBadgeClass}}">{{settlementLabel}}</text>
      </view>
      <view class="mon-promo-row" wx:if="{{promoEnabled}}">
        <text class="mon-promo-label">推广专场</text>
        <text class="mon-promo-title">{{promoTitle || '已发布'}}</text>
      </view>
      <view class="mon-promo-actions" wx:if="{{promoEnabled}}">
        <button class="rl-btn rl-btn-secondary mon-promo-btn" bindtap="onOpenPromoPublish">推广管理</button>
        <button class="rl-btn rl-btn-secondary mon-promo-btn" bindtap="onOpenPromoReview">
          审批申请{{pendingCount > 0 ? '（' + pendingCount + '）' : ''}}
        </button>
      </view>
      <view class="mon-metrics mon-commercial-metrics">
        <view class="mon-metric">
          <text class="mon-metric-label">广告奖池</text>
          <text class="mon-metric-value mon-metric-value-small">{{totalPoolText}}</text>
        </view>
        <view class="mon-metric">
          <text class="mon-metric-label">起征人数</text>
          <text class="mon-metric-value mon-metric-value-small">{{minViewersText}}</text>
        </view>
      </view>
      <view class="mon-commercial-row">
        <view class="mon-commercial-stat">
          <text class="mon-commercial-label">物料数</text>
          <text class="mon-commercial-value">{{adsCountText}}</text>
        </view>
        <view class="mon-commercial-stat">
          <text class="mon-commercial-label">物料版本</text>
          <text class="mon-commercial-value">{{adsVersionText}}</text>
        </view>
        <view class="mon-commercial-stat" wx:if="{{financialSettledAt}}">
          <text class="mon-commercial-label">清算时间</text>
          <text class="mon-commercial-value">{{financialSettledAt}}</text>
        </view>
      </view>
      <view class="rl-field">
        <text class="rl-label">品牌名称</text>
        <input
          class="rl-input"
          placeholder="可选，同品牌重复上传将更新"
          value="{{logoBrandName}}"
          bindinput="onLogoBrandInput"
          disabled="{{settlementStatus === 'settled'}}"
        />
      </view>
      <button
        class="rl-btn rl-btn-secondary"
        disabled="{{uploadingLogo || settlementStatus === 'settled'}}"
        bindtap="onChooseLogo"
      >上传品牌 Logo</button>
    </view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="rl-section-title">全网合流热度</view>
      <view class="mon-canvas-wrap">
        <canvas type="2d" id="heatCanvas" class="mon-canvas"></canvas>
        <view class="rl-empty mon-chart-empty" wx:if="{{timelineEmpty && canvasReady}}">等待雷达上报数据…</view>
      </view>
    </view>
  </view>

  <view class="mon-actions">
    <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onOpenBindModal">启动监测</button>
    <button
      class="rl-btn rl-btn-secondary"
      disabled="{{submitting || !canProbe}}"
      bindtap="onTriggerProbe"
    >再次探测</button>
    <button
      class="rl-btn rl-btn-danger"
      disabled="{{submitting || !canStop}}"
      bindtap="onStopMonitoring"
    >关闭监测</button>
    <button
      wx:if="{{!canOpenSettlement}}"
      class="rl-btn rl-btn-secondary"
      disabled="{{submitting || !canSettle}}"
      bindtap="onSettleMatch"
    >一键清算</button>
    <button
      wx:else
      class="rl-btn rl-btn-primary"
      disabled="{{submitting}}"
      bindtap="onOpenSettlement"
    >查看结算单</button>
  </view>

  <view class="rl-notice">
    <text class="rl-notice-text">监测采用手动触发模式：启动后采集一轮数据；需要更新时点「再次探测」。审批通过也会自动探测一次。{{canSettle || canOpenSettlement ? '结算单按赛后推广分生成。' : settleDisabledTip ? ' ' + settleDisabledTip : ''}}</text>
  </view>

  <view class="rl-modal-mask" wx:if="{{showBindModal}}" bindtap="onCloseBindModal" catchtouchmove="stopModalBubble">
    <view class="rl-modal" catchtap="stopModalBubble">
      <view class="rl-modal-title">启动监测</view>
      <view class="rl-field">
        <text class="rl-label">粘贴抖音分享口令或链接</text>
        <textarea
          class="rl-textarea"
          placeholder="7@5.com … https://v.douyin.com/xxx/"
          value="{{bindRawText}}"
          bindinput="onBindInput"
          maxlength="-1"
        />
      </view>
      <view class="rl-notice" style="margin-bottom:8rpx;">
        <text class="rl-notice-text">首次挂载需粘贴口令；已审批主播可直接点「再次探测」无需重复粘贴。</text>
      </view>
      <view class="rl-modal-actions">
        <button class="rl-btn rl-btn-secondary" bindtap="onCloseBindModal">取消</button>
        <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onSubmitBind">开始监测</button>
      </view>
    </view>
  </view>

</view>
