<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">场次监控</view>
    <view class="rl-title">{{matchTitle}}</view>
    <view class="rl-sub" wx:if="{{matchId}}">
      <text wx:if="{{tournamentName}}">{{tournamentName}} · </text>
      <text class="rl-badge {{statusBadgeClass}}" wx:if="{{matchStatus}}">{{statusLabel}}</text>
      <text wx:if="{{polling}}" style="margin-left:12rpx;color:#94a3b8;">· 每20秒刷新</text>
    </view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="mon-metrics">
        <view class="mon-metric">
          <text class="mon-metric-label">当前在线</text>
          <text class="mon-metric-value">{{currentOnline}}</text>
        </view>
        <view class="mon-metric">
          <text class="mon-metric-label">峰值在线</text>
          <text class="mon-metric-value">{{peakOnline}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="rl-card" wx:if="{{promoEnabled || totalPoolNumber > 0}}">
    <view class="rl-card-inner">
      <view class="mon-commercial-head">
        <view class="rl-section-title">推广与广告核销</view>
        <text class="rl-badge {{settlementBadgeClass}}">{{settlementLabel}}</text>
      </view>
      <view class="mon-promo-row" wx:if="{{promoEnabled}}">
        <text class="mon-promo-label">推广专场</text>
        <text class="mon-promo-title">{{promoTitle || '已发布'}}</text>
      </view>
      <view class="mon-promo-actions" wx:if="{{promoEnabled && canManage}}">
        <button class="rl-btn rl-btn-secondary mon-promo-btn" bindtap="onOpenPromoPublish">推广管理</button>
        <button class="rl-btn rl-btn-secondary mon-promo-btn" bindtap="onOpenPromoReview">
          审批申请{{pendingCount > 0 ? '（' + pendingCount + '）' : ''}}
        </button>
      </view>
      <view class="mon-metrics mon-commercial-metrics">
        <view class="mon-metric">
          <text class="mon-metric-label">广告奖池</text>
          <text class="mon-metric-value mon-metric-value-small">{{totalPoolText}}</text>
        </view>
        <view class="mon-metric">
          <text class="mon-metric-label">起征人数</text>
          <text class="mon-metric-value mon-metric-value-small">{{minViewersText}}</text>
        </view>
      </view>
      <view class="mon-commercial-row">
        <view class="mon-commercial-stat">
          <text class="mon-commercial-label">物料数</text>
          <text class="mon-commercial-value">{{adsCountText}}</text>
        </view>
        <view class="mon-commercial-stat">
          <text class="mon-commercial-label">物料版本</text>
          <text class="mon-commercial-value">{{adsVersionText}}</text>
        </view>
        <view class="mon-commercial-stat" wx:if="{{financialSettledAt}}">
          <text class="mon-commercial-label">清算时间</text>
          <text class="mon-commercial-value">{{financialSettledAt}}</text>
        </view>
      </view>
      <block wx:if="{{canManage}}">
        <view class="rl-field">
          <text class="rl-label">品牌名称</text>
          <input
            class="rl-input"
            placeholder="可选，同品牌重复上传将更新"
            value="{{logoBrandName}}"
            bindinput="onLogoBrandInput"
            disabled="{{settlementStatus === 'settled'}}"
          />
        </view>
        <button
          class="rl-btn rl-btn-secondary"
          disabled="{{uploadingLogo || settlementStatus === 'settled'}}"
          bindtap="onChooseLogo"
        >上传品牌 Logo</button>
      </block>
    </view>
  </view>

  <!-- 已绑定直播间列表 -->
  <view class="rl-card" wx:if="{{(boundAnchors && boundAnchors.length > 0) || canManage}}">
    <view class="rl-card-inner">
      <view class="bound-anchors-title-row">
        <view class="rl-section-title" style="margin-bottom: 0;">📹 监测中的直播间 ({{boundAnchors.length || 0}})</view>
        <view
          wx:if="{{canManage && monitorSessionStatus !== 'ended' && monitorSessionStatus !== 'stopping'}}"
          class="add-anchor-icon-btn"
          bindtap="onOpenBindModal"
          hover-class="add-anchor-icon-btn--hover"
        >
          ＋
        </view>
      </view>
      
      <view class="bound-anchors-list" wx:if="{{boundAnchors && boundAnchors.length > 0}}">
        <view class="bound-anchor-item" wx:for="{{boundAnchors}}" wx:key="secUserId">
          <view class="bound-anchor-info">
            <text class="bound-anchor-name">{{item.anchorName || '未命名主播'}}</text>
            <text class="bound-anchor-uid" style="color: #94a3b8; font-size: 20rpx; margin-top: 4rpx;">ID: {{item.secUserId}}</text>
          </view>
          <view class="bound-anchor-link-wrap">
            <text class="bound-anchor-link" style="color: #2563eb; font-size: 24rpx; text-decoration: underline;" bindtap="onCopyAnchorLink" data-link="{{item.liveUrl}}">复制直播间链接</text>
          </view>
        </view>
      </view>
      <view class="rl-list-desc" style="text-align: center; padding: 30rpx 0; color: #94a3b8; font-size: 24rpx;" wx:else>
        暂无监测中的直播间，请点击右上角「＋」关联直播间
      </view>
    </view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="rl-section-title">全网合流热度</view>
      <view class="mon-canvas-wrap">
        <canvas type="2d" id="heatCanvas" class="mon-canvas"></canvas>
        <view class="rl-empty mon-chart-empty" wx:if="{{timelineEmpty && canvasReady}}">等待雷达上报数据…</view>
      </view>
    </view>
  </view>

  <!-- 记分牌截图与录制数据卡片 (白名单 + 进行中/已结束) -->
  <block wx:if="{{isInWhitelist && (matchStatus === 'monitoring' || matchStatus === 'ended' || matchStatus === 'interrupted')}}">
    <!-- 记分牌截图卡片 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="score-snapshot-title-row">
          <view class="rl-section-title" style="margin-bottom: 0;">📸 记分牌截图 (实验)</view>
          <view class="score-snapshot-refresh-btn" bindtap="onRefreshScoreSnapshots" hover-class="score-snapshot-refresh-btn--hover">
            <text class="refresh-icon">↻</text>
            <text>刷新</text>
          </view>
        </view>
        <view class="score-snapshot-tip">雷达截取直播底部记分牌条带，请自行查看图片解读比分与队名。</view>
        <block wx:if="{{scoreSnapshots && scoreSnapshots.length > 0}}">
          <view class="score-snapshot-list">
            <view
              class="score-snapshot-item"
              wx:for="{{scoreSnapshots}}"
              wx:key="sec_user_id"
            >
              <view class="score-snapshot-header">
                <text class="score-snapshot-anchor">{{item.anchorLabel}}</text>
                <text class="score-snapshot-meta">{{item.capturedAtText}} · {{item.sportTypeLabel}} · {{item.imageSizeText}}</text>
              </view>
              <image
                class="score-snapshot-image"
                src="{{item.snapshot_url}}"
                mode="widthFix"
                show-menu-by-longpress="{{true}}"
                bindtap="onPreviewScoreSnapshot"
                data-url="{{item.snapshot_url}}"
              />
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="rl-empty">{{scoreSnapshotsEmpty ? '等待雷达上报记分牌截图…' : '暂无截图'}}</view>
        </block>
      </view>
    </view>

    <!-- 录制元数据卡片 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="rl-section-title">📹 录制元数据 (实验)</view>
        <block wx:if="{{mediaCounts && mediaSummary}}">
          <view class="media-meta-summary">
            <view class="media-meta-row">
              <text class="media-meta-label">音频分片数:</text>
              <text class="media-meta-val">{{mediaCounts.audio}} 个</text>
            </view>
            <view class="media-meta-row">
              <text class="media-meta-label">视频分片数:</text>
              <text class="media-meta-val">{{mediaCounts.video}} 个</text>
            </view>
            <view class="media-meta-row">
              <text class="media-meta-label">总录制时长:</text>
              <text class="media-meta-val">{{mediaSummary.total_duration_sec}} 秒</text>
            </view>
            <view class="media-meta-row">
              <text class="media-meta-label">总文件大小:</text>
              <text class="media-meta-val">{{mediaSummary.total_file_size_bytes}} 字节</text>
            </view>
            <view class="media-meta-row" wx:if="{{mediaStatus}}">
              <text class="media-meta-label">录制状态:</text>
              <text class="media-meta-val">{{mediaStatus.event}}</text>
            </view>
            <view class="media-meta-row" style="margin-top: 12rpx; padding-top: 12rpx; border-top: 1rpx dashed #e2e8f0;">
              <text class="media-meta-label" style="color: #64748b; font-size: 22rpx;">存储位置:</text>
              <text class="media-meta-val" style="color: #64748b; font-size: 22rpx;">文件保存在雷达节点，暂不支持在线播放</text>
            </view>
          </view>
        </block>
        <block wx:else>
          <view class="rl-empty">暂无录制分片</view>
        </block>
      </view>
    </view>
  </block>

  <view class="mon-actions" wx:if="{{canManage}}">
    <button
      class="rl-btn rl-btn-secondary"
      disabled="{{submitting || !canProbe}}"
      bindtap="onTriggerProbe"
    >再次探测</button>
    <button
      class="rl-btn rl-btn-danger"
      disabled="{{submitting || !canStop || monitorSessionStatus === 'stopping'}}"
      bindtap="onStopMonitoring"
    >{{monitorSessionStatus === 'stopping' ? '正在停止…' : '关闭监测'}}</button>
    <button
      wx:if="{{!canOpenSettlement}}"
      class="rl-btn rl-btn-secondary"
      disabled="{{submitting || !canSettle}}"
      bindtap="onSettleMatch"
    >一键清算</button>
    <button
      wx:else
      class="rl-btn rl-btn-primary"
      disabled="{{submitting}}"
      bindtap="onOpenSettlement"
    >查看结算单</button>
    <button
      wx:if="{{settlementStatus !== 'settled'}}"
      class="rl-btn rl-btn-danger"
      disabled="{{submitting}}"
      bindtap="onDeleteMatch"
    >删除场次</button>
  </view>
  <view class="mon-actions" wx:else>
    <button
      wx:if="{{canOpenSettlement}}"
      class="rl-btn rl-btn-primary"
      disabled="{{submitting}}"
      bindtap="onOpenSettlement"
    >查看结算单</button>
    <view class="rl-list-desc" style="text-align: center; margin-top: 10rpx; color: #94a3b8; font-size: 24rpx;">仅查看权限，不可操作监测与清算</view>
  </view>

  <view class="rl-notice">
    <text class="rl-notice-text">监测采用手动触发模式：启动后采集一轮数据；需要更新时点「再次探测」。审批通过也会自动探测一次。{{canSettle || canOpenSettlement ? '结算单按赛后推广分生成。' : settleDisabledTip ? ' ' + settleDisabledTip : ''}}</text>
  </view>

  <view class="rl-modal-mask" wx:if="{{showBindModal}}" bindtap="onCloseBindModal" catchtouchmove="stopModalBubble">
    <view class="rl-modal" catchtap="stopModalBubble">
      <view class="rl-modal-title">启动监测</view>
      <view class="rl-field">
        <text class="rl-label">粘贴抖音分享口令或链接</text>
        <textarea
          class="rl-textarea"
          placeholder="7@5.com … https://v.douyin.com/xxx/"
          value="{{bindRawText}}"
          bindinput="onBindInput"
          maxlength="-1"
        />
      </view>

      <!-- 实验能力折叠区 -->
      <view class="modal-lab-section" wx:if="{{isInWhitelist}}">
        <view class="modal-lab-toggle" bindtap="onToggleModalLab">
          <text class="modal-lab-toggle-title">⚡ 实验能力设置 (高级)</text>
          <text class="modal-lab-toggle-arrow">{{showModalLab ? '▼' : '▶'}}</text>
        </view>
        <scroll-view scroll-y style="max-height: 320rpx;" wx:if="{{showModalLab}}">
          <view class="modal-switch-item">
            <text>广告物料核销</text>
            <switch checked="{{enable_ad_verify}}" bindchange="onAdVerifyChange" color="#2563eb" />
          </view>
          <view class="modal-switch-item">
            <text>记分牌截图</text>
            <switch checked="{{enable_score_ocr}}" bindchange="onScoreOcrChange" color="#2563eb" />
          </view>
          
          <view class="modal-sub-options" wx:if="{{enable_score_ocr}}">
            <picker mode="selector" range="{{sportTypes}}" value="{{sportTypeIndex}}" bindchange="onSportTypeChange">
              <view class="modal-picker-row">
                <text class="modal-picker-label">运动类型</text>
                <text class="modal-picker-val">{{sportTypes[sportTypeIndex]}} ›</text>
              </view>
            </picker>
          </view>

          <view class="modal-switch-item">
            <text>音频录制</text>
            <switch checked="{{enable_audio_record}}" bindchange="onAudioRecordChange" color="#2563eb" />
          </view>
          <view class="modal-switch-item">
            <text>视频录制</text>
            <switch checked="{{enable_video_record}}" bindchange="onVideoRecordChange" color="#2563eb" />
          </view>

          <view class="modal-sub-options" wx:if="{{enable_audio_record || enable_video_record}}">
            <view class="modal-input-row">
              <text class="modal-input-label">分片时长(秒)</text>
              <input type="number" placeholder="300" value="{{segment_duration_sec}}" bindinput="onSegmentDurationInput" class="modal-input-val" />
            </view>
            <view class="modal-input-row">
              <text class="modal-input-label">保留时长(小时)</text>
              <input type="number" placeholder="24" value="{{local_retention_hours}}" bindinput="onRetentionHoursInput" class="modal-input-val" />
            </view>
          </view>
        </scroll-view>
      </view>

      <view class="rl-notice" style="margin-bottom:8rpx;">
        <text class="rl-notice-text">首次挂载需粘贴口令；已审批主播可直接点「再次探测」无需重复粘贴。</text>
      </view>
      <view class="rl-modal-actions">
        <button class="rl-btn rl-btn-secondary" bindtap="onCloseBindModal">取消</button>
        <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onSubmitBind">开始监测</button>
      </view>
    </view>
  </view>

</view>
