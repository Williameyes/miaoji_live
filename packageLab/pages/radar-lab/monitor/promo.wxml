<view class="rl-root">

  <view class="rl-header">
    <view class="rl-kicker">直播雷达 · 实验</view>
    <view class="rl-title">推广监测</view>
    <view class="rl-sub">
      已配置广告/推广奖池的场次：发布广场、生成小程序码、审批申请
      <text wx:if="{{polling}}" style="margin-left:12rpx;color:#94a3b8;">· 每20秒刷新</text>
    </view>
  </view>

  <view class="rl-card" wx:if="{{matchRows.length}}">
    <block wx:for="{{matchRows}}" wx:key="id">
      <view class="rt-item" hover-class="rl-list-item-hover">
        <view class="rt-item-main" bindtap="onOpenPromoManage" data-id="{{item.id}}">
          <view class="rl-list-title">{{item.teamA}} vs {{item.teamB}}</view>
          <view class="rl-list-desc">{{item.startTimeText}} · {{item.tournamentName}}</view>
          <view class="rl-list-desc rt-promo-desc" wx:if="{{item.promoTitle}}">{{item.promoTitle}}</view>
        </view>
        <view class="rt-item-right">
          <text class="rt-promo-badge">{{item.promoEnabled ? '已发布' : '未发布'}}</text>
          <text class="rt-status">{{item.statusLabel}}</text>
        </view>
        <text class="rl-list-arrow" bindtap="onOpenPromoManage" data-id="{{item.id}}">›</text>
      </view>
    </block>
  </view>

  <view class="rl-empty" wx:elif="{{!loading}}">
    <text>暂无推广监测场次</text>
    <text class="rl-empty-sub">请在场次维护中配置奖池/Logo，发布后本页会显示；主播通过小程序码进入的是「推广广场」申请页，不是本列表</text>
  </view>

  <view class="rl-empty" wx:else>
    <text>加载中…</text>
  </view>

</view>
