@import '../common/common.wxss';

.mon-metrics {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.mon-metric {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.mon-metric-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.mon-metric-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2563eb;
}

.mon-canvas-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.mon-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}

.mon-canvas-wrap .rl-empty,
.mon-canvas-wrap .mon-chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  background: transparent;
  padding: 0 24rpx;
  z-index: 1;
}

.mon-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mon-actions .rl-btn {
  width: 100%;
}
