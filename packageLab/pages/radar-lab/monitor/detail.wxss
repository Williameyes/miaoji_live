@import '../common/common.wxss';

.mon-metrics {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.mon-metric {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.mon-metric-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.mon-metric-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2563eb;
}

.mon-metric-value-small {
  font-size: 32rpx;
  color: #0f172a;
}

.mon-promo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.mon-promo-label {
  font-size: 22rpx;
  color: #64748b;
  flex-shrink: 0;
}

.mon-promo-title {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}

.mon-promo-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mon-promo-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
}

.mon-commercial-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mon-commercial-head .rl-section-title {
  margin-bottom: 0;
}

.mon-commercial-metrics {
  margin-bottom: 22rpx;
}

.mon-commercial-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.mon-commercial-stat {
  min-width: 180rpx;
  flex: 1;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.mon-commercial-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.mon-commercial-value {
  display: block;
  font-size: 25rpx;
  color: #334155;
  font-weight: 700;
  word-break: break-all;
}

.mon-canvas-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.mon-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}

.mon-canvas-wrap .rl-empty,
.mon-canvas-wrap .mon-chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  background: transparent;
  padding: 0 24rpx;
  z-index: 1;
}

.mon-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mon-actions .rl-btn {
  width: 100%;
}
