@import '../common/common.wxss';

.mon-metrics {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.mon-metric {
  flex: 1;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
}

.mon-metric-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.mon-metric-value {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #2563eb;
}

.mon-metric-value-small {
  font-size: 32rpx;
  color: #0f172a;
}

.mon-promo-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.mon-promo-label {
  font-size: 22rpx;
  color: #64748b;
  flex-shrink: 0;
}

.mon-promo-title {
  font-size: 26rpx;
  color: #0f172a;
  font-weight: 600;
}

.mon-promo-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mon-promo-btn {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
}

.mon-commercial-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.mon-commercial-head .rl-section-title {
  margin-bottom: 0;
}

.mon-commercial-metrics {
  margin-bottom: 22rpx;
}

.mon-commercial-row {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.mon-commercial-stat {
  min-width: 180rpx;
  flex: 1;
  background: #f8fafc;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}

.mon-commercial-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 6rpx;
}

.mon-commercial-value {
  display: block;
  font-size: 25rpx;
  color: #334155;
  font-weight: 700;
  word-break: break-all;
}

.mon-canvas-wrap {
  position: relative;
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
}

.mon-canvas {
  width: 100%;
  height: 360rpx;
  display: block;
}

.mon-canvas-wrap .rl-empty,
.mon-canvas-wrap .mon-chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  pointer-events: none;
  background: transparent;
  padding: 0 24rpx;
  z-index: 1;
}

.mon-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.mon-actions .rl-btn {
  width: 100%;
}

/* 弹窗中的实验功能折叠 */
.modal-lab-section {
  margin-top: 16rpx;
  margin-bottom: 16rpx;
}

.modal-lab-toggle {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-top: 1rpx solid #e2e8f0;
  border-bottom: 1rpx solid #e2e8f0;
  margin-bottom: 16rpx;
}

.modal-lab-toggle-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1e293b;
}

.modal-lab-toggle-arrow {
  font-size: 24rpx;
  color: #64748b;
  transition: transform 0.2s ease;
}

.modal-switch-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.modal-switch-item text {
  font-size: 24rpx;
  color: #475569;
}

.modal-switch-item switch {
  transform: scale(0.8);
}

.modal-sub-options {
  background: #f8fafc;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  border-left: 4rpx solid #cbd5e1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.modal-sub-options picker {
  width: 100%;
}

.modal-picker-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  height: 48rpx;
}

.modal-picker-label {
  font-size: 22rpx;
  color: #64748b;
}

.modal-picker-val {
  font-size: 22rpx;
  font-weight: 700;
  color: #1e293b;
}

.modal-input-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.modal-input-label {
  font-size: 22rpx;
  color: #64748b;
}

.modal-input-val {
  text-align: right;
  font-size: 22rpx;
  width: 120rpx;
  background: #e2e8f0;
  border-radius: 4rpx;
  padding: 2rpx 8rpx;
  color: #0f172a;
}

/* 记分牌截图 */
.score-snapshot-tip {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.score-snapshot-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.score-snapshot-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  overflow: hidden;
}

.score-snapshot-header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  padding: 20rpx 20rpx 12rpx;
}

.score-snapshot-anchor {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.score-snapshot-meta {
  font-size: 22rpx;
  color: #64748b;
}

.score-snapshot-image {
  width: 100%;
  display: block;
  background: #0f172a;
}

/* 录制媒体数据 */
.media-meta-summary {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.media-meta-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.media-meta-label {
  font-size: 24rpx;
  color: #64748b;
}

.media-meta-val {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.bound-anchors-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
}

.bound-anchor-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.bound-anchor-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.bound-anchor-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bound-anchor-link-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.score-snapshot-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.score-snapshot-refresh-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: #f0f5ff;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.score-snapshot-refresh-btn--hover {
  opacity: 0.7;
  background: #dbeafe;
}

.score-snapshot-refresh-btn .refresh-icon {
  font-size: 26rpx;
  margin-top: -2rpx;
}

.bound-anchors-title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.add-anchor-icon-btn {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #2563eb;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  transition: all 0.2s ease;
  line-height: 48rpx;
  text-align: center;
}

.add-anchor-icon-btn--hover {
  background-color: #1d4ed8;
  transform: scale(1.1);
}

