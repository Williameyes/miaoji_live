@import '../../common/common.wxss';

.rl-datetime-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.rl-datetime-row picker {
  flex: 1;
  min-width: 0;
}

.rl-picker-display {
  display: flex;
  align-items: center;
}

.rl-link {
  color: #2563eb;
  text-decoration: underline;
  padding: 0 4rpx;
}

.rl-link:active {
  opacity: 0.7;
}

/* ───── 联系客服自定义弹窗（对齐 我的-联系客服 样式） ───── */
.contact-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(10px);
  padding: 40rpx;
  box-sizing: border-box;
}

.contact-card {
  width: 100%;
  max-width: 600rpx;
  padding: 48rpx 40rpx 40rpx;
  box-sizing: border-box;
  border-radius: 32rpx;
  background: #ffffff;
  box-shadow: 0 32rpx 80rpx rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.contact-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 24rpx;
  text-align: center;
}

.contact-content {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  line-height: 1.8;
  color: #475569;
  margin-bottom: 40rpx;
  text-align: center;
}

.contact-text {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.8;
  text-align: center;
}

.contact-actions {
  display: flex;
  flex-direction: row;
  width: 100%;
  gap: 20rpx;
}

.contact-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 0 !important;
  margin: 0 !important;
}

.contact-btn::after {
  border: none;
}

.contact-cancel-btn {
  color: #64748b !important;
  background: #f1f5f9 !important;
  border: 1rpx solid #e2e8f0 !important;
}

.contact-confirm-btn {
  color: #ffffff !important;
  background: linear-gradient(135deg, #3b82f6, #2563eb) !important;
  box-shadow: 0 12rpx 32rpx rgba(37, 99, 235, 0.28);
}

