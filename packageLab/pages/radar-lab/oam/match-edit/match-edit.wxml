<view class="rl-root">

  <view class="rl-header">
    <view class="rl-title">{{isEdit ? '编辑场次' : '新增场次'}}</view>
    <view class="rl-sub">选择赛事、队名与开赛时间，无需填写 ID</view>
  </view>

  <view class="rl-empty" wx:if="{{loading}}">加载中…</view>

  <view class="rl-card" wx:else>
    <view class="rl-card-inner">
      <view class="rl-field" wx:if="{{tournaments.length}}">
        <text class="rl-label">所属赛事</text>
        <picker mode="selector" range="{{tournaments}}" range-key="name" value="{{tournamentIndex}}" bindchange="onTournamentChange">
          <view class="rl-input rl-picker-display">{{tournaments[tournamentIndex].name}}</view>
        </picker>
      </view>
      <view class="rl-notice" wx:else style="margin-bottom:24rpx;">
        <text class="rl-notice-text">请先创建赛事后再新增场次</text>
      </view>
      <view class="rl-field">
        <text class="rl-label">场次序号 / 场序</text>
        <input class="rl-input" type="number" placeholder="如：1、2、39（选填）" value="{{matchSeq}}" bindinput="onMatchSeqInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">所属阶段/分组</text>
        <input class="rl-input" placeholder="如：A组、B组、常规赛" value="{{stageId}}" bindinput="onStageIdInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">队伍 A</text>
        <input class="rl-input" placeholder="主队名称" value="{{teamA}}" bindinput="onTeamAInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">队伍 B</text>
        <input class="rl-input" placeholder="客队名称" value="{{teamB}}" bindinput="onTeamBInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">比赛时间</text>
        <view class="rl-datetime-row">
          <picker mode="date" value="{{startDate}}" start="2020-01-01" end="2035-12-31" bindchange="onStartDateChange">
            <view class="rl-input rl-picker-display">{{startDate || '选择日期'}}</view>
          </picker>
          <picker mode="time" value="{{startTime}}" bindchange="onStartTimeChange">
            <view class="rl-input rl-picker-display">{{startTime || '选择时间'}}</view>
          </picker>
        </view>
      </view>
      <view class="rl-field">
        <text class="rl-label">比赛场地/球场</text>
        <input class="rl-input" placeholder="如：1号场、奥体中心3号场地" value="{{venue}}" bindinput="onVenueInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">比分记录 (完赛可填)</text>
        <view class="rl-datetime-row">
          <input class="rl-input" type="number" placeholder="主队比分" value="{{scoreA}}" bindinput="onScoreAInput" />
          <text style="color:#64748B;padding:0 12rpx;">:</text>
          <input class="rl-input" type="number" placeholder="客队比分" value="{{scoreB}}" bindinput="onScoreBInput" />
        </view>
      </view>
      <block wx:if="{{isWhitelist}}">
        <view class="rl-field">
          <text class="rl-label">广告奖池金额（元）</text>
          <input class="rl-input" type="digit" placeholder="如 700" value="{{totalPool}}" bindinput="onTotalPoolInput" />
        </view>
        <view class="rl-field">
          <text class="rl-label">推广分起征人数</text>
          <input class="rl-input" type="number" placeholder="如 1000" value="{{minViewers}}" bindinput="onMinViewersInput" />
        </view>
      </block>
      <button class="rl-btn rl-btn-primary" disabled="{{submitting || !tournaments.length}}" bindtap="onSave">保存场次</button>
    </view>
  </view>

</view>
