<view class="rl-root tour-root">

  <view class="tour-header-wrap">
    <view class="rl-header" style="margin-bottom: 0;">
      <view class="rl-kicker">OAM · 赛事维护</view>
      <view class="rl-title">赛事列表</view>
      <view class="rl-sub">创建或编辑赛事，场次需归属到具体赛事</view>
    </view>
    <button class="tour-claim-top-btn" bindtap="onOpenClaimInputModal">🔑 接收赛事</button>
  </view>

  <view class="rl-empty" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <view class="rl-card" wx:elif="{{tournamentRows.length}}">
    <block wx:for="{{tournamentRows}}" wx:key="id">
      <view class="tour-item" hover-class="rl-list-item-hover">
        <view class="tour-item-main" bindtap="onViewTournamentDetail" data-id="{{item.id}}">
          <view class="rl-list-title">{{item.name}}</view>
          <view class="rl-list-desc">{{item.dateRange}}</view>
          <view class="tour-item-meta">
            <text class="tour-meta-tag {{item.isPublic ? 'tag-public' : 'tag-hidden'}}">{{item.isPublic ? '🌐 公开' : '🔒 隐藏'}}</text>
            <text class="tour-meta-tag">排期 {{item.scheduledCount}} 场</text>
            <text class="tour-meta-tag">已监控 {{item.monitoredCount}} 场</text>
            <text class="tour-meta-tag" wx:if="{{item.influenceScore !== '—'}}">影响力 {{item.influenceScore}}</text>
          </view>
        </view>
        <view class="tour-item-actions" wx:if="{{!adminViewAll || item.canManage}}">
          <button
            wx:if="{{isWhitelist}}"
            class="tour-btn-initials"
            bindtap="onOpenInitialsModal"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
          >📊 基准积分</button>
          <button
            class="tour-edit-btn"
            bindtap="onEditTournament"
            data-id="{{item.id}}"
          >编辑</button>
        </view>
        <text wx:if="{{adminViewAll && !item.canManage}}" class="rl-list-desc">仅查看</text>
      </view>
    </block>
  </view>

  <view class="rl-empty" wx:else>
    <text>暂无赛事，去创建</text>
    <text class="rl-empty-sub">点击下方按钮创建第一届赛事，再前往场次维护排期</text>
  </view>

  <view class="tour-fab" bindtap="onNewTournament" hover-class="tour-fab-hover">
    <text class="tour-fab-text">新增赛事</text>
  </view>

  <!-- 📊 初始基准积分 AI 导入与维护 Modal -->
  <view class="tour-modal-overlay" wx:if="{{showInitialsModal}}">
    <view class="tour-modal-card">
      <view class="tour-modal-title">📊 设置赛事初始基准积分</view>
      <view class="tour-modal-sub">针对【{{targetTournamentName}}】中途接入修正</view>

      <view class="tour-ai-action-bar">
        <button class="tour-ai-btn" bindtap="onCopyAiPrompt">📋 复制 AI 整理基准积分提示词</button>
      </view>

      <view class="tour-modal-section-title">📝 粘贴 AI 生成的 CSV 批量导入基准积分</view>
      <textarea 
        class="tour-csv-textarea" 
        value="{{pastedCsvText}}" 
        maxlength="-1"
        bindinput="onCsvTextInput" 
        placeholder="请将 AI 整理出的 CSV 格式粘贴在此处（支持一次性导入全组球队基准数据）" 
      />

      <view class="tour-modal-actions">
        <button class="tour-btn tour-btn-cancel" bindtap="onCloseInitialsModal">取消</button>
        <button class="tour-btn tour-btn-confirm" disabled="{{submittingInitials}}" bindtap="onSaveInitialsFromCsv">一键保存基准积分</button>
      </view>
    </view>
  </view>

  <!-- 🔑 移交口令手动输入弹窗 -->
  <view class="claim-modal-overlay" wx:if="{{showClaimInputModal}}" catchtouchmove="stopModalMove" bindtap="onCloseClaimInputModal">
    <view class="claim-modal-card" catchtap="stopModalBubble">
      <view class="claim-modal-title">接收赛事管理权</view>
      <view class="claim-modal-sub">请输入客服或原创建人提供的 6 位移交口令</view>
      
      <input
        class="claim-code-input"
        type="number"
        maxlength="6"
        placeholder="请输入 6 位数字口令"
        value="{{claimCodeInput}}"
        bindinput="onClaimCodeInput"
      />

      <view class="claim-modal-actions">
        <button class="claim-btn claim-btn--cancel" bindtap="onCloseClaimInputModal">取消</button>
        <button class="claim-btn claim-btn--confirm" bindtap="onSubmitClaimCode">核验并接收</button>
      </view>
    </view>
  </view>

  <!-- 🔑 接收赛事确认弹窗 (剪贴板自动唤起或手动查出后展示) -->
  <view class="claim-modal-overlay" wx:if="{{showClaimConfirmModal}}" catchtouchmove="stopModalMove" bindtap="onCloseClaimConfirmModal">
    <view class="claim-modal-card" catchtap="stopModalBubble">
      <view class="claim-modal-title">发现待接收赛事</view>
      <view class="claim-modal-sub">请确认赛事信息，接收后您将成为该赛事的主管理员</view>

      <view class="claim-info-card" wx:if="{{claimInfo}}">
        <view class="claim-info-title">{{claimInfo.tournament_name}}</view>
        <view class="claim-info-meta">
          <text class="claim-meta-item">📅 {{claimInfo.start_date}} ~ {{claimInfo.end_date}}</text>
          <text class="claim-meta-item">📋 包含场次：{{claimInfo.match_count}} 场</text>
        </view>
        <view class="claim-info-notice">💡 接收后，该赛事及其全部场次的所有权将转移至您的当前账号名下。</view>
      </view>

      <view class="claim-modal-actions">
        <button class="claim-btn claim-btn--cancel" bindtap="onCloseClaimConfirmModal">拒绝</button>
        <button class="claim-btn claim-btn--confirm" disabled="{{claiming}}" bindtap="onConfirmClaim">
          {{claiming ? '正在接收…' : '接收'}}
        </button>
      </view>
    </view>
  </view>

</view>
