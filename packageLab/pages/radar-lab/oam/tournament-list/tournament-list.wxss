@import '../../common/common.wxss';

.tour-root {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.tour-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.tour-item:last-child {
  border-bottom: none;
}

.tour-item-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.tour-item-meta {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tour-meta-tag {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.tour-edit-btn {
  margin: 0;
  padding: 0 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  background: #dbeafe;
  color: #1d4ed8;
  flex-shrink: 0;
}

.tour-edit-btn::after {
  border: none;
}

.rl-empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
  padding: 0 16rpx;
}

.tour-fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 24rpx;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.35);
}

.tour-fab-hover {
  opacity: 0.92;
}

.tour-fab-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}
