<view class="rl-root">

  <view class="rl-header">
    <view class="rl-title">管理赛事</view>
    <view class="rl-sub">选择已有赛事编辑，或新建一届大赛事</view>
  </view>

  <view class="rl-card" wx:if="{{tournaments.length && !isCreatingNew}}">
    <view class="rl-card-inner">
      <view class="rl-field">
        <text class="rl-label">选择赛事</text>
        <picker mode="selector" range="{{tournaments}}" range-key="name" value="{{pickerIndex}}" bindchange="onTournamentPick">
          <view class="rl-input rl-picker-display">{{tournaments[pickerIndex].name}}</view>
        </picker>
      </view>
      <button class="rl-btn rl-btn-secondary" bindtap="onCreateNew">＋ 新建赛事</button>
    </view>
  </view>

  <view class="rl-card">
    <view class="rl-card-inner">
      <view class="rl-section-title">{{isCreatingNew ? '新建赛事' : '编辑赛事'}}</view>
      <view class="rl-field">
        <text class="rl-label">赛事名称</text>
        <input class="rl-input" placeholder="如：2026 春季联赛" value="{{tournamentName}}" bindinput="onNameInput" />
      </view>
      <view class="rl-field">
        <text class="rl-label">开始日期</text>
        <picker mode="date" value="{{startDate}}" start="2020-01-01" end="2035-12-31" bindchange="onStartDateChange">
          <view class="rl-input rl-picker-display">{{startDate}}</view>
        </picker>
      </view>
      <view class="rl-field">
        <text class="rl-label">结束日期</text>
        <picker mode="date" value="{{endDate}}" start="2020-01-01" end="2035-12-31" bindchange="onEndDateChange">
          <view class="rl-input rl-picker-display">{{endDate}}</view>
        </picker>
      </view>
      <view class="rl-field">
        <text class="rl-label">运动类型</text>
        <picker mode="selector" range="{{sportTypes}}" range-key="label" value="{{sportTypeIndex}}" bindchange="onSportTypeChange">
          <view class="rl-input rl-picker-display">{{sportTypes[sportTypeIndex].label}}</view>
        </picker>
      </view>
      <view class="rl-field">
        <text class="rl-label">赛事制式</text>
        <picker mode="selector" range="{{formats}}" range-key="label" value="{{formatIndex}}" bindchange="onFormatChange">
          <view class="rl-input rl-picker-display">{{formats[formatIndex].label}}</view>
        </picker>
      </view>
      <view class="rl-field switch-field">
        <view class="switch-label-wrap">
          <text class="rl-label">公开至赛事大厅</text>
          <text class="switch-sub">开启后将在前端「赛事资讯」列表中公开展示</text>
        </view>
        <switch checked="{{isPublic}}" color="#2563eb" bindchange="onIsPublicChange" />
      </view>
      <button class="rl-btn rl-btn-primary" disabled="{{submitting}}" bindtap="onSave">保存赛事</button>
    </view>
  </view>

</view>
