@import '../common/common.wxss';

.oam-root {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.oam-toolbar-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.oam-filter-picker {
  flex: 1;
  min-width: 0;
}

.oam-filter-pill {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #334155;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  max-width: 100%;
  box-sizing: border-box;
}

.oam-filter-text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.oam-filter-arrow {
  font-size: 20rpx;
  color: #94a3b8;
  flex-shrink: 0;
}

.oam-plus-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.oam-plus-btn-hover {
  background: #f1f5f9;
}

.oam-plus-icon {
  font-size: 40rpx;
  color: #334155;
  line-height: 1;
  font-weight: 300;
}

.oam-match-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.oam-match-item:last-child {
  border-bottom: none;
}

.oam-match-main {
  flex: 1;
  min-width: 0;
  padding-right: 16rpx;
}

.oam-match-actions {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-shrink: 0;
}

.oam-action-btn {
  margin: 0;
  padding: 0 18rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
}

.oam-action-btn::after {
  border: none;
}

.oam-action-btn--ghost {
  background: #f1f5f9;
  color: #475569;
}

.oam-action-btn--primary {
  background: #dbeafe;
  color: #1d4ed8;
}

.oam-action-btn--danger {
  background: #fee2e2;
  color: #dc2626;
}

.oam-commercial-desc {
  margin-top: 6rpx;
  color: #64748b;
}

.oam-match-id {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.rl-empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
  padding: 0 16rpx;
}

.oam-fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 24rpx;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.35);
}

.oam-fab-hover {
  opacity: 0.92;
}

.oam-fab-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

/* AI 辅助导入工具栏 */
.oam-ai-helper-bar {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.oam-ai-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: #ffffff;
  color: #2563eb;
  border: 1rpx solid rgba(37, 99, 235, 0.2);
  box-shadow: 0 2rpx 10rpx rgba(15, 23, 42, 0.04);
  margin: 0;
}

.oam-ai-btn--primary {
  background: rgba(37, 99, 235, 0.08);
  color: #1d4ed8;
}

/* Modal 弹窗 */
.oam-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.oam-modal-card {
  width: 86%;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.2);
}

.oam-modal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
  text-align: center;
  margin-bottom: 12rpx;
}

.oam-modal-sub {
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 24rpx;
}

.oam-modal-textarea {
  width: 100%;
  height: 320rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 18rpx;
  padding: 20rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #0f172a;
  line-height: 1.5;
  margin-bottom: 28rpx;
}

.oam-modal-actions {
  display: flex;
  gap: 20rpx;
}

.oam-modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.oam-modal-btn--cancel {
  background: #f1f5f9;
  color: #64748b;
}

.oam-modal-btn--confirm {
  background: #2563eb;
  color: #ffffff;
}

/* 批量选择与批量删除 */
.oam-batch-toggle-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  background: #ffffff;
  color: #2563eb;
  border: 1rpx solid rgba(37, 99, 235, 0.25);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  flex-shrink: 0;
}

.oam-batch-toggle-btn::after {
  border: none;
}

.oam-batch-toggle-btn--active {
  background: #2563eb;
  color: #ffffff;
  border-color: #2563eb;
}

.oam-checkbox-wrapper {
  padding-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.oam-checkbox {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 3rpx solid #cbd5e1;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.15s ease;
}

.oam-checkbox--checked {
  background: #2563eb;
  border-color: #2563eb;
}

.oam-checkbox--disabled {
  background: #f1f5f9;
  border-color: #e2e8f0;
}

.oam-checkbox-icon {
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.oam-checkbox-icon-disabled {
  color: #94a3b8;
  font-size: 20rpx;
  line-height: 1;
}

.oam-batch-tag-disabled {
  font-size: 22rpx;
  color: #94a3b8;
  background: #f1f5f9;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.oam-batch-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  padding: 24rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 24rpx rgba(15, 23, 42, 0.08);
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  z-index: 100;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.oam-batch-bar-left {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 0;
}

.oam-batch-bar-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.oam-batch-bar-center {
  display: flex;
  align-items: center;
}

.oam-batch-count-text {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
}

.oam-batch-bar-right {
  display: flex;
  align-items: center;
}

.oam-batch-btn {
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.oam-batch-btn::after {
  border: none;
}

.oam-batch-btn--danger {
  background: #ef4444;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.3);
}

.oam-batch-btn--danger[disabled] {
  background: #fca5a5 !important;
  color: #ffffff !important;
  box-shadow: none;
  opacity: 0.7;
}

.oam-seq-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
  font-weight: 700;
  vertical-align: middle;
}

