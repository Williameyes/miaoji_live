<view class="rl-root oam-root">

  <view class="rl-header">
    <view class="rl-kicker">OAM · 场次维护</view>
    <view class="rl-title">场次列表</view>
    <view class="rl-sub">挂载监控时后端会自动识别并入库主播，无需单独维护</view>
  </view>

  <view class="oam-toolbar-row">
    <picker
      class="oam-filter-picker"
      mode="selector"
      range="{{filterOptions}}"
      range-key="name"
      value="{{filterIndex}}"
      bindchange="onFilterChange"
    >
      <view class="oam-filter-pill">
        <text class="oam-filter-text">{{filterOptions[filterIndex].name}}</text>
        <text class="oam-filter-arrow">▾</text>
      </view>
    </picker>
    <view class="oam-plus-btn" bindtap="onPlusTap" hover-class="oam-plus-btn-hover">
      <text class="oam-plus-icon">＋</text>
    </view>
  </view>

  <view class="rl-empty" wx:if="{{loading}}">
    <text>加载中…</text>
  </view>

  <view class="rl-card" wx:elif="{{matchRows.length}}">
    <block wx:for="{{matchRows}}" wx:key="id">
      <view class="oam-match-item" hover-class="rl-list-item-hover">
        <view class="oam-match-main" bindtap="onEditMatch" data-id="{{item.id}}">
          <view class="rl-list-title">{{item.teamA}} vs {{item.teamB}}</view>
          <view class="rl-list-desc">{{item.startTimeText}} · {{item.tournamentName}}</view>
          <view class="rl-list-desc oam-commercial-desc">{{item.commercialText}}</view>
        </view>
        <view class="oam-match-actions">
          <button class="oam-action-btn oam-action-btn--ghost" bindtap="onEditMatch" data-id="{{item.id}}">编辑</button>
          <button class="oam-action-btn oam-action-btn--ghost" bindtap="onOpenPromo" data-id="{{item.id}}">推广</button>
          <button class="oam-action-btn oam-action-btn--primary" bindtap="onOpenMonitor" data-id="{{item.id}}">监控</button>
        </view>
      </view>
    </block>
  </view>

  <view class="rl-empty" wx:else>
    <text>暂无场次</text>
    <text class="rl-empty-sub">先选择赛事，再新增或批量导入；导入后列表会自动刷新</text>
  </view>

  <view class="oam-fab" bindtap="onNewMatch" hover-class="oam-fab-hover">
    <text class="oam-fab-text">新增场次</text>
  </view>

</view>
