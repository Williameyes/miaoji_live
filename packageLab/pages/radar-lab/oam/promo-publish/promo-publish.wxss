@import '../../common/common.wxss';

.pp-check-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.pp-check-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #64748b;
}

.pp-check-item--ok {
  color: #059669;
}

.pp-check-item--fail {
  color: #dc2626;
}

.pp-check-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #cbd5e1;
  flex-shrink: 0;
}

.pp-check-item--ok .pp-check-dot {
  background: #10b981;
}

.pp-check-item--fail .pp-check-dot {
  background: #ef4444;
}

.pp-status-pill {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-left: 12rpx;
}

.pp-status-pill--on {
  background: #dcfce7;
  color: #15803d;
}

.pp-status-pill--off {
  background: #f1f5f9;
  color: #64748b;
}

.pp-ads-preview {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.pp-ads-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.pp-wxacode-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 8rpx;
}

.pp-wxacode-img {
  width: 360rpx;
  height: 360rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.pp-wxacode-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
  text-align: center;
}

.pp-save-wxacode-btn {
  width: 100%;
  margin-top: 20rpx;
}

.pp-edit-link {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #2563eb;
  text-align: center;
}
