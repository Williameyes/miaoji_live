@import '../common/common.wxss';

/* 快捷输入场次 ID 栏 */
.direct-match-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.direct-match-input {
  flex: 1;
  background: #ffffff;
  border: 2rpx solid #cbd5e1;
  border-radius: 16rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #0f172a;
}

.direct-match-btn {
  width: 180rpx !important;
  height: 84rpx;
  line-height: 84rpx;
  background: #2563eb;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  border-radius: 16rpx;
  padding: 0;
  margin: 0;
}

/* 场次状态筛选 Tab */
.match-filter-tabs {
  display: flex;
  flex-direction: row;
  background: #f1f5f9;
  border-radius: 14rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.match-filter-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
  border-radius: 10rpx;
  transition: all 0.2s ease;
}

.match-filter-tab.active {
  background: #ffffff;
  color: #2563eb;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 正在监测场次列表样式 */
.active-match-item {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.active-match-item:last-child {
  border-bottom: none;
}

.active-match-main {
  flex: 1;
  min-width: 0;
}

.active-match-id {
  color: #94a3b8;
  font-size: 20rpx;
  margin-top: 4rpx;
}

.active-match-badge-wrap {
  flex-shrink: 0;
  margin-left: 16rpx;
}

/* 空态快捷按钮 */
.empty-action-btns {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  width: 100%;
  justify-content: center;
}

.empty-btn {
  font-size: 24rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  padding: 0 28rpx !important;
}

/* 主播单选列表 */
.anchor-radio-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 12rpx;
}

.anchor-radio-label {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #f8fafc;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.anchor-radio-label radio {
  margin-right: 20rpx;
  transform: scale(0.9);
}

.anchor-radio-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.anchor-radio-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.anchor-radio-url {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 表单辅助文字与样式 */
.rl-label-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.warmup-field-val {
  font-size: 26rpx;
  font-weight: 600;
  color: #2563eb;
}

.warmup-tips {
  margin-top: 24rpx;
  background: #f0fdf4;
  border-left: 6rpx solid #16a34a;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
}

.warmup-tip-item {
  font-size: 22rpx;
  color: #15803d;
  line-height: 1.5;
  margin-bottom: 8rpx;
}

.warmup-tip-item:last-child {
  margin-bottom: 0;
}

/* ================== 战报视图样式 ================== */
.report-hero {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border: 1rpx solid #bfdbfe;
  padding: 30rpx 28rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.report-hero-main {
  display: flex;
  flex-direction: column;
}

.report-hero-val {
  font-size: 52rpx;
  font-weight: 800;
  color: #1d4ed8;
  line-height: 1.1;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.report-hero-lbl {
  font-size: 22rpx;
  font-weight: 600;
  color: #3b82f6;
  margin-top: 8rpx;
}

.report-hero-badge {
  flex-shrink: 0;
}

.report-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.report-grid-item {
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.report-grid-val {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.report-grid-lbl {
  font-size: 18rpx;
  color: #64748b;
  margin-top: 4rpx;
}

/* 🚨 标红失效账号警示栏 */
.invalid-alert-box {
  background: #fef2f2;
  border: 2rpx solid #f87171;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.08);
}

.invalid-alert-title {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
}

.invalid-alert-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.invalid-alert-text {
  font-size: 24rpx;
  font-weight: 700;
  color: #b91c1c;
}

.invalid-account-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.invalid-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: #fee2e2;
  border: 1rpx solid #fca5a5;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
}

.invalid-tag-name {
  font-size: 22rpx;
  font-weight: 700;
  color: #991b1b;
}

.invalid-tag-action {
  font-size: 18rpx;
  color: #dc2626;
  margin-left: 10rpx;
  text-decoration: underline;
}

.invalid-alert-tip {
  font-size: 20rpx;
  color: #7f1d1d;
  line-height: 1.5;
  border-top: 1rpx dashed #fca5a5;
  padding-top: 12rpx;
}

.code-snippet {
  font-family: monospace;
  background: #ffffff;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  border: 1rpx solid #f87171;
  color: #991b1b;
  font-weight: 600;
}

/* 进度条 */
.warmup-progress-box {
  margin-bottom: 24rpx;
}

.warmup-progress-label {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
  color: #475569;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.warmup-progress-num {
  color: #2563eb;
  font-weight: 700;
}

.warmup-progress-bar-bg {
  height: 12rpx;
  background: #e2e8f0;
  border-radius: 6rpx;
  overflow: hidden;
}

.warmup-progress-bar-fill {
  height: 100%;
  background: #2563eb;
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* 状态 Badge */
.warmup-status-badge {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.warmup-status-badge.status-pending {
  background: #f1f5f9;
  color: #64748b;
}

.warmup-status-badge.status-running {
  background: #dbeafe;
  color: #2563eb;
}

.warmup-status-badge.status-completed {
  background: #dcfce7;
  color: #15803d;
}

.warmup-status-badge.status-partial_failed {
  background: #fef3c7;
  color: #d97706;
}

.warmup-status-badge.status-failed {
  background: #fee2e2;
  color: #dc2626;
}

.warmup-status-badge.status-room_serialized_skip {
  background: #f1f5f9;
  color: #94a3b8;
  border: 1rpx solid #cbd5e1;
}

.warmup-results-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 16rpx;
}

.warmup-results-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.warmup-result-item {
  background: #f8fafc;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
  transition: all 0.2s ease;
}

.warmup-result-item.item-invalid {
  background: #fff1f2;
  border-color: #fecdd3;
}

.warmup-result-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.warmup-result-name-box {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.warmup-result-name {
  font-size: 24rpx;
  font-weight: 700;
  color: #1e293b;
}

.warmup-result-seq {
  font-size: 18rpx;
  color: #94a3b8;
  background: #e2e8f0;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.warmup-result-status {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.warmup-result-status.status-success {
  color: #15803d;
  background: #dcfce7;
}

.warmup-result-status.status-failed,
.warmup-result-status.status-cookie_invalid,
.warmup-result-status.status-like_failed,
.warmup-result-status.status-comment_failed {
  color: #b91c1c;
  background: #fee2e2;
}

.warmup-result-status.status-running {
  color: #1d4ed8;
  background: #dbeafe;
}

.warmup-result-status.status-pending {
  color: #475569;
  background: #f1f5f9;
}

.warmup-result-status.status-room_serialized_skip {
  color: #64748b;
  background: #f1f5f9;
}

.warmup-result-comment {
  font-size: 22rpx;
  color: #334155;
  background: #ffffff;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  word-break: break-all;
  border: 1rpx solid #e2e8f0;
}

.warmup-result-meta {
  display: flex;
  flex-direction: row;
  font-size: 20rpx;
  color: #64748b;
}

.warmup-result-error {
  font-size: 20rpx;
  color: #dc2626;
  margin-top: 8rpx;
  background: #fef2f2;
  padding: 8rpx 12rpx;
  border-radius: 6rpx;
  word-break: break-all;
}

.mon-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
  margin-bottom: 32rpx;
}

.mon-actions .rl-btn {
  width: 100%;
}

.warmup-tabs {
  display: flex;
  flex-direction: row;
  border-bottom: 2rpx solid #e2e8f0;
  margin-bottom: 24rpx;
}

.warmup-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #64748b;
  font-weight: 600;
  position: relative;
}

.warmup-tab.active {
  color: #2563eb;
}

.warmup-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 20%;
  right: 20%;
  height: 4rpx;
  background-color: #2563eb;
  border-radius: 2rpx;
}

/* 预览计划卡片样式 (玻璃微光质感) */
.preview-plan-card {
  margin-top: 24rpx;
  background: linear-gradient(135deg, #f0f7ff 0%, #e0f2fe 100%);
  border: 1rpx solid #bae6fd;
  border-radius: 16rpx;
  padding: 24rpx;
}

.preview-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #0369a1;
  margin-bottom: 16rpx;
}

.preview-grid {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.preview-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.preview-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #0284c7;
}

.preview-lbl {
  font-size: 20rpx;
  color: #0369a1;
  margin-top: 6rpx;
}

.preview-summary-text {
  font-size: 20rpx;
  color: #0e7490;
  line-height: 1.4;
  border-top: 1rpx dashed #bae6fd;
  padding-top: 12rpx;
}

/* 列表卡片与底部留白 */
.warmup-list-card {
  margin-bottom: 160rpx !important;
}

/* 场序 Badge */
.oam-seq-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #2563eb;
  background: #eff6ff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-right: 8rpx;
  font-weight: 700;
  vertical-align: middle;
}

/* 预热状态 Tag */
.warmup-badge-tag {
  font-size: 20rpx;
  color: #ea580c;
  background: #fff7ed;
  border: 1rpx solid #fed7aa;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-top: 8rpx;
  font-weight: 600;
  text-align: right;
  display: inline-block;
}

/* 底部悬浮操作按钮 (FAB) */
.oam-fab {
  position: fixed;
  left: 40rpx;
  right: 40rpx;
  bottom: calc(40rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 24rpx;
  background: #2563eb;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(37, 99, 235, 0.35);
  z-index: 50;
}

.oam-fab-hover {
  opacity: 0.92;
}

.oam-fab-text {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

/* 新增预热 Modal 弹窗 */
.warmup-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.6);
  backdrop-filter: blur(4px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.warmup-modal-card {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.warmup-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  text-align: center;
  margin-bottom: 8rpx;
}

.warmup-modal-sub {
  font-size: 24rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 32rpx;
}

.warmup-modal-actions {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
  margin-top: 36rpx;
}

.warmup-modal-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
  text-align: center;
  padding: 0;
  margin: 0;
}

.warmup-modal-btn::after {
  border: none;
}

.warmup-modal-btn.cancel-btn {
  background: #f1f5f9;
  color: #475569;
}

.warmup-modal-btn.confirm-btn {
  background: #2563eb;
  color: #ffffff;
}


/* 自由预热快捷卡片 */
.free-warmup-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
  border: 2rpx solid #334155;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.12);
  transition: all 0.2s ease;
}

.free-warmup-card-hover {
  transform: translateY(-2rpx);
  border-color: #3b82f6;
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.2);
}

.free-warmup-icon {
  font-size: 40rpx;
  margin-right: 18rpx;
}

.free-warmup-content {
  flex: 1;
}

.free-warmup-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 6rpx;
}

.free-warmup-desc {
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.free-warmup-arrow {
  font-size: 32rpx;
  color: #60a5fa;
  font-weight: 700;
  margin-left: 12rpx;
}

/* ================== 停止按钮与自由任务角标样式 ================== */
.warmup-status-badge.status-stopped {
  background: #fee2e2;
  color: #b91c1c;
  border: 1rpx solid #fca5a5;
}

.warmup-card-stop-btn {
  margin-left: 12rpx !important;
  padding: 4rpx 14rpx !important;
  font-size: 20rpx !important;
  line-height: 1.5 !important;
  border-radius: 12rpx !important;
  background: #dc2626 !important;
  color: #ffffff !important;
  font-weight: 600 !important;
}

.badge-free {
  background: #f3e8ff !important;
  color: #7e22ce !important;
  border-color: #d8b4fe !important;
}

.rl-badge-danger {
  background: #fee2e2;
  color: #dc2626;
}

.mon-actions .rl-btn.rl-btn-danger {
  background: #dc2626;
  color: #ffffff;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(220, 38, 38, 0.25);
}
