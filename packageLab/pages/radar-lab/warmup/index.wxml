<view class="rl-root">

  <!-- ==================== Step 1: 场次列表与快捷入口 ==================== -->
  <block wx:if="{{!selectedMatchId && !isFreeWarmup}}">
    <view class="rl-header">
      <view class="rl-kicker">雷达实验 · 直播预热</view>
      <view class="rl-title">预热任务管理</view>
      <view class="rl-sub">实时监控预热执行进度，支持历史任务复盘与一键叫停</view>
    </view>

    <!-- 自由直播间预热入口 (解耦赛事模式) -->
    <view class="free-warmup-card" bindtap="onStartFreeWarmup" hover-class="free-warmup-card-hover">
      <view class="free-warmup-icon">🚀</view>
      <view class="free-warmup-content">
        <view class="free-warmup-title">自由直播间预热 (无需关联比赛)</view>
        <view class="free-warmup-desc">直接粘贴任意抖音直播间口令/链接，智能挂房点赞与拟真互动</view>
      </view>
      <view class="free-warmup-arrow">›</view>
    </view>

    <!-- 快捷按 ID 直达栏 -->
    <view class="direct-match-bar">
      <input
        class="direct-match-input"
        type="number"
        placeholder="直接输入场次 ID (如 1001)"
        value="{{directMatchIdInput}}"
        bindinput="onDirectMatchIdInput"
        bindconfirm="onGoDirectMatch"
      />
      <button class="direct-match-btn" bindtap="onGoDirectMatch">进入预热</button>
    </view>

    <!-- 分类筛选 Tab -->
    <view class="match-filter-tabs">
      <view class="match-filter-tab {{listStatusTab === 'all' ? 'active' : ''}}" bindtap="onSwitchListTab" data-tab="all">全部任务</view>
      <view class="match-filter-tab {{listStatusTab === 'monitoring' ? 'active' : ''}}" bindtap="onSwitchListTab" data-tab="monitoring">进行中/排队中</view>
      <view class="match-filter-tab {{listStatusTab === 'ended' ? 'active' : ''}}" bindtap="onSwitchListTab" data-tab="ended">已结束/已停止</view>
    </view>

    <!-- 加载中 -->
    <view class="rl-empty" wx:if="{{loading}}">
      <text>加载预热任务中…</text>
    </view>

    <!-- 预热任务统一列表展现 -->
    <view class="rl-card warmup-list-card" wx:elif="{{warmupJobsList.length}}">
      <block wx:for="{{warmupJobsList}}" wx:key="job_id">
        <view
          class="active-match-item"
          bindtap="onSelectWarmupJobCard"
          data-job-id="{{item.job_id}}"
          data-match-id="{{item.match_id}}"
          hover-class="rl-list-item-hover"
        >
          <view class="active-match-main">
            <view class="rl-list-title">
              <text class="oam-seq-badge {{item.match_id ? '' : 'badge-free'}}">{{item.match_id ? ('#' + item.match_id) : '自由预热'}}</text>
              <text>{{item.match_title}}</text>
            </view>
            <view class="rl-list-desc">目标: {{item.live_url}}</view>
            <view class="rl-list-desc active-match-id">创建: {{item.createdAtText}} · {{item.account_count}}账号 · 累计点赞 {{item.total_likes || 0}}次</view>
          </view>
          <view class="active-match-badge-wrap">
            <text class="rl-badge {{item.statusBadgeClass}}">{{item.statusLabel}}</text>
            <button
              class="rl-btn rl-btn-danger warmup-card-stop-btn"
              size="mini"
              wx:if="{{item.isRunning}}"
              catchtap="onStopWarmup"
              data-job-id="{{item.job_id}}"
              data-match-id="{{item.match_id}}"
            >🛑 停止</button>
          </view>
        </view>
      </block>
    </view>

    <!-- 降级场次列表展现 -->
    <view class="rl-card warmup-list-card" wx:elif="{{activeMatches.length}}">
      <block wx:for="{{activeMatches}}" wx:key="id">
        <view
          class="active-match-item"
          bindtap="onSelectMatch"
          data-id="{{item.id}}"
          hover-class="rl-list-item-hover"
        >
          <view class="active-match-main">
            <view class="rl-list-title">
              <text wx:if="{{item.matchSeq}}" class="oam-seq-badge">#{{item.matchSeq}}</text>
              <text>{{item.teamA}} vs {{item.teamB}}</text>
            </view>
            <view class="rl-list-desc">{{item.startTimeText}} · {{item.tournamentName}}</view>
            <view class="rl-list-desc active-match-id">场次 ID: {{item.id}}</view>
          </view>
          <view class="active-match-badge-wrap">
            <text class="rl-badge {{item.statusBadgeClass}}">{{item.statusLabel}}</text>
            <view wx:if="{{item.hasWarmupBadge}}" class="warmup-badge-tag">🔥 {{item.warmupBadgeLabel}}</view>
          </view>
        </view>
      </block>
    </view>

    <!-- 空态与快捷入口 -->
    <view class="rl-card warmup-list-card" wx:else>
      <view class="rl-empty" style="padding: 48rpx 24rpx;">
        <text style="font-size: 28rpx; font-weight: 700; color: #334155;">暂无预热任务</text>
        <text class="rl-empty-sub" style="margin-top: 12rpx; margin-bottom: 24rpx;">
          点击下方按钮即可快速下发直播间预热任务。
        </text>
        <view class="empty-action-btns">
          <button class="rl-btn rl-btn-primary empty-btn" bindtap="onOpenNewWarmupModal">＋ 新增预热任务</button>
          <button class="rl-btn rl-btn-secondary empty-btn" bindtap="onGoMount">前往雷达挂载</button>
        </view>
      </view>
    </view>

    <!-- 悬浮新增预热按钮 -->
    <view class="oam-fab" bindtap="onOpenNewWarmupModal" hover-class="oam-fab-hover">
      <text class="oam-fab-text">＋ 新增预热任务</text>
    </view>
  </block>

  <!-- ==================== Step 2: 预热任务详情与运行监控 (常驻展示) ==================== -->
  <block wx:elif="{{(selectedMatchId || isFreeWarmup || warmupJobId) && !showConfigForm}}">
    <view class="rl-header">
      <view class="rl-kicker">雷达实验 · 预热任务详情</view>
      <view class="rl-title">{{selectedMatchTitle || "预热任务详情"}}</view>
      <view class="rl-sub">批次 ID: {{warmupJobId}} · {{selectedMatchId ? ('场次 ID: ' + selectedMatchId) : '自由预热模式'}}</view>
    </view>

    <!-- 战报汇总卡片 -->
    <view class="rl-card">
      <view class="rl-card-inner">
        <view class="report-hero">
          <view class="report-hero-main">
            <text class="report-hero-val">{{warmupReport.summaryDisplay.totalLikes || 0}}</text>
            <text class="report-hero-lbl">🔥 累计完成点赞量 (次)</text>
          </view>
          <view class="report-hero-badge">
            <text class="warmup-status-badge status-{{warmupStatus}}">{{warmupStatusLabel}}</text>
          </view>
        </view>

        <!-- 四宫格指标 -->
        <view class="report-grid">
          <view class="report-grid-item">
            <text class="report-grid-val">{{warmupCompletedCount}} / {{warmupAccountCount}}</text>
            <text class="report-grid-lbl">完成账号</text>
          </view>
          <view class="report-grid-item">
            <text class="report-grid-val">{{warmupReport.summaryDisplay.totalDurationMin || 0}}m</text>
            <text class="report-grid-lbl">累计挂房时长</text>
          </view>
          <view class="report-grid-item">
            <text class="report-grid-val">{{warmupReport.summaryDisplay.commentsSentCount || 0}}条</text>
            <text class="report-grid-lbl">已发弹幕</text>
          </view>
          <view class="report-grid-item">
            <text class="report-grid-val">{{warmupReport.warmup_mode || 'presence_light'}}</text>
            <text class="report-grid-lbl">预热模式</text>
          </view>
        </view>

        <!-- 进度条（仅运行中显示） -->
        <view class="warmup-progress-box" wx:if="{{warmupStatus === 'running' || warmupStatus === 'pending'}}">
          <view class="warmup-progress-label">
            <text>任务实时执行进度 ({{warmupCompletedCount}} / {{warmupAccountCount}})</text>
            <text class="warmup-progress-num">{{warmupProgressPercent}}%</text>
          </view>
          <view class="warmup-progress-bar-bg">
            <view class="warmup-progress-bar-fill" style="width: {{warmupProgressPercent}}%;"></view>
          </view>
        </view>

        <!-- 🚨 失效账号醒目告警栏 (标红高亮) -->
        <view class="invalid-alert-box" wx:if="{{hasInvalidAccounts}}">
          <view class="invalid-alert-title">
            <text class="invalid-alert-icon">⚠️</text>
            <text class="invalid-alert-text">检测到 {{invalidAccounts.length}} 个账号 Cookie 失效已自动隔离</text>
          </view>
          <view class="invalid-account-tags">
            <view class="invalid-tag" wx:for="{{invalidAccounts}}" wx:key="account_name" bindtap="onCopyLoginCommand" data-account="{{item.account_name}}">
              <text class="invalid-tag-name">🔒 {{item.account_name}}</text>
              <text class="invalid-tag-action">点此复制登录命令</text>
            </view>
          </view>
          <view class="invalid-alert-tip">
            💡 提示：失效账号已被雷达安全隔离。请在雷达机器终端执行：
            <text class="code-snippet">python capture_login.py --account 账号名</text> 重新扫码登录，完成后即可恢复！
          </view>
        </view>

        <!-- 各账号执行详情列表 -->
        <view class="warmup-results-title" style="margin-top: 24rpx;">📋 各账号预热执行明细</view>
        <view class="warmup-results-list" wx:if="{{warmupResults && warmupResults.length > 0}}">
          <view class="warmup-result-item {{item.status === 'cookie_invalid' ? 'item-invalid' : ''}}" wx:for="{{warmupResults}}" wx:key="sequence_index">
            <view class="warmup-result-row">
              <view class="warmup-result-name-box">
                <text class="warmup-result-name">{{item.account_name || '账号 #' + (item.sequence_index + 1)}}</text>
                <text class="warmup-result-seq">#{{item.sequence_index + 1}}</text>
              </view>
              <text class="warmup-result-status status-{{item.status}}">{{item.statusLabel}}</text>
            </view>
            <view class="warmup-result-comment" wx:if="{{item.comment_text}}">
              💬 {{item.comment_text}}
            </view>
            <view class="warmup-result-meta">
              <text>点赞: {{item.likes_done || 0}} / {{item.like_budget || 0}}</text>
              <text style="margin-left: 20rpx;">时长: {{item.duration_sec ? item.duration_sec + '秒' : '—'}}</text>
              <text style="margin-left: 20rpx;" wx:if="{{item.worker_id}}">节点: {{item.worker_id}}</text>
            </view>
            <view class="warmup-result-error" wx:if="{{item.error_message}}">
              ⚠️ 详情: {{item.error_message}}
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="mon-actions">
      <button class="rl-btn rl-btn-danger" wx:if="{{warmupStatus === 'running' || warmupStatus === 'pending'}}" bindtap="onStopWarmup">🛑 停止预热任务</button>
      <button class="rl-btn rl-btn-primary" bindtap="onRefreshReport">🔄 刷新任务状态</button>
      <button class="rl-btn rl-btn-secondary" bindtap="onShowConfigForm">⚡ 重新发起 / 调整预热</button>
      <button class="rl-btn rl-btn-secondary" bindtap="onBackToList">返回任务列表</button>
    </view>
  </block>

  <!-- ==================== Step 3: 预热配置与下发面板 ==================== -->
  <block wx:else>
    <view class="rl-header">
      <view class="rl-kicker">雷达实验 · 直播预热配置</view>
      <view class="rl-title">{{selectedMatchTitle}}</view>
      <view class="rl-sub">{{selectedMatchId ? ('场次 ID: ' + selectedMatchId) : '自由预热模式 · 无需关联比赛'}}</view>
    </view>

    <view class="rl-card">
      <view class="rl-card-inner">
        <!-- 切换源模式 -->
        <view class="warmup-tabs" wx:if="{{boundAnchors.length > 0}}">
          <view class="warmup-tab {{warmupSourceMode === 'select' ? 'active' : ''}}" bindtap="onSwitchSourceMode" data-mode="select">选择已绑定直播间</view>
          <view class="warmup-tab {{warmupSourceMode === 'input' ? 'active' : ''}}" bindtap="onSwitchSourceMode" data-mode="input">手动输入直播间</view>
        </view>

        <!-- 选择已绑定直播间 -->
        <view class="rl-field" wx:if="{{boundAnchors.length > 0 && warmupSourceMode === 'select'}}">
          <radio-group class="anchor-radio-group" bindchange="onAnchorSelectChange">
            <label class="anchor-radio-label" wx:for="{{boundAnchors}}" wx:key="secUserId">
              <radio value="{{item.liveUrl}}" checked="{{warmupLiveUrl === item.liveUrl}}" color="#2563eb" />
              <view class="anchor-radio-info">
                <text class="anchor-radio-name">{{item.anchorName || '未命名主播'}}</text>
                <text class="anchor-radio-url">{{item.liveUrl}}</text>
              </view>
            </label>
          </radio-group>
        </view>

        <!-- 手动输入直播间 -->
        <view class="rl-field" wx:if="{{boundAnchors.length === 0 || warmupSourceMode === 'input'}}">
          <text class="rl-label">输入直播间链接或分享口令</text>
          <textarea
            class="rl-textarea"
            placeholder="请复制抖音分享口令或粘贴直播间链接，二选一。例如：https://live.douyin.com/... 或 7.43 复制打开抖音..."
            value="{{warmupInputText}}"
            bindinput="onWarmupInputText"
            maxlength="-1"
            style="height: 140rpx;"
          />
        </view>

        <block>
          <!-- 账号数 -->
          <view class="rl-field" style="margin-top: 24rpx;">
            <view class="rl-label-row">
              <text class="rl-label">账号数</text>
              <text class="warmup-field-val">{{warmupAccountCount}} 个</text>
            </view>
            <slider
              min="1"
              max="10"
              value="{{warmupAccountCount}}"
              bindchange="onWarmupAccountChange"
              activeColor="#2563eb"
              show-value="{{false}}"
            />
          </view>

          <!-- 启用错峰接力调度 -->
          <view class="rl-field" style="margin-top: 24rpx; display: flex; flex-direction: row; justify-content: space-between; align-items: center;">
            <text class="rl-label">启用错峰接力调度</text>
            <switch checked="{{useTiledPlan}}" bindchange="onToggleTiledPlan" color="#2563eb" />
          </view>

          <!-- 模式 A: 错峰接力配置 -->
          <block wx:if="{{useTiledPlan}}">
            <view class="rl-field" style="margin-top: 24rpx;">
              <view class="rl-label-row">
                <text class="rl-label">直播场次总时长</text>
                <text class="warmup-field-val">{{totalShowDurationMin}} 分钟</text>
              </view>
              <slider
                min="30"
                max="360"
                step="10"
                value="{{totalShowDurationMin}}"
                bindchange="onTotalDurationChange"
                activeColor="#2563eb"
              />
            </view>

            <view class="rl-field" style="margin-top: 24rpx;">
              <view class="rl-label-row">
                <text class="rl-label">相邻账号重叠比例</text>
                <text class="warmup-field-val">{{overlapRatio}}</text>
              </view>
              <slider
                min="0.10"
                max="0.80"
                step="0.05"
                value="{{overlapRatio}}"
                bindchange="onOverlapRatioChange"
                activeColor="#2563eb"
              />
            </view>

            <view class="rl-field" style="margin-top: 24rpx;">
              <view class="rl-label-row">
                <text class="rl-label">并发账号上限</text>
                <text class="warmup-field-val">{{maxConcurrentPerRoom}} 个</text>
              </view>
              <slider
                min="1"
                max="5"
                step="1"
                value="{{maxConcurrentPerRoom}}"
                bindchange="onMaxConcurrentChange"
                activeColor="#2563eb"
              />
            </view>

            <!-- 方案预览卡片 -->
            <view class="preview-plan-card">
              <view class="preview-title">📊 错峰接力方案实时推演</view>
              <view class="preview-grid">
                <view class="preview-item">
                  <text class="preview-val">{{previewPlan.sessionDurationMin}}m</text>
                  <text class="preview-lbl">单账号挂房</text>
                </view>
                <view class="preview-item">
                  <text class="preview-val">{{previewPlan.overlapMin}}m</text>
                  <text class="preview-lbl">相邻重叠</text>
                </view>
                <view class="preview-item">
                  <text class="preview-val">{{previewPlan.staggerDelayMin}}m</text>
                  <text class="preview-lbl">接力间隔</text>
                </view>
                <view class="preview-item">
                  <text class="preview-val">{{maxConcurrentPerRoom}}台</text>
                  <text class="preview-lbl">并发上限</text>
                </view>
              </view>
              <view class="preview-summary-text">
                💡 任意时刻最多 {{maxConcurrentPerRoom}} 个账号同时在线，首尾精确覆盖 {{totalShowDurationMin}} 分钟，防止过多账号同时在线被风控。
              </view>
            </view>
          </block>

          <!-- 模式 B: 传统预热配置 -->
          <block wx:else>
            <view class="rl-field" style="margin-top: 24rpx;">
              <view class="rl-label-row">
                <text class="rl-label">挂房预热时长</text>
              </view>
              <input class="rl-input" style="background-color: #f1f5f9; color: #64748b;" value="{{warmupDurationMin}} 分钟" disabled="{{true}}" />
            </view>
          </block>

          <!-- 可选评论 -->
          <view class="rl-field">
            <text class="rl-label">当次评论 (可选，每行一条)</text>
            <textarea
              class="rl-textarea"
              placeholder="请输入评论内容，每行一条。如果不填写，将默认使用雷达本地评论库。"
              value="{{warmupCommentsText}}"
              bindinput="onWarmupCommentsInput"
              maxlength="-1"
              style="height: 180rpx;"
            />
          </view>

          <!-- 提示文案 -->
          <view class="warmup-tips">
            <view class="warmup-tip-item">💡 未填写评论时，将使用雷达端 data/warmup/comment_pool.json，请确保评论条数 ≥ 账号数</view>
            <view class="warmup-tip-item">⚡ 每个账号将在直播间挂房约 30 分钟，期间自动点赞 200~300 次并发送 1 条评论</view>
          </view>
        </block>
      </view>
    </view>

    <view class="mon-actions">
      <button class="rl-btn rl-btn-primary" disabled="{{submitting || (warmupSourceMode === 'select' && !warmupLiveUrl) || (warmupSourceMode === 'input' && !warmupInputText)}}" bindtap="onSubmitWarmup">下发预热任务</button>
      <button class="rl-btn rl-btn-secondary" wx:if="{{warmupJobId}}" bindtap="onHideConfigForm">查看任务详情</button>
      <button class="rl-btn rl-btn-secondary" bindtap="onBackToList">返回任务列表</button>
    </view>
  </block>

  <!-- ==================== 新增预热 Modal 弹窗 ==================== -->
  <view class="warmup-modal-overlay" wx:if="{{showNewWarmupModal}}">
    <view class="warmup-modal-card">
      <view class="warmup-modal-title">新增直播预热</view>
      <view class="warmup-modal-sub">选择或输入需要下发预热任务的比赛场次</view>

      <!-- 快速选择已有场次 -->
      <view class="rl-field" wx:if="{{availableMatchOptions && availableMatchOptions.length > 0}}">
        <text class="rl-label">从已有场次快速选择</text>
        <picker
          mode="selector"
          range="{{availableMatchOptions}}"
          range-key="label"
          value="{{newWarmupPickerIndex}}"
          bindchange="onNewWarmupPickerChange"
        >
          <view class="rl-input rl-picker-display">
            {{availableMatchOptions[newWarmupPickerIndex].label}}
          </view>
        </picker>
      </view>

      <!-- 手动输入场次 ID -->
      <view class="rl-field">
        <text class="rl-label">{{availableMatchOptions && availableMatchOptions.length > 0 ? '或直接输入场次 ID' : '请输入场次 ID'}}</text>
        <input
          class="rl-input"
          type="number"
          placeholder="如 1001"
          value="{{newWarmupMatchId}}"
          bindinput="onNewWarmupInputId"
          confirm-type="done"
          bindconfirm="onConfirmNewWarmup"
        />
      </view>

      <view class="warmup-modal-actions">
        <button class="warmup-modal-btn cancel-btn" bindtap="onCloseNewWarmupModal">取消</button>
        <button class="warmup-modal-btn confirm-btn" bindtap="onConfirmNewWarmup">下一步：配置预热</button>
      </view>
    </view>
  </view>

</view>

