  margin-right: 12rpx;
}

.cover-btn-send-log {
  display: inline-block;
  font-size: 22rpx;
  color: #93c5fd;
  padding: 8rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(147, 197, 253, 0.35);
