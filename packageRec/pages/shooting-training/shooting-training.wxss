}

.cover-btn-copy-log {
  display: inline-block;
  font-size: 22rpx;
  color: #fcd34d;
  padding: 8rpx 16rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border: 1rpx solid rgba(252, 211, 77, 0.35);
