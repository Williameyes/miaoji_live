}

.cover-nav-title {
  display: inline-block;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  vertical-align: middle;
}

.cover-nav-top {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  min-height: 88rpx;
  z-index: 9999;
  padding-left: 20rpx;
  box-sizing: border-box;
}

.cover-emergency-bar {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 100000;
  box-sizing: border-box;
  pointer-events: auto;
}

.cover-emergency-stop {
  margin: 8rpx 20rpx 12rpx;
  padding: 18rpx 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
  background-color: rgba(220, 38, 38, 0.92);
  border: 2rpx solid #fca5a5;
  border-radius: 16rpx;
}

.cover-nav-top-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding-left: 20rpx;
  min-height: 72rpx;
  box-sizing: border-box;
}

.cover-paused-banner {
  position: fixed;
  top: 42%;
  left: 40rpx;
  right: 40rpx;
  z-index: 50;
  background-color: rgba(15, 23, 42, 0.88);
  border: 1rpx solid rgba(252, 211, 77, 0.4);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  text-align: center;
}

.cover-paused-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fcd34d;
  margin-bottom: 12rpx;
}

.cover-paused-sub {
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
}

.cover-paused-hint {
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.5;
  margin-top: 12rpx;
}

.cover-bottom-pause--start {
  background-color: #16a34a !important;
  color: #ffffff !important;
  border-color: #4ade80 !important;
}

.cover-hoop-roi {
  position: fixed;
  z-index: 3;
  border: 2rpx dashed rgba(59, 130, 246, 0.85);
  background-color: rgba(59, 130, 246, 0.12);
  box-sizing: border-box;
}

/* 检测运行中：框锁定为纯参考展示，弱化视觉存在感，避免遮挡画面/误导可拖拽 */
.cover-hoop-roi--locked {
  border: 1.5rpx solid rgba(148, 163, 184, 0.55);
  background-color: transparent;
}

.cover-roi-label {
  position: absolute;
  top: -44rpx;
  left: 50%;
  width: 320rpx;
  margin-left: -160rpx;
  text-align: center;
  background-color: rgba(0, 0, 0, 0.65);
  color: #eff6ff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.cover-roi-label--locked {
  background-color: transparent;
  color: rgba(148, 163, 184, 0.85);
  font-size: 20rpx;
}

/* 框太小提示：放在框下方，避免跟上方 label 挤在一起 */
.cover-roi-warn {
  position: absolute;
  bottom: -68rpx;
  left: 50%;
  width: 360rpx;
  margin-left: -180rpx;
  text-align: center;
  background-color: rgba(220, 38, 38, 0.85);
  color: #fff7ed;
  font-size: 20rpx;
  line-height: 1.4;
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

/* 校准框四角缩放手柄：留足触控热区，方便真机拖动 */
.cover-roi-handle {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(59, 130, 246, 0.95);
  border: 3rpx solid #ffffff;
  border-radius: 50%;
  box-sizing: border-box;
}

.cover-roi-handle-tl { left: -24rpx; top: -24rpx; }
.cover-roi-handle-tr { right: -24rpx; top: -24rpx; }
.cover-roi-handle-bl { left: -24rpx; bottom: -24rpx; }
.cover-roi-handle-br { right: -24rpx; bottom: -24rpx; }

.cover-ball-pointer {
  position: fixed;
  z-index: 4;
  width: 24rpx;
  height: 24rpx;
  border-radius: 12rpx;
  background-color: #ef4444;
  border: 4rpx solid #ffffff;
  margin-left: -12rpx;
