/* ─────────────────────────────────────
   全局与页面底色（清新亮色主题 - 继承主页风格）
───────────────────────────────────── */
page {
  background-color: #EEF6FF;
  min-height: 100%;
}

.page-root {
  min-height: 100vh;
  padding: 0 28rpx calc(80rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: linear-gradient(160deg, #EEF6FF 0%, #E8F8F2 55%, #EFF6FF 100%);
  color: #1E293B;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  position: relative;
}

/* ─────────────────────────────────────
   头部 Header
───────────────────────────────────── */
.header {
  padding: 40rpx 8rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.header-nav-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease, background 0.15s ease;
}

.back-btn-hover {
  background: #F1F5F9;
  transform: scale(0.92);
}

.back-icon {
  font-size: 40rpx;
  color: #0F172A;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

.logo-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #0F172A;
  display: flex;
  align-items: center;
}

.italic-text {
  color: #0047FF;
  display: inline-block;
  transform: skewX(-15deg);
  margin: 0 4rpx;
}

.header-sub {
  font-size: 20rpx;
  color: #94A3B8;
  letter-spacing: 6rpx;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 加载态 */
.tn-loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  color: #64748B;
  font-size: 26rpx;
}

.tn-spinner {
  width: 44rpx;
  height: 44rpx;
  border: 4rpx solid rgba(37, 99, 235, 0.2);
  border-top-color: #2563EB;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 18rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 28rpx;
  border: 2rpx dashed #CBD5E1;
  margin: 20rpx 0;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 8rpx;
}

.empty-hint {
  font-size: 22rpx;
  color: #94A3B8;
}

/* ─────────────────────────────────────
   赛事 Banner Card (白色清新风格)
───────────────────────────────────── */
.td-header-card {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  border-radius: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.07), 0 1rpx 4rpx rgba(15, 23, 42, 0.04);
}

.td-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.td-tags-inline {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.td-sport-pill {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.05);
}

.td-sport-icon { font-size: 20rpx; }
.td-sport-label { font-size: 20rpx; color: #64748B; font-weight: 600; }

.td-format-pill {
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  border: 1px solid rgba(37, 99, 235, 0.18);
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* 精美置顶按钮 */
.td-pin-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  background: #F1F5F9;
  color: #64748B;
  border: 1rpx solid #E2E8F0;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  transition: all 0.2s ease;
}

.td-pin-btn.pinned {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}

.td-pin-btn-hover {
  opacity: 0.85;
  transform: scale(0.95);
}

.td-pin-icon {
  font-size: 20rpx;
}

.td-header-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0F172A;
  display: block;
  margin-bottom: 12rpx;
}

.td-header-meta {
  display: flex;
  gap: 24rpx;
}

.td-meta-item {
  font-size: 22rpx;
  color: #64748B;
  font-weight: 500;
}

/* ─────────────────────────────────────
   Tab Switcher 导航
───────────────────────────────────── */
.td-nav-tabs {
  display: flex;
  background: rgba(255, 255, 255, 0.88);
  padding: 6rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.td-nav-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748B;
  border-radius: 16rpx;
  transition: all 0.25s ease;
}

.td-nav-tab.active {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.28);
}

/* Stage Pill Bar */
.td-stage-bar {
  display: flex;
  gap: 14rpx;
  overflow-x: auto;
  margin-bottom: 20rpx;
  padding-bottom: 6rpx;
}

.td-stage-pill {
  padding: 8rpx 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  font-size: 22rpx;
  color: #64748B;
  white-space: nowrap;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.04);
  font-weight: 600;
}

.td-stage-pill.active {
  background: rgba(37, 99, 235, 0.1);
  color: #2563EB;
  border: 1px solid rgba(37, 99, 235, 0.25);
  font-weight: 700;
}

/* ─────────────────────────────────────
   通用 Table Card 结构 (赛程表 & 排行榜)
───────────────────────────────────── */
.td-table-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(15, 23, 42, 0.07);
}

.td-sched-hint {
  background: rgba(37, 99, 235, 0.08);
  color: #2563EB;
  font-size: 20rpx;
  font-weight: 600;
  padding: 10rpx 24rpx;
  text-align: center;
  border-bottom: 1rpx solid rgba(37, 99, 235, 0.15);
}

.td-sched-row-hover {
  background-color: #EFF6FF !important;
}

.td-table-header {
  display: flex;
  background: #F8FAFC;
  padding: 18rpx 14rpx;
  font-size: 22rpx;
  color: #64748B;
  font-weight: 700;
  text-align: center;
  border-bottom: 1rpx solid #E2E8F0;
  align-items: center;
}

.td-table-row {
  display: flex;
  padding: 20rpx 14rpx;
  border-bottom: 1rpx solid #F1F5F9;
  font-size: 26rpx;
  align-items: center;
  text-align: center;
}

.td-table-row:last-child {
  border-bottom: none;
}

/* ─────────────────────────────────────
   赛程表格专属列 (Schedule Table Columns - 支持文本自动换行不隐藏)
───────────────────────────────────── */
.col-sch-group {
  width: 95rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 4rpx;
  text-align: center;
  flex-shrink: 0;
}

.td-sch-seq-badge {
  font-size: 16rpx;
  font-weight: 800;
  color: #2563EB;
  background: rgba(37, 99, 235, 0.08);
  padding: 1rpx 6rpx;
  border-radius: 4rpx;
  line-height: 1.1;
}

.td-sch-group-tag {
  font-size: 18rpx;
  font-weight: 700;
  color: #475569;
  background: #F1F5F9;
  padding: 4rpx 6rpx;
  border-radius: 6rpx;
  word-break: break-all;
  white-space: normal;
  line-height: 1.25;
  text-align: center;
  display: inline-block;
}

.col-sch-teams {
  flex: 1.2;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 0 4rpx;
  text-align: center;
}

.td-sch-team {
  font-size: 22rpx;
  font-weight: 700;
  color: #0F172A;
  word-break: break-all;
  white-space: normal;
  line-height: 1.25;
  flex: 1;
}

.td-sch-team.home { text-align: right; }
.td-sch-team.away { text-align: left; }

.td-sch-team.win-team {
  color: #059669;
}

.td-sch-vs-sep {
  font-size: 18rpx;
  color: #94A3B8;
  font-weight: 400;
  margin: 0 2rpx;
  flex-shrink: 0;
}

.col-sch-score {
  width: 85rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.td-sch-score-num {
  font-size: 26rpx;
  font-weight: 900;
  color: #64748B;
}

.td-sch-score-num.win {
  color: #059669;
}

.td-sch-score-sep {
  font-size: 20rpx;
  color: #CBD5E1;
  margin: 0 2rpx;
}

.td-sch-pending-tag {
  font-size: 18rpx;
  color: #64748B;
  background: #F1F5F9;
  padding: 4rpx 6rpx;
  border-radius: 6rpx;
  font-weight: 600;
  word-break: break-all;
  white-space: normal;
}

.col-sch-time {
  width: 95rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  flex-shrink: 0;
}

.td-sch-date-val {
  font-size: 20rpx;
  font-weight: 700;
  color: #475569;
  line-height: 1.2;
}

.td-sch-clock-val {
  font-size: 18rpx;
  color: #94A3B8;
  line-height: 1.2;
  margin-top: 2rpx;
}

.col-sch-venue {
  width: 125rpx;
  font-size: 20rpx;
  color: #2563EB;
  text-align: center;
  font-weight: 600;
  word-break: break-all;
  white-space: normal;
  line-height: 1.25;
  flex-shrink: 0;
}

.td-sch-venue-val {
  word-break: break-all;
  white-space: normal;
  display: inline-block;
  line-height: 1.25;
}

.td-group-header-bar {
  padding: 24rpx 28rpx 16rpx;
  border-bottom: 2rpx solid #F1F5F9;
}

.td-group-title-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #0F172A;
}

.td-group-sub-text {
  font-size: 20rpx;
  color: #94A3B8;
}

/* ─────────────────────────────────────
   排行榜表格列 (Standings Table Columns)
───────────────────────────────────── */
.col-rank { width: 60rpx; }
.col-team { flex: 1; text-align: left; padding-left: 10rpx; }
.col-stat { width: 100rpx; font-size: 22rpx; color: #64748B; }
.col-pts { width: 70rpx; font-size: 26rpx; font-weight: 800; }

.td-rank-badge {
  display: inline-block;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 800;
  background: #F1F5F9;
  color: #64748B;
}

.rank-1 { background: linear-gradient(135deg, #F59E0B, #D97706); color: #FFF; }
.rank-2 { background: linear-gradient(135deg, #94A3B8, #64748B); color: #FFF; }
.rank-3 { background: linear-gradient(135deg, #D97706, #B45309); color: #FFF; }

.td-team-title {
  font-weight: 700;
  color: #0F172A;
}

.td-pts-highlight {
  color: #2563EB;
}

/* ─────────────────────────────────────
   Modal 比分修改弹窗
───────────────────────────────────── */
.td-modal-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(15, 23, 42, 0.5);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.td-modal-card {
  width: 84%;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.2);
}

.td-modal-title {
  font-size: 34rpx;
  font-weight: 800;
  text-align: center;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.td-modal-section-title {
  font-size: 22rpx;
  font-weight: 700;
  color: #2563EB;
  margin: 20rpx 0 12rpx;
}

.td-modal-teams-edit {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.td-team-input-box {
  flex: 1;
  min-width: 0;
}

.td-team-name-input {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 16rpx;
  height: 68rpx;
  padding: 0 16rpx;
  color: #0F172A;
  font-size: 26rpx;
  font-weight: 700;
  text-align: center;
}

.td-quick-teams-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
  max-height: 120rpx;
  overflow-y: auto;
}

.td-quick-team-pill {
  font-size: 18rpx;
  font-weight: 600;
  color: #475569;
  background: #F1F5F9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  transition: all 0.15s ease;
}

.td-quick-team-pill.selected {
  background: #2563EB;
  color: #FFFFFF;
  font-weight: 700;
}

.td-teams-vs-badge {
  font-size: 22rpx;
  font-weight: 900;
  color: #2563EB;
  padding-top: 24rpx;
}

.td-modal-inputs {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.td-input-group { flex: 1; }

.td-input-label {
  font-size: 22rpx;
  color: #64748B;
  display: block;
  margin-bottom: 10rpx;
}

.td-modal-input {
  background: #F8FAFC;
  border: 2rpx solid #E2E8F0;
  border-radius: 18rpx;
  height: 80rpx;
  padding: 0 20rpx;
  color: #0F172A;
  font-size: 36rpx;
  font-weight: 800;
  text-align: center;
}

.td-modal-actions {
  display: flex;
  gap: 20rpx;
}

.td-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.td-btn-cancel {
  background: #F1F5F9;
  color: #64748B;
}

.td-btn-confirm {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 14rpx rgba(37, 99, 235, 0.3);
}

/* ─────────────────────────────────────
   置顶微标（右上角独立）与分享转发主按钮样式
───────────────────────────────────── */
.td-pin-badge-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  background: #F1F5F9;
  color: #64748B;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  border: 1rpx solid #E2E8F0;
  transition: all 0.2s ease;
}

.td-pin-badge-btn.pinned {
  background: rgba(37, 99, 235, 0.12);
  color: #2563EB;
  border-color: rgba(37, 99, 235, 0.3);
  font-weight: 700;
}

.td-badge-hover {
  opacity: 0.85;
  transform: scale(0.96);
}

.td-pin-badge-icon {
  font-size: 18rpx;
}

/* 底部行：左侧日期 + 右侧独立醒目的 “分享转发” 按钮 */
.td-header-bottom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  gap: 16rpx;
}

.td-share-standalone-btn {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(37, 99, 235, 0.35);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  transition: all 0.2s ease;
  flex-shrink: 0;
}

.td-share-btn-hover {
  transform: translateY(-2rpx) scale(0.96);
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.45);
}

.td-share-icon {
  font-size: 22rpx;
}

.canvas-offscreen-wrap {
  position: absolute;
  left: -9999px;
  top: -9999px;
  overflow: hidden;
  opacity: 0;
  pointer-events: none;
}

.poster-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.75);
  backdrop-filter: blur(8px);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.poster-modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFFFF;
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 50rpx rgba(0, 0, 0, 0.25);
  display: flex;
  flex-direction: column;
  max-height: 88vh;
}

.poster-modal-header {
  padding: 24rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid #F1F5F9;
}

.poster-modal-title-wrap {
  display: flex;
  flex-direction: column;
}

.poster-modal-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0F172A;
}

.poster-modal-sub {
  font-size: 20rpx;
  color: #2563EB;
  font-weight: 600;
  margin-top: 2rpx;
}

.poster-close-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #F1F5F9;
  color: #64748B;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
}

.poster-close-hover {
  background: #E2E8F0;
}

.poster-preview-body {
  padding: 24rpx;
  overflow-y: auto;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8FAFC;
}

.poster-preview-img {
  width: 100%;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(15, 23, 42, 0.12);
  display: block;
}

.poster-modal-footer {
  padding: 24rpx 32rpx 24rpx;
  background: #FFFFFF;
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.poster-share-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #0F172A;
  margin-bottom: 16rpx;
}

.poster-modal-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
}

.poster-btn {
  flex: 1;
  height: 84rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  border: none;
}

/* 微信好友：微信经典绿 */
.poster-btn-friend {
  background: linear-gradient(135deg, #07C160 0%, #059669 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(7, 193, 96, 0.35);
}

/* 朋友圈：科技高亮蓝 */
.poster-btn-timeline {
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(37, 99, 235, 0.35);
}

/* 关闭文字按钮 */
.poster-close-text-btn {
  margin-top: 18rpx;
  padding: 6rpx 0;
  font-size: 26rpx;
  color: #94A3B8;
  font-weight: 600;
  text-align: center;
  width: 100%;
  transition: color 0.15s ease;
}

.poster-close-text-hover {
  color: #475569;
}

