<view class="page-root" style="padding-top: {{statusBarHeight}}px;">

  <!-- ===== 头部 ===== -->
  <view class="header">
    <view class="header-nav-row">
      <view class="back-btn" bindtap="onGoBack" hover-class="back-btn-hover">
        <text class="back-icon">‹</text>
      </view>
      <view class="logo-text">
        赛事<text class="italic-text">详</text>情
      </view>
    </view>
    <text class="header-sub">STANDINGS & SCHEDULE</text>
  </view>

  <view class="tn-loading" wx:if="{{loading}}">
    <view class="tn-spinner"></view>
    <text>正在加载赛事详情与实时排行榜…</text>
  </view>

  <block wx:elif="{{detail}}">
    <!-- 头部 Banner Card (白色清新风格) -->
    <view class="td-header-card">
      <view class="td-header-top">
        <view class="td-tags-inline">
          <view class="td-sport-pill">
            <text class="td-sport-icon">{{detail.sport_type === 'soccer' ? '⚽' : '🏀'}}</text>
            <text class="td-sport-label">{{detail.sport_type === 'soccer' ? '足球' : '篮球'}}</text>
          </view>
          <view class="td-format-pill">
            {{detail.format === 'CUP' ? '赛会制' : '联赛制'}}
          </view>
        </view>

        <!-- 置顶按钮：独立置于右上角，精致微标 -->
        <view class="td-pin-badge-btn {{isPinned ? 'pinned' : ''}}" bindtap="onTogglePin" hover-class="td-badge-hover">
          <text class="td-pin-badge-icon">📌</text>
          <text class="td-pin-badge-text">{{isPinned ? '已置顶' : '置顶'}}</text>
        </view>
      </view>

      <!-- 赛事大标题 -->
      <text class="td-header-title">{{detail.tournament_name}}</text>

      <!-- 底部行：左侧日期 + 右侧单独醒目的“分享转发”胶囊按钮 -->
      <view class="td-header-bottom-row">
        <view class="td-header-meta">
          <text class="td-meta-item">📅 {{detail.start_date}} ~ {{detail.end_date}}</text>
        </view>

        <view class="td-share-standalone-btn" bindtap="onGeneratePoster" hover-class="td-share-btn-hover">
          <text class="td-share-icon">✨</text>
          <text class="td-share-text">分享转发</text>
        </view>
      </view>
    </view>

    <!-- 主 Tab 切换 (赛程 | 排行榜) -->
    <view class="td-nav-tabs">
      <view class="td-nav-tab {{activeTab === 'schedule' ? 'active' : ''}}" data-tab="schedule" bindtap="onTabSwitch">
        赛程表
      </view>
      <view class="td-nav-tab {{activeTab === 'standings' ? 'active' : ''}}" data-tab="standings" bindtap="onTabSwitch">
        🏆 积分排行榜
      </view>
    </view>

    <!-- 阶段/组别切换微条 (Stage Pills) -->
    <view class="td-stage-bar" wx:if="{{stageList.length > 1}}">
      <block wx:for="{{stageList}}" wx:key="id">
        <view 
          class="td-stage-pill {{selectedStageId === item.id ? 'active' : ''}}" 
          data-stage="{{item.id}}" 
          bindtap="onStageSwitch"
        >
          {{item.name}}
        </view>
      </block>
    </view>

    <!-- Tab 1: 赛程页面 (专业表格风赛程表：参考标准赛程排版，每行充实组别、对阵、比分、时间、场地) -->
    <view class="td-tab-content" wx:if="{{activeTab === 'schedule'}}">
      <view class="empty-state" wx:if="{{!currentMatches.length}}">
        <text class="empty-icon">📅</text>
        <text class="empty-text">该阶段下暂无赛程安排</text>
      </view>

      <view class="td-table-card" wx:else>
        <!-- 赛程表格头 (支持表头点击排序) -->
        <view class="td-table-header td-sched-header">
          <view class="col-sch-group td-sortable-col {{sortField === 'group' ? 'active' : ''}}" bindtap="onSortColumn" data-field="group" hover-class="td-col-hover" hover-stay-time="100">
            <text>组别</text>
            <text class="td-sort-icon">{{sortField === 'group' ? (sortOrder === 'asc' ? '▲' : '▼') : '↕'}}</text>
          </view>
          <view class="col-sch-teams td-sortable-col {{sortField === 'teams' ? 'active' : ''}}" bindtap="onSortColumn" data-field="teams" hover-class="td-col-hover" hover-stay-time="100">
            <text>比赛队</text>
            <text class="td-sort-icon">{{sortField === 'teams' ? (sortOrder === 'asc' ? '▲' : '▼') : '↕'}}</text>
          </view>
          <view class="col-sch-score td-sortable-col {{sortField === 'score' ? 'active' : ''}}" bindtap="onSortColumn" data-field="score" hover-class="td-col-hover" hover-stay-time="100">
            <text>比分/状态</text>
            <text class="td-sort-icon">{{sortField === 'score' ? (sortOrder === 'asc' ? '▲' : '▼') : '↕'}}</text>
          </view>
          <view class="col-sch-time td-sortable-col {{sortField === 'time' ? 'active' : ''}}" bindtap="onSortColumn" data-field="time" hover-class="td-col-hover" hover-stay-time="100">
            <text>时间</text>
            <text class="td-sort-icon">{{sortField === 'time' ? (sortOrder === 'asc' ? '▲' : '▼') : '↕'}}</text>
          </view>
          <view class="col-sch-venue td-sortable-col {{sortField === 'venue' ? 'active' : ''}}" bindtap="onSortColumn" data-field="venue" hover-class="td-sort-icon-hover" hover-stay-time="100">
            <text>场地</text>
            <text class="td-sort-icon">{{sortField === 'venue' ? (sortOrder === 'asc' ? '▲' : '▼') : '↕'}}</text>
          </view>
        </view>

        <!-- 赛程表格行 (支持直接单击行或点击「复制」快速复制比赛) -->
        <block wx:for="{{currentMatches}}" wx:key="match_id">
          <view 
            class="td-table-row td-sched-row" 
            data-match="{{item}}" 
            data-id="{{item.match_id}}"
            bindtap="onMatchRowTap"
            bindlongpress="onMatchLongPress" 
            hover-class="td-sched-row-hover"
          >
            <!-- 组别/阶段与场次序号 -->
            <view class="col-sch-group">
              <text class="td-sch-seq-badge" wx:if="{{item.match_seq}}">#{{item.match_seq}}</text>
              <text class="td-sch-group-tag">{{item.stage_id !== 'stage_default' ? item.stage_id : '常规赛'}}</text>
            </view>

            <!-- 对阵球队 (队伍A vs 队伍B，小组完赛后自动替换 A1/B2 组别代号) -->
            <view class="col-sch-teams">
              <text class="td-sch-team home {{item.score_a > item.score_b ? 'win-team' : ''}}">{{item.display_team_a || item.team_a}}</text>
              <text class="td-sch-vs-sep">-</text>
              <text class="td-sch-team away {{item.score_b > item.score_a ? 'win-team' : ''}}">{{item.display_team_b || item.team_b}}</text>
            </view>

            <!-- 比分 / 待录入 / 未开始 状态 -->
            <view class="col-sch-score">
              <block wx:if="{{item.hasValidScores}}">
                <text class="td-sch-score-num {{item.score_a > item.score_b ? 'win' : ''}}">{{item.score_a}}</text>
                <text class="td-sch-score-sep">:</text>
                <text class="td-sch-score-num {{item.score_b > item.score_a ? 'win' : ''}}">{{item.score_b}}</text>
                <view wx:if="{{isAiReportWhitelisted}}" class="td-report-badge">🤖 战报</view>
              </block>
              <block wx:elif="{{item.isPendingScore}}">
                <text class="td-sch-pending-tag is-overdue">待录入</text>
              </block>
              <block wx:else>
                <text class="td-sch-pending-tag">未开始</text>
              </block>
            </view>

            <!-- 比赛时间 (固定分成两行: 日期 + 时间) -->
            <view class="col-sch-time">
              <text class="td-sch-date-val">{{item.datePart}}</text>
              <text class="td-sch-clock-val">{{item.timePart}}</text>
            </view>

            <!-- 比赛场地 (不合并，逐行填充) -->
            <view class="col-sch-venue">
              <text class="td-sch-venue-val">{{item.venue || '—'}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- Tab 2: 排行榜页面 (支持选择全部时平铺堆叠展示多小组积分榜) -->
    <view class="td-tab-content" wx:if="{{activeTab === 'standings'}}">
      <view class="empty-state" wx:if="{{!currentGroupedStandings.length}}">
        <text class="empty-icon">🏆</text>
        <text class="empty-text">暂无排行榜数据</text>
        <text class="empty-hint">比赛录入比分完赛后将自动计算积分与排名</text>
      </view>

      <block wx:else>
        <block wx:for="{{currentGroupedStandings}}" wx:key="stage_id" wx:for-item="group">
          <view class="td-table-card" style="margin-bottom: 24rpx;">
            <!-- 小组积分榜卡片标题 -->
            <view class="td-group-header-bar flex-between" wx:if="{{currentGroupedStandings.length > 1 || group.stage_name !== 'all'}}">
              <text class="td-group-title-text">🏆 {{group.stage_name}} 积分榜</text>
              <text class="td-group-sub-text">按积分 / 净胜分排序</text>
            </view>

            <view class="td-table-header">
              <text class="col-rank">排名</text>
              <text class="col-team">球队</text>
              <text class="col-stat">已赛</text>
              <text class="col-stat">胜/平/负</text>
              <text class="col-stat">净胜</text>
              <text class="col-pts">积分</text>
            </view>

            <block wx:for="{{group.list}}" wx:key="team_name">
              <view class="td-table-row {{index < 3 ? 'top3' : ''}}">
                <view class="col-rank">
                  <text class="td-rank-badge rank-{{item.rank}}">{{item.rank}}</text>
                </view>
                <text class="col-team td-team-title">{{item.team_name}}</text>
                <text class="col-stat">{{item.played}}</text>
                <text class="col-stat">{{item.won}}/{{item.draw}}/{{item.lost}}</text>
                <text class="col-stat">{{item.net_score > 0 ? '+' + item.net_score : item.net_score}}</text>
                <text class="col-pts td-pts-highlight">{{item.points}}</text>
              </view>
            </block>
          </view>
        </block>
      </block>
    </view>
  </block>

  <!-- 3. 加载异常或空数据兜底状态 -->
  <view class="td-fail-state" wx:else>
    <view class="td-fail-icon">⚠️</view>
    <view class="td-fail-title">未能加载到赛事详情</view>
    <view class="td-fail-desc">{{loadError || '未找到该赛事数据或网络异常，请重试'}}</view>
    <button class="td-fail-retry-btn" bindtap="onRetryDetail">重新加载</button>
  </view>

  <!-- 比赛信息编辑 Modal (所有者权限) -->
  <view class="td-modal-overlay" wx:if="{{showScoreModal}}">
    <view class="td-modal-card">
      <view class="td-modal-title">编辑比赛信息</view>

      <!-- 队伍名称编辑 (智能识别胜者 + 快捷点选队伍) -->
      <view class="td-modal-section-title">对阵队伍 (自动推算胜者，点击下方队伍快速填入)</view>
      <view class="td-modal-teams-edit">
        <view class="td-team-input-box">
          <text class="td-input-label">主队 (队伍A)</text>
          <input class="td-team-name-input" value="{{editTeamA}}" bindinput="onEditTeamAInput" placeholder="输入或点选主队" />
          <view class="td-quick-teams-bar" wx:if="{{allTeamList.length}}">
            <block wx:for="{{allTeamList}}" wx:key="*this">
              <view 
                class="td-quick-team-pill {{editTeamA === item ? 'selected' : ''}}" 
                data-team="{{item}}" 
                data-target="teamA" 
                bindtap="onQuickSelectTeam"
              >
                {{item}}
              </view>
            </block>
          </view>
        </view>
        <text class="td-teams-vs-badge">VS</text>
        <view class="td-team-input-box">
          <text class="td-input-label">客队 (队伍B)</text>
          <input class="td-team-name-input" value="{{editTeamB}}" bindinput="onEditTeamBInput" placeholder="输入或点选客队" />
          <view class="td-quick-teams-bar" wx:if="{{allTeamList.length}}">
            <block wx:for="{{allTeamList}}" wx:key="*this">
              <view 
                class="td-quick-team-pill {{editTeamB === item ? 'selected' : ''}}" 
                data-team="{{item}}" 
                data-target="teamB" 
                bindtap="onQuickSelectTeam"
              >
                {{item}}
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 比赛场地与时间编辑 -->
      <view class="td-modal-section-title">比赛时间与场地</view>
      <view class="td-modal-datetime-venue">
        <view class="td-modal-inputs" style="margin-bottom: 20rpx;">
          <view class="td-input-group">
            <text class="td-input-label">开赛日期</text>
            <picker mode="date" value="{{editStartDate}}" bindchange="onEditDateChange">
              <view class="td-picker-val">{{editStartDate || '选择日期'}}</view>
            </picker>
          </view>
          <view class="td-input-group">
            <text class="td-input-label">开赛时间</text>
            <picker mode="time" value="{{editStartTime}}" bindchange="onEditTimeChange">
              <view class="td-picker-val">{{editStartTime || '选择时间'}}</view>
            </picker>
          </view>
        </view>
        <view class="td-input-group" style="margin-bottom: 30rpx;">
          <text class="td-input-label">比赛场地</text>
          <input class="td-venue-input" value="{{editVenue}}" bindinput="onEditVenueInput" placeholder="请输入比赛场地 (例如：1号场地)" />
        </view>
      </view>

      <!-- 比分录入 -->
      <view class="td-modal-section-title">比赛比分 (可留空，未开赛暂不录入)</view>
      <view class="td-modal-inputs">
        <view class="td-input-group">
          <text class="td-input-label">{{editTeamA || '主队'}} 得分</text>
          <input class="td-modal-input" type="number" value="{{scoreA}}" bindinput="onScoreAInput" placeholder="未开赛" />
        </view>
        <view class="td-input-group">
          <text class="td-input-label">{{editTeamB || '客队'}} 得分</text>
          <input class="td-modal-input" type="number" value="{{scoreB}}" bindinput="onScoreBInput" placeholder="未开赛" />
        </view>
      </view>

      <view class="td-modal-actions">
        <button class="td-btn td-btn-cancel" bindtap="onCloseScoreModal">取消</button>
        <button class="td-btn td-btn-confirm" disabled="{{submittingScore}}" bindtap="onSaveScore">保存修改</button>
      </view>
    </view>
  </view>

  <!-- ===== 离屏 Canvas 2D 绘图容器 (按需动态宽高) ===== -->
  <view class="canvas-offscreen-wrap">
    <canvas type="2d" id="posterCanvas" style="width: {{posterCanvasWidth || 750}}px; height: {{posterCanvasHeight || 1200}}px;"></canvas>
  </view>

  <!-- ===== 精美海报预览与分享 Modal 弹窗 ===== -->
  <view class="poster-modal-overlay" wx:if="{{showPosterModal}}">
    <view class="poster-modal-card">
      <view class="poster-modal-header">
        <view class="poster-modal-title-wrap">
          <text class="poster-modal-title">✨ 分享转发 · {{activeTab === 'schedule' ? '赛程表' : '积分排行榜'}}</text>
          <text class="poster-modal-sub">{{selectedStageName || '全部数据'}}</text>
        </view>
        <view class="poster-close-btn" bindtap="onClosePosterModal" hover-class="poster-close-hover">✕</view>
      </view>

      <!-- 海报高清预览区域 -->
      <view class="poster-preview-body">
        <image class="poster-preview-img" mode="widthFix" src="{{posterImgUrl}}" show-menu-by-longpress></image>
      </view>

      <!-- 操作按钮：分享至：微信好友 | 朋友圈 | 关闭 -->
      <view class="poster-modal-footer">
        <view class="poster-share-label">分享至：</view>
        <view class="poster-modal-actions">
          <button class="poster-btn poster-btn-friend" open-type="share" hover-class="poster-btn-hover">
            <text class="poster-btn-icon">💬</text> 微信好友
          </button>
          <button class="poster-btn poster-btn-timeline" bindtap="onShareToTimelineDirect" hover-class="poster-btn-hover">
            <text class="poster-btn-icon">🌐</text> 朋友圈
          </button>
        </view>
        <view class="poster-close-text-btn" bindtap="onClosePosterModal" hover-class="poster-close-text-hover">
          <text>关闭</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 复制比赛到直播记分 Modal 弹窗 ===== -->
  <view class="copy-modal-overlay" wx:if="{{showCopyModal}}" bindtap="onCloseCopyModal">
    <view class="copy-modal-card" catchtap="onStopPropagation">
      <view class="copy-modal-header">
        <view class="copy-modal-title-wrap">
          <text class="copy-modal-title">📋 复制该比赛到直播记分</text>
          <text class="copy-modal-sub">已自动预填赛程信息，确认后可前往记分</text>
        </view>
        <view class="copy-close-btn" bindtap="onCloseCopyModal" hover-class="copy-close-hover">✕</view>
      </view>

      <view class="copy-modal-body">
        <!-- 运动类型 -->
        <view class="copy-form-group">
          <text class="copy-form-label">运动类型</text>
          <view class="copy-sport-tags">
            <view class="copy-sport-pill {{copyDraft.sportType === 'basketball' ? 'active' : ''}}" bindtap="onCopySportChange" data-sport="basketball">
              <text class="copy-sport-icon">🏀</text> 篮球
            </view>
            <view class="copy-sport-pill {{copyDraft.sportType === 'football' ? 'active' : ''}}" bindtap="onCopySportChange" data-sport="football">
              <text class="copy-sport-icon">⚽</text> 足球
            </view>
            <view class="copy-sport-pill {{copyDraft.sportType === 'badminton' ? 'active' : ''}}" bindtap="onCopySportChange" data-sport="badminton">
              <text class="copy-sport-icon">🏸</text> 羽毛球
            </view>
          </view>
        </view>

        <!-- 开赛时间 -->
        <view class="copy-form-group">
          <text class="copy-form-label">开赛时间</text>
          <view class="copy-time-row">
            <picker mode="date" value="{{copyDraft.startDate}}" start="2020-01-01" end="2035-12-31" bindchange="onCopyStartDateChange">
              <view class="copy-picker-display">📅 {{copyDraft.startDate}}</view>
            </picker>
            <picker 
              mode="multiSelector" 
              range="{{timePickerRange}}" 
              value="{{timePickerValue}}" 
              bindchange="onCopyTimePickerChange"
            >
              <view class="copy-picker-display">⏰ {{copyDraft.startTime}}</view>
            </picker>
          </view>
        </view>

        <!-- 比赛名称 -->
        <view class="copy-form-group">
          <text class="copy-form-label">比赛名称</text>
          <input 
            class="copy-input" 
            placeholder="请输入比赛名称" 
            value="{{copyDraft.matchName}}" 
            bindinput="onCopyMatchNameInput"
          />
        </view>

        <!-- 主客队名称 -->
        <view class="copy-teams-row">
          <view class="copy-team-col">
            <view class="copy-team-label-wrap">
              <text class="copy-team-dot dot-home"></text>
              <text class="copy-form-label">主队名称</text>
            </view>
            <input 
              class="copy-input copy-input-team" 
              placeholder="主队名称" 
              value="{{copyDraft.teamAName}}" 
              bindinput="onCopyTeamANameInput"
            />
          </view>
          <view class="copy-vs-badge">VS</view>
          <view class="copy-team-col">
            <view class="copy-team-label-wrap">
              <text class="copy-team-dot dot-away"></text>
              <text class="copy-form-label">客队名称</text>
            </view>
            <input 
              class="copy-input copy-input-team" 
              placeholder="客队名称" 
              value="{{copyDraft.teamBName}}" 
              bindinput="onCopyTeamBNameInput"
            />
          </view>
        </view>
      </view>

      <view class="copy-modal-footer">
        <button class="copy-btn copy-btn-cancel" bindtap="onCloseCopyModal">取消</button>
        <button class="copy-btn copy-btn-confirm" bindtap="onConfirmCopyMatch">确认生成</button>
      </view>
    </view>
  </view>

  <!-- ===== 🤖 赛事战报推文预览与复制 Modal (白名单专属) ===== -->
  <view class="report-modal-mask" wx:if="{{showReportModal}}" bindtap="onCloseReportModal">
    <!-- 战报弹窗卡片 -->
    <view class="report-modal-card" catchtap="onStopPropagation">
      <view class="report-modal-header">
        <view class="report-header-titles">
          <view class="report-header-badge">
            <text class="report-header-icon">🏀</text>
            <text class="report-header-tag">AI 赛事战报</text>
            <text class="report-lab-tag">实验室</text>
            <text class="report-model-badge" wx:if="{{reportData && reportData.isAiGenerated}}">🤖 {{reportData.modelName || 'Qwen2.5-7B'}}</text>
          </view>
          <text class="report-modal-sub">已为微信公众号排版调优 · 随时一键复制</text>
        </view>
        <view class="report-close-btn" bindtap="onCloseReportModal" hover-class="copy-close-hover">✕</view>
      </view>

      <!-- 加载中状态 -->
      <view class="report-loading-box" wx:if="{{generatingReport}}">
        <view class="report-spinner"></view>
        <text class="report-loading-text">正在调用硅基流动大模型生成深度战报...</text>
        <text class="report-loading-sub">基于真实比分时序与战术走势智能推演 (约3~8秒)</text>
      </view>

      <!-- 战报展示区 -->
      <block wx:elif="{{reportData}}">
        <!-- 备选标题栏切换 -->
        <view class="report-titles-selector" wx:if="{{reportData.alternativeTitles && reportData.alternativeTitles.length > 1}}">
          <text class="report-selector-label">切换标题：</text>
          <view class="report-titles-pills">
            <view 
              class="report-title-pill {{selectedReportTitleIndex === index ? 'active' : ''}}" 
              wx:for="{{reportData.alternativeTitles}}" 
              wx:key="index"
              data-index="{{index}}"
              bindtap="onSelectReportTitle"
            >
              方案 {{index + 1}}
            </view>
          </view>
        </view>

        <!-- 战报滚动预览视窗 -->
        <scroll-view class="report-preview-scroll" scroll-y="true">
          <!-- 标题展示 -->
          <view class="report-preview-title">{{reportData.title}}</view>

          <!-- 大比分横幅 -->
          <view class="report-score-banner">
            <view class="report-team-box">
              <text class="report-team-name {{reportData.isAWin ? 'win' : ''}}">{{reportData.teamA}}</text>
              <text class="report-win-tag" wx:if="{{reportData.isAWin}}">🏆 胜方</text>
            </view>
            <view class="report-score-middle">
              <text class="report-score-val">{{reportData.scoreA}}</text>
              <text class="report-score-colon">:</text>
              <text class="report-score-val">{{reportData.scoreB}}</text>
            </view>
            <view class="report-team-box">
              <text class="report-team-name {{!reportData.isAWin && reportData.scoreA !== reportData.scoreB ? 'win' : ''}}">{{reportData.teamB}}</text>
              <text class="report-win-tag" wx:if="{{!reportData.isAWin && reportData.scoreA !== reportData.scoreB}}">🏆 胜方</text>
            </view>
          </view>

          <!-- 战况速评导语 -->
          <view class="report-summary-box">
            <text class="report-summary-lead">【速评】</text>
            <text class="report-summary-text">{{reportData.summary}}</text>
            <view class="report-user-focus" wx:if="{{reportData.userNote}}">
              <text class="focus-star">★</text>
              <text class="focus-text">焦点人物：{{reportData.userNote}}</text>
            </view>
          </view>

          <!-- 胜负转折点 (大模型分析) -->
          <view class="report-analysis-card turning-card" wx:if="{{reportData.turningPoint}}">
            <view class="analysis-card-title">⚡ 胜负转折点</view>
            <view class="analysis-card-content">{{reportData.turningPoint}}</view>
          </view>

          <!-- MVP 与关键点评 (大模型分析) -->
          <view class="report-analysis-card mvp-card" wx:if="{{reportData.mvpTake}}">
            <view class="analysis-card-title">🌟 关键先生与战术点评</view>
            <view class="analysis-card-content">{{reportData.mvpTake}}</view>
          </view>

          <!-- 四节比分表格 -->
          <view class="report-table-card" wx:if="{{reportData.quarterRows}}">
            <view class="report-table-title">📊 四节比分与进球看板</view>
            <view class="report-table-grid">
              <view class="grid-row grid-header">
                <text class="col-cell col-t">队伍</text>
                <text class="col-cell">Q1</text>
                <text class="col-cell">Q2</text>
                <text class="col-cell">Q3</text>
                <text class="col-cell">Q4</text>
                <text class="col-cell col-total">终场</text>
                <text class="col-cell col-three">三分</text>
              </view>
              <view class="grid-row">
                <text class="col-cell col-t {{reportData.isAWin ? 'win-bold' : ''}}">{{reportData.teamA}}</text>
                <text class="col-cell">{{reportData.quarterRows[0].scoreA}}</text>
                <text class="col-cell">{{reportData.quarterRows[1].scoreA}}</text>
                <text class="col-cell">{{reportData.quarterRows[2].scoreA}}</text>
                <text class="col-cell">{{reportData.quarterRows[3].scoreA}}</text>
                <text class="col-cell col-total {{reportData.isAWin ? 'win-bold' : ''}}">{{reportData.scoreA}}</text>
                <text class="col-cell col-three">{{reportData.shotsA.threes}}记</text>
              </view>
              <view class="grid-row">
                <text class="col-cell col-t {{!reportData.isAWin && reportData.scoreA !== reportData.scoreB ? 'win-bold' : ''}}">{{reportData.teamB}}</text>
                <text class="col-cell">{{reportData.quarterRows[0].scoreB}}</text>
                <text class="col-cell">{{reportData.quarterRows[1].scoreB}}</text>
                <text class="col-cell">{{reportData.quarterRows[2].scoreB}}</text>
                <text class="col-cell">{{reportData.quarterRows[3].scoreB}}</text>
                <text class="col-cell col-total {{!reportData.isAWin && reportData.scoreA !== reportData.scoreB ? 'win-bold' : ''}}">{{reportData.scoreB}}</text>
                <text class="col-cell col-three">{{reportData.shotsB.threes}}记</text>
              </view>
            </view>
          </view>

          <!-- 高光切片归档 -->
          <view class="report-highlights-card" wx:if="{{reportData.highlights && reportData.highlights.length > 0}}">
            <view class="report-table-title">⚡ 赛场高光瞬间归档</view>
            <view class="report-highlight-item" wx:for="{{reportData.highlights}}" wx:key="idx">
              <text class="hl-badge">🎬 高光#{{item.idx}}</text>
              <text class="hl-desc">{{item.desc}}</text>
            </view>
          </view>
        </scroll-view>

        <!-- 选填备注与重新生成操作栏 -->
        <view class="report-input-row">
          <view class="report-note-input-wrap">
            <text class="note-prefix">★</text>
            <input 
              class="report-note-input" 
              placeholder="选填焦点/MVP (如: 7号王强连得5分)" 
              placeholder-class="input-ph" 
              value="{{reportUserNote}}" 
              bindinput="onReportUserNoteInput"
            />
          </view>
          <button class="btn-regenerate" bindtap="onRegenerateReport" hover-class="btn-hover">
            🔄 重新生成
          </button>
        </view>

        <!-- 底部导出按钮栏 -->
        <view class="report-modal-footer">
          <button class="btn-copy-clean-text" bindtap="onCopyReportPlainText" hover-class="btn-hover">
            📋 复制战报文本 (干净纯文本)
          </button>
        </view>
      </block>
    </view>
  </view>

</view>

