<view class="page-root" style="padding-top: {{statusBarHeight}}px;">

  <!-- ===== 头部 ===== -->
  <view class="header">
    <view class="header-nav-row">
      <view class="back-btn" bindtap="onGoBack" hover-class="back-btn-hover">
        <text class="back-icon">‹</text>
      </view>
      <view class="logo-text">
        赛事<text class="italic-text">详</text>情
      </view>
    </view>
    <text class="header-sub">STANDINGS & SCHEDULE</text>
  </view>

  <view class="tn-loading" wx:if="{{loading}}">
    <view class="tn-spinner"></view>
    <text>正在加载赛事详情与实时排行榜…</text>
  </view>

  <block wx:elif="{{detail}}">
    <!-- 头部 Banner Card (白色清新风格) -->
    <view class="td-header-card">
      <view class="td-header-top">
        <view class="td-tags-inline">
          <view class="td-sport-pill">
            <text class="td-sport-icon">{{detail.sport_type === 'soccer' ? '⚽' : '🏀'}}</text>
            <text class="td-sport-label">{{detail.sport_type === 'soccer' ? '足球' : '篮球'}}</text>
          </view>
          <view class="td-format-pill">
            {{detail.format === 'CUP' ? '赛会制' : '联赛制'}}
          </view>
        </view>

        <!-- 极简精美置顶按钮 -->
        <view class="td-pin-btn {{isPinned ? 'pinned' : ''}}" bindtap="onTogglePin" hover-class="td-pin-btn-hover">
          <text class="td-pin-icon">📌</text>
          <text class="td-pin-text">{{isPinned ? '已置顶' : '置顶'}}</text>
        </view>
      </view>
      <text class="td-header-title">{{detail.tournament_name}}</text>
      <view class="td-header-meta">
        <text class="td-meta-item">📅 {{detail.start_date}} ~ {{detail.end_date}}</text>
      </view>
    </view>

    <!-- 主 Tab 切换 (赛程 | 排行榜) -->
    <view class="td-nav-tabs">
      <view class="td-nav-tab {{activeTab === 'schedule' ? 'active' : ''}}" data-tab="schedule" bindtap="onTabSwitch">
        赛程列表
      </view>
      <view class="td-nav-tab {{activeTab === 'standings' ? 'active' : ''}}" data-tab="standings" bindtap="onTabSwitch">
        🏆 积分排行榜
      </view>
    </view>

    <!-- 阶段/组别切换微条 (Stage Pills) -->
    <view class="td-stage-bar" wx:if="{{stageList.length > 1}}">
      <block wx:for="{{stageList}}" wx:key="id">
        <view 
          class="td-stage-pill {{selectedStageId === item.id ? 'active' : ''}}" 
          data-stage="{{item.id}}" 
          bindtap="onStageSwitch"
        >
          {{item.name}}
        </view>
      </block>
    </view>

    <!-- Tab 1: 赛程页面 (专业表格风赛程表：参考标准赛程排版，每行充实组别、对阵、比分、时间、场地) -->
    <view class="td-tab-content" wx:if="{{activeTab === 'schedule'}}">
      <view class="empty-state" wx:if="{{!currentMatches.length}}">
        <text class="empty-icon">📅</text>
        <text class="empty-text">该阶段下暂无赛程安排</text>
      </view>

      <view class="td-table-card" wx:else>
        <view class="td-sched-hint" wx:if="{{detail.can_manage}}">💡 管理员提示：长按任意比赛行即可快捷修改比分</view>
        <!-- 赛程表格头 -->
        <view class="td-table-header td-sched-header">
          <text class="col-sch-group">组别</text>
          <text class="col-sch-teams">比赛队 (对阵)</text>
          <text class="col-sch-score">比分/状态</text>
          <text class="col-sch-time">时间</text>
          <text class="col-sch-venue">场地</text>
        </view>

        <!-- 赛程表格行 -->
        <block wx:for="{{currentMatches}}" wx:key="match_id">
          <view class="td-table-row td-sched-row" data-match="{{item}}" bindlongpress="onMatchLongPress" hover-class="td-sched-row-hover">
            <!-- 组别/阶段与场次序号 -->
            <view class="col-sch-group">
              <text class="td-sch-seq-badge" wx:if="{{item.match_seq}}">#{{item.match_seq}}</text>
              <text class="td-sch-group-tag">{{item.stage_id !== 'stage_default' ? item.stage_id : '常规赛'}}</text>
            </view>

            <!-- 对阵球队 (队伍A vs 队伍B，小组完赛后自动替换 A1/B2 组别代号) -->
            <view class="col-sch-teams">
              <text class="td-sch-team home {{item.score_a > item.score_b ? 'win-team' : ''}}">{{item.display_team_a || item.team_a}}</text>
              <text class="td-sch-vs-sep">-</text>
              <text class="td-sch-team away {{item.score_b > item.score_a ? 'win-team' : ''}}">{{item.display_team_b || item.team_b}}</text>
            </view>

            <!-- 比分 / 未开始 状态 -->
            <view class="col-sch-score">
              <block wx:if="{{item.hasValidScores}}">
                <text class="td-sch-score-num {{item.score_a > item.score_b ? 'win' : ''}}">{{item.score_a}}</text>
                <text class="td-sch-score-sep">:</text>
                <text class="td-sch-score-num {{item.score_b > item.score_a ? 'win' : ''}}">{{item.score_b}}</text>
              </block>
              <block wx:else>
                <text class="td-sch-pending-tag">未开始</text>
              </block>
            </view>

            <!-- 比赛时间 (固定分成两行: 日期 + 时间) -->
            <view class="col-sch-time">
              <text class="td-sch-date-val">{{item.datePart}}</text>
              <text class="td-sch-clock-val">{{item.timePart}}</text>
            </view>

            <!-- 比赛场地 (不合并，逐行填充) -->
            <view class="col-sch-venue">
              <text class="td-sch-venue-val">{{item.venue || '—'}}</text>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- Tab 2: 排行榜页面 (支持选择全部时平铺堆叠展示多小组积分榜) -->
    <view class="td-tab-content" wx:if="{{activeTab === 'standings'}}">
      <!-- 管理员初始基准积分修正入口 -->
      <view class="td-admin-initials-bar flex-between" wx:if="{{detail && detail.can_manage}}">
        <text class="td-initials-hint">💡 中途接入赛事？可为球队修正初始基准积分与胜负</text>
        <button class="td-btn-initials" bindtap="onOpenInitialsModal">⚙️ 基准积分修正</button>
      </view>

      <view class="empty-state" wx:if="{{!currentGroupedStandings.length}}">
        <text class="empty-icon">🏆</text>
        <text class="empty-text">暂无排行榜数据</text>
        <text class="empty-hint">比赛录入比分完赛后将自动计算积分与排名</text>
      </view>

      <block wx:else>
        <block wx:for="{{currentGroupedStandings}}" wx:key="stage_id" wx:for-item="group">
          <view class="td-table-card" style="margin-bottom: 24rpx;">
            <!-- 小组积分榜卡片标题 -->
            <view class="td-group-header-bar flex-between" wx:if="{{currentGroupedStandings.length > 1 || group.stage_name !== 'all'}}">
              <text class="td-group-title-text">🏆 {{group.stage_name}} 积分榜</text>
              <text class="td-group-sub-text">按积分 / 净胜分排序</text>
            </view>

            <view class="td-table-header">
              <text class="col-rank">排名</text>
              <text class="col-team">球队</text>
              <text class="col-stat">已赛</text>
              <text class="col-stat">胜/平/负</text>
              <text class="col-stat">净胜</text>
              <text class="col-pts">积分</text>
            </view>

            <block wx:for="{{group.list}}" wx:key="team_name">
              <view class="td-table-row {{index < 3 ? 'top3' : ''}}">
                <view class="col-rank">
                  <text class="td-rank-badge rank-{{item.rank}}">{{item.rank}}</text>
                </view>
                <text class="col-team td-team-title">{{item.team_name}}</text>
                <text class="col-stat">{{item.played}}</text>
                <text class="col-stat">{{item.won}}/{{item.draw}}/{{item.lost}}</text>
                <text class="col-stat">{{item.net_score > 0 ? '+' + item.net_score : item.net_score}}</text>
                <text class="col-pts td-pts-highlight">{{item.points}}</text>
              </view>
            </block>
          </view>
        </block>
      </block>
    </view>
  </block>

  <!-- 比赛对阵与比分编辑 Modal (所有者权限) -->
  <view class="td-modal-overlay" wx:if="{{showScoreModal}}">
    <view class="td-modal-card">
      <view class="td-modal-title">编辑对阵队伍与比分结果</view>

      <!-- 队伍名称编辑 (智能识别胜者 + 快捷点选队伍) -->
      <view class="td-modal-section-title">对阵队伍 (自动推算胜者，点击下方队伍快速填入)</view>
      <view class="td-modal-teams-edit">
        <view class="td-team-input-box">
          <text class="td-input-label">主队 (队伍A)</text>
          <input class="td-team-name-input" value="{{editTeamA}}" bindinput="onEditTeamAInput" placeholder="输入或点选主队" />
          <view class="td-quick-teams-bar" wx:if="{{allTeamList.length}}">
            <block wx:for="{{allTeamList}}" wx:key="*this">
              <view 
                class="td-quick-team-pill {{editTeamA === item ? 'selected' : ''}}" 
                data-team="{{item}}" 
                data-target="teamA" 
                bindtap="onQuickSelectTeam"
              >
                {{item}}
              </view>
            </block>
          </view>
        </view>
        <text class="td-teams-vs-badge">VS</text>
        <view class="td-team-input-box">
          <text class="td-input-label">客队 (队伍B)</text>
          <input class="td-team-name-input" value="{{editTeamB}}" bindinput="onEditTeamBInput" placeholder="输入或点选客队" />
          <view class="td-quick-teams-bar" wx:if="{{allTeamList.length}}">
            <block wx:for="{{allTeamList}}" wx:key="*this">
              <view 
                class="td-quick-team-pill {{editTeamB === item ? 'selected' : ''}}" 
                data-team="{{item}}" 
                data-target="teamB" 
                bindtap="onQuickSelectTeam"
              >
                {{item}}
              </view>
            </block>
          </view>
        </view>
      </view>

      <!-- 比分录入 -->
      <view class="td-modal-section-title">比赛比分 (可留空，未开赛暂不录入)</view>
      <view class="td-modal-inputs">
        <view class="td-input-group">
          <text class="td-input-label">{{editTeamA || '主队'}} 得分</text>
          <input class="td-modal-input" type="number" value="{{scoreA}}" bindinput="onScoreAInput" placeholder="未开赛" />
        </view>
        <view class="td-input-group">
          <text class="td-input-label">{{editTeamB || '客队'}} 得分</text>
          <input class="td-modal-input" type="number" value="{{scoreB}}" bindinput="onScoreBInput" placeholder="未开赛" />
        </view>
      </view>

      <view class="td-modal-actions">
        <button class="td-btn td-btn-cancel" bindtap="onCloseScoreModal">取消</button>
        <button class="td-btn td-btn-confirm" disabled="{{submittingScore}}" bindtap="onSaveScore">保存修改</button>
      </view>
    </view>
  </view>

  <!-- ⚙️ 初始基准积分修正 Modal (所有者权限) -->
  <view class="td-modal-overlay" wx:if="{{showInitialsModal}}">
    <view class="td-modal-card">
      <view class="td-modal-title">⚙️ 赛事初始基准积分修正</view>

      <!-- 方式一：AI 批量导入 -->
      <view class="td-modal-section-title">方式一：AI 文本 / CSV 批量导入 (推荐，10秒搞定全组)</view>
      <view class="td-ai-action-bar" style="margin-bottom: 12rpx;">
        <button class="td-btn-ai-prompt" bindtap="onCopyAiPrompt">📋 复制 AI 整理基准积分提示词</button>
      </view>
      <textarea 
        class="td-csv-textarea" 
        value="{{pastedCsvText}}" 
        bindinput="onCsvTextInput" 
        placeholder="将 AI 生成的 CSV 文本粘贴在此处（支持一次性导入多组球队）" 
      />
      <button 
        class="td-btn td-btn-confirm" 
        style="margin-bottom: 24rpx; background: #2563EB;" 
        disabled="{{submittingInitials}}" 
        bindtap="onSaveInitialsFromCsv"
      >
        一键批量保存 CSV 基准积分
      </button>

      <view class="td-divider-line"></view>

      <!-- 方式二：单队手动微调 -->
      <view class="td-modal-section-title">方式二：单队手动微调</view>
      <view class="td-team-input-box" style="margin-bottom: 16rpx;">
        <input class="td-team-name-input" value="{{initTeamName}}" bindinput="onInitTeamNameInput" placeholder="点选或输入球队" />
        <view class="td-quick-teams-bar" wx:if="{{allTeamList.length}}">
          <block wx:for="{{allTeamList}}" wx:key="*this">
            <view 
              class="td-quick-team-pill {{initTeamName === item ? 'selected' : ''}}" 
              data-team="{{item}}" 
              bindtap="onSelectInitTeam"
            >
              {{item}}
            </view>
          </block>
        </view>
      </view>

      <view class="td-modal-inputs" style="flex-wrap: wrap; gap: 12rpx; margin-bottom: 24rpx;">
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始积分</text>
          <input class="td-modal-input" type="number" value="{{initPoints}}" bindinput="onInitPointsInput" placeholder="如 15" />
        </view>
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始已赛</text>
          <input class="td-modal-input" type="number" value="{{initPlayed}}" bindinput="onInitPlayedInput" placeholder="如 5" />
        </view>
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始胜场</text>
          <input class="td-modal-input" type="number" value="{{initWon}}" bindinput="onInitWonInput" placeholder="如 4" />
        </view>
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始平局</text>
          <input class="td-modal-input" type="number" value="{{initDraw}}" bindinput="onInitDrawInput" placeholder="如 0" />
        </view>
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始负场</text>
          <input class="td-modal-input" type="number" value="{{initLost}}" bindinput="onInitLostInput" placeholder="如 1" />
        </view>
        <view class="td-input-group" style="min-width: 45%;">
          <text class="td-input-label">初始净胜分</text>
          <input class="td-modal-input" type="number" value="{{initNetScore}}" bindinput="onInitNetScoreInput" placeholder="如 32" />
        </view>
      </view>

      <view class="td-modal-actions">
        <button class="td-btn td-btn-cancel" bindtap="onCloseInitialsModal">关闭弹窗</button>
        <button class="td-btn td-btn-confirm" disabled="{{submittingInitials}}" bindtap="onSaveTeamInitialStats">保存单队微调</button>
      </view>
    </view>
  </view>

</view>
