@import '../../../packageLab/pages/radar-lab/common/common.wxss';

.review-root {
  padding-top: 24rpx;
}

.review-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.review-card {
  margin-bottom: 24rpx;
}

.review-empty {
  padding: 48rpx 32rpx;
}

.review-empty--error {
  color: #dc2626;
}

.review-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.review-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.review-time {
  font-size: 22rpx;
  color: #94a3b8;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.review-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 12rpx;
}

.review-label {
  width: 168rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #64748b;
}

.review-value {
  flex: 1;
  font-size: 24rpx;
  color: #0f172a;
  word-break: break-all;
}

.review-value--mono {
  font-family: monospace;
}

.review-copy {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  color: #2563eb;
  border: 1rpx solid #bfdbfe;
  border-radius: 999rpx;
  background: #eff6ff;
}

.review-actions {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-top: 24rpx;
}

.review-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
}

.rl-empty-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #cbd5e1;
  line-height: 1.5;
}
