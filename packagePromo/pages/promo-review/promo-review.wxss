.promo-page {
  min-height: 100vh;
  padding: 0 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f8fafc;
}

.nav-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0 24rpx;
}

.nav-back {
  font-size: 28rpx;
  color: #2563eb;
  margin-right: 24rpx;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
}

.search-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.search-label {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
}

.btn-search {
  flex-shrink: 0;
}

.search-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

.state-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.state-box--error .state-text {
  color: #dc2626;
}

.state-text {
  font-size: 28rpx;
  color: #64748b;
}

.app-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.app-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.app-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.app-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.app-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.app-row {
  display: flex;
  align-items: center;
  margin-bottom: 10rpx;
}

.app-label {
  font-size: 24rpx;
  color: #64748b;
  width: 160rpx;
  flex-shrink: 0;
}

.app-value {
  font-size: 24rpx;
  color: #0f172a;
  flex: 1;
  word-break: break-all;
}

.app-value--mono {
  font-family: monospace;
}

.copy-btn {
  font-size: 22rpx;
  color: #2563eb;
  padding: 4rpx 12rpx;
  border: 1rpx solid #2563eb;
  border-radius: 999rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.app-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.btn-reject {
  background: #f1f5f9;
  color: #64748b;
}

.btn-approve {
  font-weight: 600;
}
