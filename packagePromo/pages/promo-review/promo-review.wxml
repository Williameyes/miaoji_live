<view class="rl-root review-root">

  <view class="rl-header">
    <view class="rl-kicker">直播雷达 · 推广</view>
    <view class="rl-title">推广审批</view>
    <view class="rl-sub" wx:if="{{targetMatchId}}">场次 #{{targetMatchId}} · 待审批主播申请</view>
    <view class="rl-sub" wx:else>请从推广监测或推广发布页进入</view>
  </view>

  <view wx:if="{{!fromListEntry}}" class="rl-card">
    <view class="rl-empty review-empty">
      <text>请从推广监测或推广发布页的「审批申请」进入</text>
    </view>
  </view>

  <view wx:elif="{{loading}}" class="rl-empty">
    <text>加载中…</text>
  </view>

  <view wx:elif="{{errorText}}" class="rl-card">
    <view class="rl-empty review-empty review-empty--error">
      <text>{{errorText}}</text>
    </view>
  </view>

  <view wx:elif="{{applications.length === 0}}" class="rl-card">
    <view class="rl-empty review-empty">
      <text>暂无待审批申请</text>
      <text class="rl-empty-sub">主播扫码进入推广广场并提交申请后，会显示在此</text>
    </view>
  </view>

  <view wx:else class="review-list">
    <view class="rl-card review-card" wx:for="{{applications}}" wx:key="applicationId">
      <view class="rl-card-inner">
        <view class="review-head">
          <text class="review-name">{{item.anchorName}}</text>
          <text class="review-time">{{item.createdAt}}</text>
        </view>
        <view class="review-row">
          <text class="review-label">openid</text>
          <text class="review-value review-value--mono">{{item.openid}}</text>
        </view>
        <view class="review-row">
          <text class="review-label">sec_user_id</text>
          <text class="review-value review-value--mono">{{item.secUserId}}</text>
          <view
            class="review-copy"
            catchtap="onCopySecUserIdTap"
            data-val="{{item.secUserId}}"
          >复制</view>
        </view>
        <view class="review-actions">
          <button
            class="rl-btn rl-btn-secondary review-btn"
            disabled="{{reviewingId === '' + item.applicationId}}"
            catchtap="onRejectTap"
            data-id="{{item.applicationId}}"
          >拒绝</button>
          <button
            class="rl-btn rl-btn-primary review-btn"
            loading="{{reviewingId === '' + item.applicationId}}"
            disabled="{{reviewingId === '' + item.applicationId}}"
            catchtap="onApproveTap"
            data-id="{{item.applicationId}}"
          >通过</button>
        </view>
      </view>
    </view>
  </view>

</view>
