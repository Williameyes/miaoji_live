page {
  background-color: #f8fafc;
  min-height: 100%;
}

.promo-page {
  padding: 24rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  min-height: 100vh;
}

.promo-intro {
  margin-bottom: 28rpx;
}

.promo-kicker {
  display: block;
  font-size: 20rpx;
  letter-spacing: 0.12em;
  color: #94a3b8;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.promo-intro-desc {
  display: block;
  font-size: 26rpx;
  line-height: 1.55;
  color: #64748b;
}

.promo-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.promo-card--debug {
  border: 1rpx dashed #bfdbfe;
  background: linear-gradient(180deg, #eff6ff 0%, #ffffff 60%);
}

.promo-card--state {
  text-align: center;
  padding: 56rpx 32rpx;
}

.promo-card--warn {
  border: 1rpx solid rgba(251, 191, 36, 0.35);
  background: linear-gradient(180deg, #fffbeb 0%, #ffffff 48%);
}

.promo-card--action {
  padding-bottom: 28rpx;
}

.promo-card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.promo-card-icon {
  font-size: 32rpx;
  line-height: 1;
}

.promo-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  flex: 1;
  min-width: 0;
}

.promo-debug-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.promo-debug-input {
  flex: 1;
  height: 72rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.promo-debug-btn {
  flex-shrink: 0;
}

.promo-match-line {
  display: block;
  font-size: 30rpx;
  color: #475569;
  margin-bottom: 16rpx;
}

.promo-meta-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.promo-chip {
  font-size: 24rpx;
  color: #2563eb;
  background: #eff6ff;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

.promo-id-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
}

.promo-empty {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  padding: 24rpx 0;
}

.promo-ads-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.promo-ad-item {
  width: calc(50% - 10rpx);
  text-align: center;
}

.promo-ad-logo {
  width: 100%;
  height: 160rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
}

.promo-ad-brand {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.promo-btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  background: linear-gradient(135deg, #3b82f6, #2563eb);
  color: #ffffff;
  font-weight: 700;
  font-size: 30rpx;
  border-radius: 44rpx;
}

.promo-btn-primary::after {
  border: none;
}

.promo-tip {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.promo-state-text {
  font-size: 28rpx;
  color: #64748b;
}
